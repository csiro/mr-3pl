    if (!matched(ADDR)) nullerr("xul_ramb16_sn", "ADDR");
    if (!matched(DI)) nullerr("xul_ramb16_sn", "DI");
    int(awidth, width(ADDR));
    int(dwidth, width(D));
    element("RAMB16_S"+dwidth);
    elementconnect("CLK", 3, CLK);
    elementconnect("EN", 0, EN);
    elementconnect("WE", 0, WE);
    for (int(i) ; i<awidth ; i++)
        elementconnect("ADDR"+i, 0, ADDR[i]);
    for (int(i) ; i<dwidth ; i++)
        elementconnect("DI"+i, 0, DI[i]);
    if (matched(DIP)) {
        int(w, width(DIP));
        for (int(i) ; i<w ; i++)
            elementconnect("DIP"+i, 1, DIP[i]);
    }
    for (int(i) ; i<dwidth ; i++)
        elementconnect("DO"+i, 1, DO[i]);
    if (matched(DOP)) {
        int(w, width(DOP));
        for (int(i) ; i<w ; i++)
            elementconnect("DOP"+i, 1, DOP[i]);
    }
    xul_constraints("xul_ramb16_sn", CONSTR);
}

