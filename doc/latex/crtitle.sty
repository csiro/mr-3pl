\newcommand{\makecsirotitle}{
    \newlength{\xxxxxx}
    \setlength{\xxxxxx}{\oddsidemargin}
    \setlength{\oddsidemargin}{-1in}

    \vspace*{30mm}

    \hspace*{1in}
    \begin{minipage}[c]{18mm}
    \includegraphics[width=18mm]{csiro_logo_large}
    \end{minipage}
    \hspace{15mm}
    \begin{minipage}[t]{115mm}
    {\sffamily\bfseries\LARGE \begin{sloppypar} \htitle \end{sloppypar}}

    \vspace{8mm}

    {\sffamily\large \hauthor}

    \vspace{6mm}

    {\sffamily\large \hdate}

    \vspace{6mm}

    {\sffamily\bfseries \hreport}
    \end{minipage}

    \vfill

    \colorbox {csirodarkblue}{
    \parbox[r][19mm][r]{\paperwidth}{\color {white} \makebox[165mm][]{} www.csiro.au \\ \mbox{} \\ \mbox{}}
    }


    \thispagestyle{empty}
    \pagebreak
    \thispagestyle{empty}
    \setlength{\oddsidemargin}{\xxxxxx}
    \cleardoublepage
    \pagenumbering{arabic}
}


