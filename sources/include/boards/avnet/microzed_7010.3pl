nosource

// Definitions for Avnet MicroZed 7010 Zynq SoM evaluation board

part("xc7z010clg400-1");

// DMA  initialbuffer locations and sizes.
int(global.DMA_base_address_init, 0x2f000000);
int(global.DMA_buffer_size_init,  0x1000000);

module "xilinx/xc7.3pl"
module "xilinx/zynq_axi.3pl"

//addncf("CONFIG VCCAUX=\"3.3\";"); XDC equivalent?
str(lvcmos33, "LVCMOS33");


// board-to-board connectors
iopins(global.jx1_pair_pins, "[25][2]str", {
    { "T11", "T10" },	// "JX1 LVDS 0"
    { "T12", "U12" },
    { "U13", "V13" },
    { "V12", "W13" },
    { "T14", "T15" },
    { "P14", "R14" },
    { "Y16", "Y17" },
    { "W14", "Y14" },
    { "T16", "U17" },
    { "V15", "W15" },
    { "U14", "U15" },
    { "U18", "U19" },
    { "N18", "P19" },
    { "N20", "P20" },
    { "T20", "U20" },
    { "V20", "W20" },
    { "Y18", "Y19" },
    { "V16", "W16" },
    { "R16", "R17" },
    { "T17", "R18" },
    { "V17", "V18" },
    { "W18", "W19" },
    { "N17", "P18" },
    { "P15", "P16" }	// "JX1 LVDS 23"
}, iostandard=lvcmos33);   
iopins(global.jx1_single_pins, "[2]str", {
    "R19", "T19"
}, iostandard=lvcmos33);

iopins(global.jx2_pair_pins, "[24][2]str", {
    { "C20", "B20" },	// "JX2 LVDS 0"
    { "B19", "A20" },
    { "E17", "D18" },
    { "D19", "D20" },
    { "E18", "E19" },
    { "F16", "F17" },
    { "L19", "L20" },
    { "M19", "M20" },
    { "M17", "M18" },
    { "K19", "J19" },
    { "L16", "L17" },
    { "K17", "K18" },
    { "H16", "H17" },
    { "J18", "H18" },
    { "G17", "G18" },
    { "F19", "F20" },
    { "G19", "G20" },
    { "J20", "H20" },
    { "K14", "J14" },
    { "H15", "G15" },
    { "N15", "N16" },
    { "L14", "L15" },
    { "M14", "M15" },
    { "K16", "J16" }	// "JX2 LVDS 23"
}, iostandard=lvcmos33);   
iopins(global.jx2_single_pins, "[2]str", {
    "G14", "J15"
}, iostandard=lvcmos33);


// breakout board connector 1
var(global.con1_3_16_pins,  "[14]str", {
    "R19", "T19", "T11", "T12", "T10", "U12", "U13",
    "V12", "V13", "W13", "T14", "P14", "T15", "R14"
});
var(global.con1_19_38_pins, "[20]str", {
    "Y16", "W14", "Y17", "Y14", "T16", "V15", "U17", "W15", "U14", "U18",
    "U15", "U19", "N18", "N20", "P19", "P20", "T20", "V20", "U20", "W20"
});
var(global.con1_41_52_pins, "[12]str", {
    "Y18", "V16", "Y19", "W16", "R16", "T17",
    "R17", "R18", "V17", "W18", "V18", "W19"
});
var(global.con1_55_58_pins, "[4]str",  {
    "N17", "P15",
    "P18", "P16"
});

// breakout board connector 2
var(global.con2_3_16_pins,  "[14]str", {
    "G14", "J15", "C20", "B19", "B20", "A20", "E17",
    "D19", "D18", "D20", "E18", "F16", "E19", "F17"
});
var(global.con2_19_34_pins, "[16]str", {
    "L19", "M19", "L20", "M20", "M17", "K19", "M18", "J19",
    "L16", "K17", "L17", "K18", "H16", "J18", "H17", "H18"
});
var(global.con2_37_48_pins, "[12]str", {
    "G17", "F19", "G18", "F20", "G19", "J20",
    "G20", "H20", "K14", "H15", "J14", "G15"
});
var(global.con2_51_58_pins, "[8]str", {
    "N15", "L14", "N16", "L15",
    "M14", "K16", "M15", "J16"
});
