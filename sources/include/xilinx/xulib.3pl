global function
xul_fdrse (value(D), clock(C), value({CE, R, S}, "log"), var(CONSTR, "[]str")) {
    if (!matched(C)) nullerr("xul_fd", "C");
    value(q, "log"); attributes(q, domain=C);
    element("FDRSE");
    elementconnect("C", 3, C);
    if (matched(D))
        elementconnect("D", 0, D);
    if (matched(CE))
        elementconnect("CE", 0, CE);
    if (matched(R))
        elementconnect("R", 0, R);
    if (matched(S))
        elementconnect("S", 0, S);
    elementconnect("Q", 1, q);
    xul_constraints("xul_fd", CONSTR);
    return(q);
}

global function
xul_fdcpe (value(D), clock(C), value({CE, CLR, PRE}, "log"), var(CONSTR, "[]str")) {
    value(q, "log"); attributes(q, domain=C);
    element("FDCPE");
    if (matched(C))
        elementconnect("C", 3, C);
    if (matched(D))
        elementconnect("D", 0, D);
    if (matched(CE))
        elementconnect("CE", 0, CE);
    if (matched(CLR))
        elementconnect("CLR", 0, CLR);
    if (matched(PRE))
        elementconnect("PRE", 0, PRE);
    elementconnect("Q", 1, q);
    xul_constraints("xul_fd", CONSTR);
    return(q);
}

global function
xul_ldcpe (value(D), clock(G), value({GE, CLR, PRE}, "log"), var(CONSTR, "[]str")) {
    value(q, "log"); attributes(q, domain=G);
    element("LD");
    if (matched(G))
        elementconnect("G", 0, G);
    if (matched(D))
        elementconnect("D", 0, D);
    if (matched(GE))
        elementconnect("GE", 0, GE);
    if (matched(CLR))
