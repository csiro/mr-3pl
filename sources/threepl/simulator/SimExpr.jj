      }
   }
   
   /**
    * Factory method for creation of command expression with String
    *
    * @param sim The single Sim object
    * @param expr A command expression to parse
    * @throws SimExprParseException If parse fails
    *
    * @return A new SimExpr object if parse is successful
    */
   public static SimExpr newCommand (Sim sim, String expr) throws SimExprParseException {
      SimExpr s = new SimExpr(new StringReader(expr));
      init(sim);
      s.root = s.command();
      // s.nodeDump("");      
      return s;
   }
   
   /**
    * Factory method for creation of command expression with InputStream (eg System.in)
    *
    * @param sim The single Sim object
    * @param is An InputStream containing the command expression to parse
    * @throws SimExprParseException If parse fails
    *
    * @return A new SimExpr object if parse is successful
    */
   public static SimExpr newCommand (Sim sim, InputStream is) throws SimExprParseException {
      SimExpr s = new SimExpr(is);
      init(sim);
      s.root = s.command();
      // s.nodeDump("");      
      return s;
   }

   /**
    * Factory method for creation of math expression with String
    *
    * @param sim The single Sim object
    * @param expr An arithmetic or logical expression to parse
    * @throws SimExprParseException If parse fails
    *
    * @return A new SimExpr object if parse is successful
    */
   public static SimExpr newExpression (Sim sim, String expr) throws SimExprParseException {
      SimExpr s = new SimExpr(new StringReader(expr));
      init(sim);
      s.root = s.expression();
      return s;
   }

    /**
     * Factory method for creation of math expression with InputStream (eg System.in)
    *
    * @param sim The single Sim object
    * @param is An InputStream containing the arithmetic or logical expression to parse
    * @throws SimExprParseException If parse fails
    *
    * @return A new SimExpr object if parse is successful
     */
   public static SimExpr newExpression (Sim sim, InputStream is) throws SimExprParseException {
      SimExpr s = new SimExpr(is);
      init(sim);
      s.root = s.expression();
      return s;
   }

   /**
    * Return root node of expression tree
    *
    * @return The root node of the expression tree
    */
   public SimExprSimpleNode getRoot () {
      return root;
   }
                
   /**
    * Initialisation during constructor
    *
    * @param sim The single Sim object
    */   
   private static void init (Sim sim) {
   
      /* Set the static Sim for the parse tree */
      SimExprSimpleNode.sim = sim;
      
      /* Define true boolean literals */
      System.setProperty("true", "true");  
      System.setProperty("high", "true");  
   }
       
   /**
    * Return the expression result
    *
    * @return The expression result, contained in a SimExprNodeValue object
    */

   public SimExprNodeValue eval () {
      return nodeValue = root.eval();      
   }    
             
   /**
    * Dump the expression tree to standard output
    *
    * @param prefix A String to prepend to the description of each node
    */
   public void nodeDump (String prefix) {
      root.dump(prefix);	 
   }
   
   /**
    * Dump the value type and contents to standard output.
    * Caution: This will refer to the value from the last call to eval().
    * It does not automatically re-evaluate the expression, unless the
    * expression has not yet been evaluated.
    */
   public void valueDump () {      
      if (nodeValue==null)
	 nodeValue = root.eval();
      System.out.println("type="+nodeValue.printType()+", value="+nodeValue.toString());
   }       
                       
}


