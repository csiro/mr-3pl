// Generate an I/O constraint.
//  loc is the I/O pad designation
//  con is the constraint identifier string
//  val is the constraint value
//
global procedure
IOconstraint (str(loc), str(con), var(val)) {
    str(CON, toupper(con));
    str(v);
    switch (typestring(val)) {
    case "str": v = toupper(val);
    case "int": v = cast(val, "str");
    case "uint": v = cast(val, "str");
    case "float": v = cast(val, "str");
    case "log": v = val ? "TRUE" : "FALSE";
    default: return; // ignore - probably null
    }
    str(port);
    // For I/O standard constraint make sure only done once
    // in case of bi-directional port.
    if (con == "iostandard") {
        if (file.iostandards_done[loc] != null) {
            return;
        }
        file.iostandards_done[loc] = true;
    }
    port = "PORT_" + loc;

    if (startswith(directive("postProcessTool"), "ise")) {  // NCF
        // special case for pullup and pulldown - no value, just constraint string
        if (CON == "PULLUP" || CON == "PULLDOWN") {
            if (v == "TRUE")
                special(0, "NET " + port + " " + CON + ";", port);
        } else
            special(0, "NET " + port + " " + CON + "=" + v + ";", port);
    } else {                     // XDC file
        if (con == "tnm") {
            var(tnl, "list");
            if (vivado_timing_names[v] != null)
                tnl = vivado_timing_names[v];
            else
                vivado_timing_names[v] = tnl;
            append(tnl,, port);
        } else
            special(1, "set_property " + CON + " " + v + " [get_ports " + port + "];", port);
    }
}

