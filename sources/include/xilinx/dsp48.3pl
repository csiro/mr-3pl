        mask=use_pat ? mask : null
    );
    out := forcecast(result, t2);
}

// out := a op b
//  a   48 bits
//  b   48 bits
//  out 48 bits
//  op  5 bit operation code -
//      4   0b00100      a ^ b
//      5   0b00101    ~(a ^ b)
//      6   0b00110    ~(a ^ b)
//      7   0b00111      a ^ b
//      12  0b01100      a & b
//      13  0b01010      a & ~b
//      14  0b01110    ~(a & b)
//      15  0b01111     ~a | b
//      29  0b10100    ~(a ^ b)
//      21  0b10101      a ^ b
//      22  0b10110      a ^ b
//      23  0b10111    ~(a ^ b)
//      28  0b11100      a | b
//      29  0b11101      a | ~b
//      30  0b11110    ~(a ^ b)
//      31  0b11111     ~a & b
global module
dsplog (
    value(out), value(pat, "log")
    <-
    value(a),
    value(b),
    value(op, "uint:5"),
    int(pattern),
    int(mask, 0xffffffffffff)
) {
    switch (directive("family")) {
    case "xc5v": var(local.p, "->", procptr(dsp48e)); 
    case "xc6v": var(local.p, "->", procptr(dsp48e1));
    case "xc7": var(local.p, "->", procptr(dsp48e1));
    default: texit("library module dspmul() cannot be used with " + directive("family"));
    }
    
    log(use_pat, matched(pattern));
    str(use_pattern_detect, use_pat ? "PATDET" : "NO_PATDET");
    value(result, "bits:48");
    p->(
        p=result,
        patterndetect=pat
        <-   
        use_mult="NONE",
        a=forcecast(a>>18, "bits:30"),
        b=forcecast(a, "bits:18"),
        c=forcecast(b, "bits:48"),
        opmode= 0b0110011 | ((op & 0x10000) >> 1),
        alumode=op & 0b1111,
        use_pattern_detect=use_pattern_detect,
        pattern=use_pat ? pattern : null,
        mask=use_pat ? mask : null
    );
    out := forcecast(result, type(out));
}


// out := a op (gate & b)
//  a       48 bits signed
//  b       48 bits signed
//  out     48 bits signed
//  add     log
//  gate    log
// add true for addition, false for subtraction
// gate false adds or subtracts 0 instead of b
global module
dspaddsub (
    value(out), value(pat, "log")
    <-
    value(a),
    value(b),
    value(add, "log", true),
    value(gate, "log", true),
    int({areg, breg, preg}),
    int(pattern),
    int(mask, 0xffffffffffff)
) {
    switch (directive("family")) {
    case "xc5v": var(local.p, "->", procptr(dsp48e)); 
    case "xc6v": var(local.p, "->", procptr(dsp48e1));
    case "xc7": var(local.p, "->", procptr(dsp48e1));
    default: texit("library module dspmul() cannot be used with " + directive("family"));
    }
    
    if ((areg != 0 || breg != 0 || preg != 0) &&
        (hasqueuereads(a) || hasqueuereads(b)))
        texit("dspaddsub() - cannot mix registers and queue inputs");
    log(use_pat, matched(pattern));
    str(use_pattern_detect, use_pat ? "PATDET" : "NO_PATDET");
    value({v1, v2}, "empty");
    type(t);
    argadjust(v1, v2, t <- a, b, "+", false);
    value(result, "bits:48");
    p->(
        p=result,
        patterndetect=pat
        <-   
        areg=areg,
        breg=areg,
        creg=breg,
        preg=preg,
        a=forcecast(v2, "bits:48")>>18,
        b=forcecast(v2, "bits:18"),
        c=forcecast(v1, "bits:48"),
        opmode=gate?0b0110011:0b0000011,
        alumode=add?0:0b11,
        use_mult="none",
        use_pattern_detect=use_pattern_detect,
        pattern=use_pat ? pattern : null,
        mask=use_pat ? mask : null
    );
    out := forcecast(result, t);
}

global module
dspcounter (
    value(out), value(pat, "log")
    <-
    value(step, "log", true),
    value(reset, "log", false),
    value(pattern, "bits:48", 0),
    int(mask, 0xffffffffffff),
    value(up, "log", true)
) {
    switch (directive("family")) {
    case "xc5v": var(local.p, "->", procptr(dsp48e)); 
    case "xc6v": var(local.p, "->", procptr(dsp48e1));
    case "xc7": var(local.p, "->", procptr(dsp48e1));
    default: texit("library module dspmul() cannot be used with " + directive("family"));
    }
    
    if (hasqueuereads(step))
        texit("dspcounter() - argument to input parameter step has queue reads");
    if (hasqueuereads(reset))
        texit("dspcounter() - argument to input parameter reset has queue reads");
    if (hasqueuereads(pattern))
        texit("dspcounter() - argument to input parameter pattern has queue reads");
    if (hasqueuereads(up))
        texit("dspcounter() - argument to input parameter up has queue reads");
    log(use_pat, matched(pattern));
    log(const_pat, istargconst(pattern));
    int(patt_attr, const_pat ? pattern : 0);
    str(use_pattern_detect, use_pat ? "PATDET" : "NO_PATDET");
    value(result, "bits:48");
    p->(
        p=result,
        patterndetect=pat
        <-
        clk=currentclock(),
        c=const_pat ? null : pattern,
        carryin=up,
        opmode=0b0000010,
        alumode=up?0:0b11,        
        preg=1,
        use_mult="none",
        sel_pattern=const_pat ? "pattern" : "c",
        use_pattern_detect=use_pattern_detect,
        pattern=use_pat ? patt_attr : null,        
        mask=use_pat ? mask : null,
        cep=step,
        rstp=reset
    );
    out := forcecast(result, type(out));
}
