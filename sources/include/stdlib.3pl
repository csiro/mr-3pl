// Accumulate a 16 bit CRC from 8 bit data.
//  in      data input queue - "uint:8"
//  poly    optional string argument to specify the polynomial to use -
//          value are "CRC16" (default) or "CCITT"
//  out     a "uint:16" static variable in which the CRC value is accumulated
// Input data can be read at clock rate.
global module
crc_8_16 (
    static(out, "uint:16")
    <-
    queue(in, "uint:8"),
    str(poly, "CRC16")
) {
    var(tab, "->");
    switch (poly) {
    case "CRC16": tab = &crc16_init;
    case "CCITT": tab = &ccitt_init;
    default: texit("crc_8_16(): unknown polynomial " + poly);
    }
    cmemory(crctab, 1, "uint:8", "uint:16", tab->);
    
    out <- (out << 8) ^ cmemoryread(crctab, 0, cast((out >> 8) ^ in, "uint:8"));
}

// Accumulate a 16 bit CRC from 16 bit data.
//  in      data input queue - "uint:16"
//  poly    optional string argument to specify the polynomial to use -
//          value are "CRC16" (default) or "CCITT"
//  out     a "uint:16" static variable in which the CRC value is accumulated
// Input data can be read at clock rate.
global module
crc_16_16 (
    static(out, "uint:16")
    <-
    queue(in, "uint:16"),
    str(poly, "CRC16")
) {
    var(tab, "->");
    switch (poly) {
    case "CRC16": tab = &crc16_init;
    case "CCITT": tab = &ccitt_init;
    default: texit("crc_16_16(): unknown polynomial " + poly);
    }
    cmemory(crctab, 2, "uint:8", "uint:16", tab->);
    value(v, "uint:16");
    
    v := (out << 8) ^ cmemoryread(crctab, 0, cast((out >> 8) ^ (in >> 8), "uint:8"));
    out <- (v << 8) ^ cmemoryread(crctab, 1, cast((v >> 8) ^ (in & 0xff), "uint:8"));
}

struct(global.ds16,
    data,   "bits:16",
    k,      "log"
);

struct(global.ds16e,
    data,   "bits:16",
    k,      "log",
    error,  "log"
);

struct(global.ds32,
    data,   "uint:32",
    k,      "log"
);

// Enclose data in a block.
// Blocks can be fixed or variable length.
//  in          input data stream, struct ds32
//  max_blk_len maximum number of ds32 data items in the block
//  sob         start-of-block K character
//  eob         end-of-block K character
//  out         output data stream, struct ds16
//  fixed       if true, blocks are fixed size
// When input data become available the start-of-block word is written to
// the output queue. The start-of-block word has the most significant byte
// set to the start-of-block K character, the least significant byte to zero
// and the K flag is true. If 'fixed' is false (default), incoming data is
// read until either unavailable or max_block_len items have been read and
// the block is then terminated. If 'fixed' is true, incoming data is read
// until max_block_len items have been read and the block is then
// terminated. each 32 bit word is written to the output as a pair of 16 bit
// words. A 16 bit CRC is accumulated from each 16 bit data word. When the
// block is terminated the 16 bit CRC is written to the output followed by
// an end-of-block word. The end-of-block word has the most significant byte
// set to the end-of-block K character, the least significant byte to zero
// and the K flag is true. Note that the block
// length is in ds32 (input type) words, not ds16 words as transmitted in the
// block.
// 
//
//    K   upper  lower
//  flag     byte
//  -------------------
//  | 1 | sob  |  0   | start-of-block
//  | 0 | data word 0 | first ds16 data word (1st of pair for ds32 type)
//  | 0 | data word 1 | second ds16 data word (2nd of pair for ds32 type)
//          .
//          .
//  | 0 | data word n | last ds16 data word (2nd of pair for last ds32 word)
//  | 0 |     CRC     | 16 bit CRC word
//  | 1 | eob  |  0   | end-of-block
//  -------------------
//
global module
crcblock (
    queue(out, ds16)
    <-
    queue(in, ds32),
    int(max_blk_len, 20),
    int({sob, eob}),
    log(fixed)
) {
    struct(s,
        extends,    ds16,
        first,      "log"
    );
    queue(split, s); //attributes(split, mindepth=16);
    static(save, "uint:16");
    
    seq {
        sync {
            split.data <<- in.data >> 16;
            split.k <<- in.k;
            split.first <<- true;
            save <- in.data;
        }
        split.data <<- save;
    }
    
    static(block_count, "uint:"+size(max_blk_len), max_blk_len);
    value(block_count_eq_0, "log", block_count == 0);
    cmemory(crctab, 2, "uint:8", "uint:16", crc16_init);
    static(crc, "uint:16");
    static(init, "log", true);
    static({d1, d2, eb}, "log");
    value(idle, "log");
    if (fixed)
        idle := block_count_eq_0;
    else
        idle := <split && block_count_eq_0 || !<split;
    value({v, crc_new}, "uint:16");
    v := (crc << 8) ^ cmemoryread(crctab, 0, cast((crc >> 8) ^ (?split.data >> 8), "uint:8"));
    crc_new := (v << 8) ^ cmemoryread(crctab, 1, cast((v >> 8) ^ (?split.data & 0xff), "uint:8"));
   
    when (init && <split) sync {
        out.data <<- sob << 8;
        out.k <<- true;
        reset(crc);
        block_count <- max_blk_len;
        transition(d1 <- init);
    }
    when (d1 && idle) par {
        out.data <<- crc;
        transition(eb <- d1);
    }
    when (d1 && !idle && ?split.first) sync {
        crc <- crc_new;
        out.data <<- split.data;
        out.k <<- split.k;
        transition(d2 <- d1);
    }
    when (d1 && !idle && !?split.first)
        null <<- split;
    when (d2) sync {
        crc <- crc_new;
        out.data <<- split.data;
        block_count--;
        transition(d1 <- d2);
    }
    when (eb) sync {
        out.data <<- eob << 8;
        out.k <<- true;
        transition(init <- eb);
    }
    
    procedure
    transition(static(new, "log") <- static(old, "log")) {
        par {
            old <- false;
            new <- true;
        }
    }
}

/*
 * This code would be more readable if it worked.
 * The problem with petrinets is that the logic performing the transitions
 * (marking) proceed regardless of the transition code block. If the code
 * block waits on queues the transitions occur regardless. This means that
 * further transitions can occur while the associated code blocks are still
 * attempting to act on previous transitions. Need to change the rules such
 * transitions do not occur until the associated code block (if any) executes
 * its last cycle. At the moment there is no way to tell when a code block
 * is about to execute its last cycle, except in simple cases. There may be
 * a way to get an execute signal from a code block on the last cycle of
 * execution in which case that could be used here. Such a mechanism
 * would also allow the implementation of target FOR loops since the
 * change to the loop variable could be executed on the last code body cycle.
 *
    petrinet {
        initial init;
        init -> d1 when (<split) {
                                    sync {
                                        out.data <<- sob << 8;
                                        out.k <<- true;
                                        reset(crc);
                                        block_count <- max_blk_len;
                                    }
                                };
        d1 -> eb when (idle) {out.data <<- crc;};
        d1 -> d2 when (!idle) {
                                sync {
                                    crc <- crc_new;
                                    out.data <<- split.data;
                                    out.k <<- split.k;
                                }
                            };
        d2 -> d1 {
                    sync {
                        crc <- crc_new;
                        out.data <<- split.data;
                        block_count--;
                    }
                };
        eb -> init {
                     sync {
                        out.data <<- eob << 8;
                        out.k <<- true;
                    }
                };
    }
*/

// Unwrap data from a block.
// Blocks can be fixed or variable length.
//  in          input data stream, struct ds16
//  max_blk_len maximum number of ds32 data items in the block
//  sob         start-of-block K character
//  eob         end-of-block K character
//  dout        output data stream, struct ds32
//  eout        optional error counter output
// The start-of-block word, CRC word and end-of-block word are stripped
// off the input stream and data words are packed into 32 bit words (ds32
// struct). A CRC is computed from the block data including the transmitted
// CRC word. If the resulting CRC is zero the block is written to the output
// queue. If the CRC is not zero the block is discarded. When a block CRC
// error is encountered if the output parameter 'eout' has an argument the data
// length of the discarded block is added to the value of that variable.
// Any words received that do not match the block format cause 'eout' to
// be incremented. The size of the 'eout' counter is determined by the
// argument passed in the call to crcunblock().
// Unpacked data is written to a dual-port circular buffer so that completed
// correct data words can be copied to the output data queue in parallel with
// unpacking of incoming blocks. If the output queue becomes unavailable for
// writing, data words will be discarded.
// If the block length exceeds the maximum block length the block is
// terminated and discarded and if the optional error counter output parameter
// is used, the block length is added to the error count. Note that the block
// length is in ds32 (output type) words, not ds16 words as transmitted in the
// block.
global module
crcunblock (
    queue(dout, ds32),
    static(eout)
    <-
    queue(in, ds16),
    int(max_blk_len, 20),
    int({sob, eob})
) {
    type(baddr, "uint:" + size(3 * max_blk_len));
    struct(ras,
        {start, finish},    baddr
    );
    rmemory(buf, 2, baddr, ds32);
    queue(p, ras);
    
    max_blk_len++;  // add 1 to allow for CRC on the end
    
    [
        static(unpacking, "log");
        static(odd, "log", true);
        static(wa1, baddr, 0);
        static(wa2, baddr, 1);
        static(temp, ds16);
        static(len, "uint:"+size(max_blk_len), max_blk_len);
        static(block_count, "uint:"+size(max_blk_len), max_blk_len);
        value(block_count_eq_0, "log", block_count == 0);
        static(crc, "uint:16");
        cmemory(crctab, 2, "uint:8", "uint:16", crc16_init);
        value({v, crc_new}, "uint:16");
        v := (crc << 8) ^ cmemoryread(crctab, 0, cast((crc >> 8) ^ (?in.data >> 8), "uint:8"));
        crc_new := (v << 8) ^ cmemoryread(crctab, 1, cast((v >> 8) ^ (?in.data & 0xff), "uint:8"));
        //value(wa2_minus_1, baddr, wa2 - 1);
        value(is_sob, "log", <in && ?in.k && (?in.data >> 8) == sob);
        value(is_eob, "log", <in && ?in.k && (?in.data >> 8) == eob);
        value(crc_eq_0, "log", crc == 0);
        
        //----------------------------------------------------------------------
        // SOB word ...
        when (is_sob) par {
            block_count <- max_blk_len;
            odd <- true;
            len <- 0;
            reset(crc);
        }
        // ... are not unpacking
        when (is_sob && !unpacking) par {
            wa1 <- wa2;
            unpacking <- true;
        }
        // ... are unpacking
        when (is_sob && unpacking) par {
            wa2 <- wa1;
            if (matched(eout))
                eout <-  eout + len;
        }

        //----------------------------------------------------------------------
        // EOB word ...
        // ... are unpacking and CRC is zero
        when (is_eob && unpacking && crc_eq_0) sync {
            p.start <<- wa1;
            p.finish <<- wa2;
            //wa2 <- wa2_minus_1;
            unpacking <- false;
        }
        // ... are unpacking and CRC is NOT zero
        when (is_eob && unpacking && !crc_eq_0) par {
            wa2 <- wa1;
            unpacking <- false;
            if (matched(eout))
                eout <-  eout + len;
        }
        
        //----------------------------------------------------------------------
        // Not SOB or EOB word ...
        // ... are unpacking and within maximum block size
        when (<in && !is_sob && !is_eob && unpacking && !block_count_eq_0 && odd) sync {
            temp <- ?in;
            crc <- crc_new;
            odd <- false;
        }
        when (<in && !is_sob && !is_eob && unpacking && !block_count_eq_0 && !odd) sync {
            value(dmw, ds32);
            dmw.data := (temp.data << 16) | ?in.data;
            dmw.k := temp.k;
            
            rmemorywrite(buf, 0, wa2, dmw);
            wa2++;
            block_count--;
            len++;
            crc <- crc_new;
            odd <- true;
        }
        // ... are unpacking and exceed maximum block size
        when (<in && !is_sob && !is_eob && unpacking && block_count_eq_0) par {
            wa2 <- wa1;
            unpacking <- false;
            if (matched(eout))
                eout <- eout + max_blk_len;
        }

        // ... are NOT unpacking - word not within a block and must be spurious!
        if (matched(eout))
            when (<in && !is_sob && !is_eob && !unpacking)
                    eout++;
  
        //----------------------------------------------------------------------
        // All the above logic examines 'in', it does not read 'in'.
        // 'in' is read (popped) here.
        null <<- in;
    ]
    
    [
        static({ra1, ra2}, baddr);
        value(w, ds32, rmemoryout(buf, 1));
        value(ra1_plus_1, baddr, ra1 + 1);
        seq {
            par {
                ra1 <- p.start;
                ra2 <- p.finish;
                rmemoryread(buf, 1, p.start);
            }
            par while (ra1 != ra2) {
                when (>dout)
                    dout <<- w;
                rmemoryread(buf, 1, ra1_plus_1);
                ra1 <- ra1_plus_1;
            }
        }
    ]
}

// Read a C #include file containing only #defines and comments and
// convert the #defines into 3PL immediate "int", "float" and "str" variables.
global procedure
cinclude (str(filename)) {
    str({s, name, val});
    int(l);
    
    file(f, filename);
    open(f, "r");
    for (;;) {
        s = readln(f);
        s = removecomments(s);
        s = compressblanks(s);
        //println(s);
        if (hadeof(f)) {
            close(f);
            return;
        }
        if (strlen(s) == 0 || s == " ")
            continue;
        if (!startswith(s, "#define")) {
            println("'" + s + "'");
            texit("cinclude(): line not #define or blank");
        }
        s = substring(s, 7);
        l = span(s, " ");
        s = substring(s, l);
        l = cspan(s, " ");
        name = "global." + substring(s, 0, l);
        s = substring(s, l);
        l = span(s, " ");
        s = substring(s, l);
        l = cspan(s, " ");
        val = substring(s, 0, l);
        if (val == "")
            log(name->, true);
        else if (startswith(val, "\""))
            str(name->, substring(val, 1, l-2));
        else if (strpos(val, ".") >= 0)
            float(name->, strtofloat(val));
        else if (val == "true")
            log(name->, true);
        else if (val == "false")
            log(name->);
        else
            int(name->, strtoint(val));
        //println("\tname\t" + name);
        //println("\tval\t" + val);
    }

    function
    removecomments (str(s)) {
        int({i, j});
        i = strpos(s, "//");
        if (i >= 0)
            s = substring(s, 0, i);
        for (;;) {
            i = strpos(s, "/*");
            if (i < 0)
                return(s);
            j = strpos(s, "*/");
            if (j < 0) {
                println("'" + s + "'");
                texit("cinclude(): unmatched /*");
            }
            s = substring(s, 0, i) + substring(s, j+2);
        }
    }

    function
    compressblanks (str(s)) {
        int({i, j});
        s = replaceall(s, "\t", " ");
        for (;;) {
            i = strpos(s, "  ");
            if (i < 0)
                return(s);
            s = replaceall(s, "  ", " ");
        }
    }
}

