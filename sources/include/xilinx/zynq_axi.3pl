nosource

module "jsontype.3pl"

trailermodule ("zynq processor") {
    zynq_ps();
}

// in general Zynq configurations should be compressed
directive("postProcessCompress", true);
// read/write transfer limit
directive("tlimit", 256);

//
// CPU API code.
//
// An instance of class CPU_API is created when this current file module
// is executed and is assigned to local variable 'cpu'. This class instance
// is used within this current file module and is also passed back to the
// application program by means of function cpu_api().
// The local use is to create interfaces for the stored copy of the .info
// JSON file (see 'infoword' and 'inforead' a few lines below).
//
source "xilinx/cpu.3pl"         // CPU API classes file
class(cpu, CPU_API());          // Create API class here as used below

// Make the API class available to application code via this function.
// Assign pointers to DMA modules and interrupt module
// to the cpu class so that the appropriate zynq modules
// can be called indirectly.
//
global function cpu_api () {
    cpu.dma_read_ptr = &dma_read;
    cpu.dma_write_ptr = &dma_write;
    cpu.sigint_ptr = &sigint;
    return(cpu);
}


//
// AXI HP buses
//
var(axi_hp_read_used, "[4]log");
var(axi_hp_write_used, "[4]log");
var({hp_wipp, hp_wapp, hp_wlpp}, "[4]->");
queuearray(hp_wipp <- "bits:64");    // array of HP write data queues
queuearray(hp_wapp <- "uint:32");    // array of HP write address queues
queuearray(hp_wlpp <- "uint:4");     // array of HP write burst length queues

var({hp_ripp, hp_rapp, hp_rlpp}, "[4]->");
queuearray(hp_ripp <- "bits:64");    // array of HP read data queues
queuearray(hp_rapp <- "uint:32");    // array of HP read address queues
queuearray(hp_rlpp <- "uint:4");     // array of HP read burst length queues

//
// AXI GP buses
//
clock(global.c100, frequency=100.0e6, tnm="C100");
clock(c100_in, frequency=100.0e6);
/*
 * Should use MMCM here to cancel out phase shift but Vivado will not allow
 * MMCM input to be connected to PS7 clock output!
 *
clock({c100_in, c100_raw, fbc, fbcraw}, frequency=100.0e6);
clkmmcm_base(
    clkfbout=fbcraw,
    clkout1=c100_raw
    <-
    clkin=c100_in,
    clkfb=fbc,
    clkfbout_mult_f=10.0,
    divclk_divide=1,
    clkout1_divide=10
);
clockbufg(fbc <- fbcraw);
clockbufg(c100 <- c100_raw);
*/
clockbufg(c100 <- c100_in);
clock(bus_clk);
bus_clk := c100;
useclock(c100);

int(gp_addr_width, 22);
int(gp_data_width, 32);
var(gp_rd_used, "[2]log");
var(gp_wr_used, "[2]log");

value(gp_arready, "[2]log", false);
value(gp_arvalid, "[2]log");
value(gp_arid, "[2]uint:12");
value(gp_arlen, "[2]uint:4");
value(gp_araddr, "[2]uint:32");
value(gp_arburst, "[2]uint:2");
value(gp_arprot, "[2]uint:3");

value(gp_rready, "[2]log");
value(gp_rvalid, "[2]log", false);
value(gp_rdata, "[2]bits:32", cast(0, "bits:32"));
static(gp_rid, "[2]uint:12");
value(gp_rlast, "[2]log", false);
static(gp_rresp, "[2]uint:2", 0);

value(gp_awready, "[2]log", false);
value(gp_awvalid, "[2]log");
value(gp_awid, "[2]uint:12");
value(gp_awlen, "[2]uint:4");
value(gp_awaddr, "[2]uint:32");
value(gp_awburst, "[2]uint:2");
value(gp_awprot, "[2]uint:3");
value(gp_wstrb, "[2]["+(gp_data_width/8)+"]log");

value(gp_wready, "[2]log", false);
value(gp_wvalid, "[2]log");
value(gp_wdata, "[2]bits:"+gp_data_width);
value(gp_wlast, "[2]log", false);

value(gp_bready, "[2]log");
static(gp_bvalid, "[2]log");
static(gp_bresp, "[2]uint:2");
static(gp_bid, "[2]uint:12");

value(gp_aresetn, "[2]log");

var(gp_rda_p, "[2]->"); // read address queues pointer array
var(gp_rdd_p, "[2]->"); // read data queues pointer array
var(gp_wra_p, "[2]->"); // write address queues pointer array
var(gp_wrd_p, "[2]->"); // write data queues pointer array
var(gp_wrr_p, "[2]->"); // write response ID queues pointer array

value(read_address_match, "[2]log", false);
value(write_address_match, "[2]log", false);

var(gp_raddr_width, "[2]int");      // read address width for each GP bus
var(gp_waddr_width, "[2]int");      // write address width for each GP bus
var(gp_raddr_type, "[2]type");      // read address type for each GP bus
var(gp_waddr_type, "[2]type");      // write address type for each GP bus
var(gp_ext_raddr_width, "[2]int");  // max read address width for GP bus memory
var(gp_ext_waddr_width, "[2]int");  // max write address width for GP bus memory
type(gp1_mem_raddr_type);           // read address type for GP bus memory
type(gp1_mem_waddr_type);           // write address type for GP bus memory

var(bus_list, "[2]list");

int(raddrinit, 1);  // start read addresses at 1, not 0
int(waddrinit, 2);  // start write addresses at 2 (even), not 0
var(read_addr, "[2]uint", {raddrinit, raddrinit});
var(write_addr, "[2]uint", {waddrinit, waddrinit});


// DMA buffer locations and sizes, set in the board header.
// Note that 'DMA_base_address' and 'DMA_available_pages' are modified
// as port interfaces are created. 
//
// 'DMA_base_address_init' and 'DMA_buffer_size_init' are defined
// in the board header file, e.g.
// 3PL/sources/include/boards/avnet/microzed-7010.3pl.
//
int(DMA_base_address, DMA_base_address_init);   // DMA base address
int(DMA_buffer_size, DMA_buffer_size_init);     // DMA total buffer size
int(DMA_available_pages);                       // DMA buffer pages available
int(hp_port);                                   // next available HP bus, 0 to 3
DMA_available_pages = DMA_buffer_size / 4096;

var(hp_base_address, "[4]uint");    // DMA port CPU physical base address
var(hp_names, "[4]str");            // HP bus space names
var(hp_blocks, "[4]uint");          // HP bus blocks in buffer space
var(hp_blocksize, "[4]uint");       // HP block size in bytes
var(hp_blockwords, "[4]uint");      // HP block length in data words
var(hp_pages, "[4]uint");           // HP block allocated 4K pages
var(hp_dtype_bits, "[4]int");       // HP bus data size in bits
var(hp_dtype, "[4]str");            // HP bus data type
enum(global.dma_block_term, none, ignore, first, last);


int(hp_writes);

//
// Interrupts
//
value(irqf2p, "[20]log");           // CPU interrupt signal inputs

// CPU interface for reading the compressed .info file
// from block RAM. The read and write addresses will both be 1.
// If subsequently not connected this interface will be deleted.
// The .info file is compressed and stored in block RAM (rmemory)
// so that it can be read and uncompressed by CPU code.
// The compressed .info data is read from 'infoword' packed in 32 bit
// words. The interface must be initialised by writing to 'inforeset'
// (a zero width write).
//
// These interfaces are created here, prior to any others, to ensure that
// the GP0 read and write addresses are both 1, i.e. the interfaces are
// first in the GP0 list. If the interfaces are not used then the first two
// list entries are removed later prior to generating the interface logic
// and .info information.
value(file.infoword, "uint:32");
static({file.inforeset, file.inforead}, "log");
cpu.read(access=inforead <- infoword, "infoword");
cpu.write(, access=inforeset <- "inforeset");

//
// Add a new interface to the appropriate bus interface list.
//
// Note that for write_stat and write_q the address is incremented by the
// number of 32-bit words in the transfer. This is because burst writes to
// an address do not seem to be invoked and instead a number of single
// word writes to successive word addresses are emitted. Thus write
// interfaces longer than one word require an address range, hence the
// address of the next interface is advanced by the number of words (and
// hence addresses) required by the previous interface.
// For burst writes the address must be even (provinence?).
//
procedure
add_interface (var (v, "->")) {
    switch (v->.interface_type) {
    
    // read value
    case itype.read_val:
        v->.addr = read_addr[0]++;
        append(bus_list[0],, v);
    
    // write static
    case itype.write_stat:
        int(words, 2);
        if (v->.var != null)
            words = 2 * ((size(v->.var->) - 1)/32 + 1);
        v->.addr = write_addr[0];
        write_addr[0] += words;
        append(bus_list[0],, v);
    
    // read queue
    case itype.read_q:
        v->.addr = read_addr[0]++;
        if (v->.ilevel < 0) {
            v->.laddr = write_addr[0];
            write_addr[0] += 2;
        }
        if (v->.caddr < 0)
            v->.caddr = read_addr[0]++;
        append(bus_list[0],, v);
    
    // write queue
    case itype.write_q:
        int(words,(2 * ((size(v->.var->) - 1)/32 + 1)));
        v->.addr = write_addr[0];
        write_addr[0] += 2;        
        if (v->.ilevel < 0) {
            v->.laddr = write_addr[0];
            write_addr[0] += words;        
        } if (v->.caddr < 0)
            v->.caddr = read_addr[0]++;
        append(bus_list[0],, v);
    
    // read memory
    case itype.read_mem:
        v->.addr = read_addr[1]++;
        int(mas, size(memoryaddresstype(v->.var->)));
        if (mas > gp_ext_raddr_width[1])
            gp_ext_raddr_width[1] = mas;
        append(bus_list[1],, v);
    
    // write memory
    case itype.write_mem:
        int(words,(2 * ((size(memorydatatype(v->.var->)) - 1)/32 + 1)));
        v->.addr = write_addr[1];
        write_addr[1] += words;
        int(mas, size(memoryaddresstype(v->.var->)));
        if (mas > gp_ext_waddr_width[1])
            gp_ext_waddr_width[1] = mas;
        append(bus_list[1],, v);
    }
}

//
// ARM procecessor low-level interface.
//
module
zynq_ps () {

    // The GP and HP buses are to use c100.
    //
    clock(gp_aclk);
    clock(hp_aclk);
    gp_aclk := c100;
    hp_aclk := c100;

    //
    // PS7 signals.
    //
    value({ DMA0DAVALID, DMA0DRREADY, DMA0RSTN, DMA1DAVALID, DMA1DRREADY, 
            DMA1RSTN, DMA2DAVALID, DMA2DRREADY, DMA2RSTN, DMA3DAVALID, 
            DMA3DRREADY, DMA3RSTN, EMIOCAN0PHYTX, EMIOCAN1PHYTX, 
            EMIOENET0GMIITXEN, EMIOENET0GMIITXER, EMIOENET0MDIOMDC, 
            EMIOENET0MDIOO, EMIOENET0MDIOTN, EMIOENET0PTPDELAYREQRX, 
            EMIOENET0PTPDELAYREQTX, EMIOENET0PTPPDELAYREQRX, 
            EMIOENET0PTPPDELAYREQTX, EMIOENET0PTPPDELAYRESPRX, 
            EMIOENET0PTPPDELAYRESPTX, EMIOENET0PTPSYNCFRAMERX, 
            EMIOENET0PTPSYNCFRAMETX, EMIOENET0SOFRX, EMIOENET0SOFTX, 
            EMIOENET1GMIITXEN, EMIOENET1GMIITXER, EMIOENET1MDIOMDC, 
            EMIOENET1MDIOO, EMIOENET1MDIOTN, EMIOENET1PTPDELAYREQRX, 
            EMIOENET1PTPDELAYREQTX, EMIOENET1PTPPDELAYREQRX, 
            EMIOENET1PTPPDELAYREQTX, EMIOENET1PTPPDELAYRESPRX, 
            EMIOENET1PTPPDELAYRESPTX, EMIOENET1PTPSYNCFRAMERX, 
            EMIOENET1PTPSYNCFRAMETX, EMIOENET1SOFRX, EMIOENET1SOFTX, 
            EMIOI2C0SCLO, EMIOI2C0SCLTN, EMIOI2C0SDAO, EMIOI2C0SDATN, 
            EMIOI2C1SCLO, EMIOI2C1SCLTN, EMIOI2C1SDAO, EMIOI2C1SDATN, 
            EMIOPJTAGTDO, EMIOPJTAGTDTN, EMIOSDIO0BUSPOW, EMIOSDIO0CLK, 
            EMIOSDIO0CMDO, EMIOSDIO0CMDTN, EMIOSDIO0LED, EMIOSDIO1BUSPOW, 
            EMIOSDIO1CLK, EMIOSDIO1CMDO, EMIOSDIO1CMDTN, EMIOSDIO1LED, 
            EMIOSPI0MO, EMIOSPI0MOTN, EMIOSPI0SCLKO, EMIOSPI0SCLKTN, 
            EMIOSPI0SO, EMIOSPI0SSNTN, EMIOSPI0STN, EMIOSPI1MO, 
            EMIOSPI1MOTN, EMIOSPI1SCLKO, EMIOSPI1SCLKTN, EMIOSPI1SO, 
            EMIOSPI1SSNTN, EMIOSPI1STN, EMIOTRACECTL, EMIOUART0DTRN, 
            EMIOUART0RTSN, EMIOUART0TX, EMIOUART1DTRN, EMIOUART1RTSN, 
            EMIOUART1TX, EMIOUSB0VBUSPWRSELECT, EMIOUSB1VBUSPWRSELECT, 
            EMIOWDTRSTO, EVENTEVENTO, MAXIGP0WLAST, MAXIGP1WLAST, 
            SAXIACPARESETN, SAXIACPARREADY, SAXIACPAWREADY, SAXIACPBVALID, 
            SAXIACPRLAST, SAXIACPRVALID, SAXIACPWREADY, SAXIGP0ARESETN, 
            SAXIGP0ARREADY, SAXIGP0AWREADY, SAXIGP0BVALID, SAXIGP0RLAST, 
            SAXIGP0RVALID, SAXIGP0WREADY, SAXIGP1ARESETN, SAXIGP1ARREADY, 
            SAXIGP1AWREADY, SAXIGP1BVALID, SAXIGP1RLAST, SAXIGP1RVALID, 
            SAXIGP1WREADY, SAXIHP0ARESETN, SAXIHP0ARREADY, SAXIHP0AWREADY, 
            SAXIHP0BVALID, SAXIHP0RLAST, SAXIHP0RVALID, SAXIHP0WREADY, 
            SAXIHP1ARESETN, SAXIHP1ARREADY, SAXIHP1AWREADY, SAXIHP1BVALID, 
            SAXIHP1RLAST, SAXIHP1RVALID, SAXIHP1WREADY, SAXIHP2ARESETN, 
            SAXIHP2ARREADY, SAXIHP2AWREADY, SAXIHP2BVALID, SAXIHP2RLAST, 
            SAXIHP2RVALID, SAXIHP2WREADY, SAXIHP3ARESETN, SAXIHP3ARREADY, 
            SAXIHP3AWREADY, SAXIHP3BVALID, SAXIHP3RLAST, SAXIHP3RVALID, 
            SAXIHP3WREADY}, "log");
    value(DMA0DATYPE, "uint:2");
    value(DMA1DATYPE, "uint:2");
    value(DMA2DATYPE, "uint:2");
    value(DMA3DATYPE, "uint:2");
    value(EMIOENET0GMIITXD, "uint:8");
    value(EMIOENET1GMIITXD, "uint:8");
    value(EMIOGPIOO, "bits:64");
    value(EMIOGPIOTN, "bits:64");
    value(EMIOSDIO0BUSVOLT, "uint:3");
    value(EMIOSDIO0DATAO, "[4]log");
    value(EMIOSDIO0DATATN, "[4]log");
    value(EMIOSDIO1BUSVOLT, "uint:3");
    value(EMIOSDIO1DATAO, "[4]log");
    value(EMIOSDIO1DATATN, "[4]log");
    value(EMIOSPI0SSON, "[3]log");
    value(EMIOSPI1SSON, "[3]log");
    value(EMIOTRACEDATA, "bits:32");
    value(EMIOTTC0WAVEO, "uint:3");
    value(EMIOTTC1WAVEO, "uint:3");
    value(EMIOUSB0PORTINDCTL, "[2]log");
    value(EMIOUSB1PORTINDCTL, "[2]log");
    value(EVENTSTANDBYWFE, "[2]log");
    value(EVENTSTANDBYWFI, "[2]log");
    value(FCLKRESETN, "[4]log");
    value(FTMTF2PTRIGACK, "[4]log");
    value(FTMTP2FDEBUG, "bits:32");
    value(FTMTP2FTRIG, "[4]log");
    value(IRQP2F, "bits:29");
    value(MAXIGP0ARBURST, "uint:2");
    value(MAXIGP0ARCACHE, "uint:4");
    value(MAXIGP0ARLEN, "uint:4");
    value(MAXIGP0ARLOCK, "uint:2");
    value(MAXIGP0ARQOS, "uint:4");
    value(MAXIGP0ARSIZE, "uint:2");
    value(MAXIGP0AWBURST, "uint:2");
    value(MAXIGP0AWCACHE, "uint:4");
    value(MAXIGP0AWLEN, "uint:4");
    value(MAXIGP0AWLOCK, "uint:2");
    value(MAXIGP0AWQOS, "uint:4");
    value(MAXIGP0AWSIZE, "uint:2");
    value(MAXIGP0WID, "uint:12");
    value(MAXIGP1ARBURST, "uint:2");
    value(MAXIGP1ARCACHE, "uint:4");
    value(MAXIGP1ARLEN, "uint:4");
    value(MAXIGP1ARLOCK, "uint:2");
    value(MAXIGP1ARQOS, "uint:4");
    value(MAXIGP1ARSIZE, "uint:2");
    value(MAXIGP1AWBURST, "uint:2");
    value(MAXIGP1AWCACHE, "uint:4");
    value(MAXIGP1AWLEN, "uint:4");
    value(MAXIGP1AWLOCK, "uint:2");
    value(MAXIGP1AWQOS, "uint:4");
    value(MAXIGP1AWSIZE, "uint:2");
    value(MAXIGP1WID, "uint:12");
    value(SAXIACPBID, "uint:3");
    value(SAXIACPBRESP, "uint:2");
    value(SAXIACPRDATA, "bits:64");
    value(SAXIACPRID, "uint:3");
    value(SAXIACPRRESP, "uint:2");
    value(SAXIGP0BID, "uint:6");
    value(SAXIGP0BRESP, "uint:2");
    value(SAXIGP0RDATA, "bits:32");
    value(SAXIGP0RID, "uint:6");
    value(SAXIGP0RRESP, "uint:2");
    value(SAXIGP1BID, "uint:6");
    value(SAXIGP1BRESP, "uint:2");
    value(SAXIGP1RDATA, "bits:32");
    value(SAXIGP1RID, "uint:6");
    value(SAXIGP1RRESP, "uint:2");
    value(SAXIHP0BID, "uint:6");
    value(SAXIHP0BRESP, "uint:2");
    value(SAXIHP0RACOUNT, "uint:3");
    value(SAXIHP0RCOUNT, "uint:8");
    value(SAXIHP0RDATA, "bits:64");
    value(SAXIHP0RID, "uint:6");
    value(SAXIHP0RRESP, "uint:2");
    value(SAXIHP0WACOUNT, "uint:6");
    value(SAXIHP0WCOUNT, "uint:8");
    value(SAXIHP1BID, "uint:6");
    value(SAXIHP1BRESP, "uint:2");
    value(SAXIHP1RACOUNT, "uint:3");
    value(SAXIHP1RCOUNT, "uint:8");
    value(SAXIHP1RDATA, "bits:64");
    value(SAXIHP1RID, "uint:6");
    value(SAXIHP1RRESP, "uint:2");
    value(SAXIHP1WACOUNT, "uint:6");
    value(SAXIHP1WCOUNT, "uint:8");
    value(SAXIHP2BID, "uint:6");
    value(SAXIHP2BRESP, "uint:2");
    value(SAXIHP2RACOUNT, "uint:3");
    value(SAXIHP2RCOUNT, "uint:8");
    value(SAXIHP2RDATA, "bits:64");
    value(SAXIHP2RID, "uint:6");
    value(SAXIHP2RRESP, "uint:2");
    value(SAXIHP2WACOUNT, "uint:6");
    value(SAXIHP2WCOUNT, "uint:8");
    value(SAXIHP3BID, "uint:6");
    value(SAXIHP3BRESP, "uint:2");
    value(SAXIHP3RACOUNT, "uint:3");
    value(SAXIHP3RCOUNT, "uint:8");
    value(SAXIHP3RDATA, "bits:64");
    value(SAXIHP3RID, "uint:6");
    value(SAXIHP3RRESP, "uint:2");
    value(SAXIHP3WACOUNT, "uint:6");
    value(SAXIHP3WCOUNT, "uint:8");
    value({DMA0ACLK, DMA0DAREADY, DMA0DRLAST, DMA0DRVALID, DMA1ACLK,
           DMA1DAREADY, DMA1DRLAST, DMA1DRVALID, DMA2ACLK,
           DMA2DAREADY, DMA2DRLAST, DMA2DRVALID, DMA3ACLK,
           DMA3DAREADY, DMA3DRLAST, DMA3DRVALID, EMIOCAN0PHYRX,
           EMIOCAN1PHYRX, EMIOENET0EXTINTIN, EMIOENET0GMIICOL,
           EMIOENET0GMIICRS, EMIOENET0GMIIRXCLK, EMIOENET0GMIIRXDV,
           EMIOENET0GMIIRXER, EMIOENET0GMIITXCLK, EMIOENET0MDIOI,
           EMIOENET1EXTINTIN, EMIOENET1GMIICOL, EMIOENET1GMIICRS,
           EMIOENET1GMIIRXCLK, EMIOENET1GMIIRXDV, EMIOENET1GMIIRXER,
           EMIOENET1GMIITXCLK, EMIOENET1MDIOI, EMIOI2C0SCLI,
           EMIOI2C0SDAI, EMIOI2C1SCLI, EMIOI2C1SDAI, EMIOPJTAGTCK,
           EMIOPJTAGTDI, EMIOPJTAGTMS, EMIOSDIO0CDN, EMIOSDIO0CLKFB,
           EMIOSDIO0CMDI, EMIOSDIO0WP, EMIOSDIO1CDN, EMIOSDIO1CLKFB,
           EMIOSDIO1CMDI, EMIOSDIO1WP, EMIOSPI0MI, EMIOSPI0SCLKI,
           EMIOSPI0SI, EMIOSPI0SSIN, EMIOSPI1MI, EMIOSPI1SCLKI,
           EMIOSPI1SI, EMIOSPI1SSIN, EMIOSRAMINTIN, EMIOTRACECLK,
           EMIOUART0CTSN, EMIOUART0DCDN, EMIOUART0DSRN, EMIOUART0RIN,
           EMIOUART0RX, EMIOUART1CTSN, EMIOUART1DCDN, EMIOUART1DSRN,
           EMIOUART1RIN, EMIOUART1RX, EMIOUSB0VBUSPWRFAULT,
           EMIOUSB1VBUSPWRFAULT, EMIOWDTCLKI, EVENTEVENTI, FPGAIDLEN,
           FTMDTRACEINCLOCK, FTMDTRACEINVALID, MAXIGP0ACLK,
           MAXIGP0ARREADY, MAXIGP0AWREADY, MAXIGP0BVALID,
           MAXIGP0RVALID, MAXIGP0WREADY, MAXIGP1ACLK,
           MAXIGP1ARREADY, MAXIGP1AWREADY, MAXIGP1BVALID,
           MAXIGP1RVALID, MAXIGP1WREADY, SAXIACPACLK,
           SAXIACPARVALID, SAXIACPAWVALID, SAXIACPBREADY,
           SAXIACPRREADY, SAXIACPWLAST, SAXIACPWVALID, SAXIGP0ACLK,
           SAXIGP0ARVALID, SAXIGP0AWVALID, SAXIGP0BREADY,
           SAXIGP0RREADY, SAXIGP0WLAST, SAXIGP0WVALID, SAXIGP1ACLK,
           SAXIGP1ARVALID, SAXIGP1AWVALID, SAXIGP1BREADY,
           SAXIGP1RREADY, SAXIGP1WLAST, SAXIGP1WVALID, SAXIHP0ACLK,
           SAXIHP0ARVALID, SAXIHP0AWVALID, SAXIHP0BREADY,
           SAXIHP0RDISSUECAP1EN, SAXIHP0RREADY, SAXIHP0WLAST,
           SAXIHP0WRISSUECAP1EN, SAXIHP0WVALID, SAXIHP1ACLK,
           SAXIHP1ARVALID, SAXIHP1AWVALID, SAXIHP1BREADY,
           SAXIHP1RDISSUECAP1EN, SAXIHP1RREADY, SAXIHP1WLAST,
           SAXIHP1WRISSUECAP1EN, SAXIHP1WVALID, SAXIHP2ACLK,
           SAXIHP2ARVALID, SAXIHP2AWVALID, SAXIHP2BREADY,
           SAXIHP2RDISSUECAP1EN, SAXIHP2RREADY, SAXIHP2WLAST,
           SAXIHP2WRISSUECAP1EN, SAXIHP2WVALID, SAXIHP3ACLK,
           SAXIHP3ARVALID, SAXIHP3AWVALID, SAXIHP3BREADY,
           SAXIHP3RDISSUECAP1EN, SAXIHP3RREADY, SAXIHP3WLAST,
           SAXIHP3WRISSUECAP1EN, SAXIHP3WVALID}, "log", false);
    value(DDRARB, "[4]log", false);
    value(DMA0DRTYPE, "uint:2", 0);
    value(DMA1DRTYPE, "uint:2", 0);
    value(DMA2DRTYPE, "uint:2", 0);
    value(DMA3DRTYPE, "uint:2", 0);
    value(EMIOENET0GMIIRXD, "[8]log", false);
    value(EMIOENET1GMIIRXD, "[8]log", false);
    value(EMIOGPIOI, "bits:64", 0);
    value(EMIOSDIO0DATAI, "[4]log", false);
    value(EMIOSDIO1DATAI, "[4]log", false);
    value(EMIOTTC0CLKI, "[3]log", false);
    value(EMIOTTC1CLKI, "[3]log", false);
    value(FCLKCLKTRIGN, "[4]log", false);
    value(FTMDTRACEINATID, "[4]log", false);
    value(FTMDTRACEINDATA, "uint:32", 0);
    value(FTMTF2PDEBUG, "uint:32", 0);
    value(FTMTF2PTRIG, "[4]log", false);
    value(FTMTP2FTRIGACK, "[4]log", false);
    value(IRQF2P, "[20]log", false);
    value(MAXIGP0BRESP, "uint:2", 0);
    value(MAXIGP0RDATA, "uint:32", 0);
    value(MAXIGP0RRESP, "uint:2", 0);
    value(MAXIGP1BRESP, "uint:2", 0);
    value(MAXIGP1RDATA, "uint:32", 0);
    value(MAXIGP1RRESP, "uint:2", 0);
    value(SAXIACPARADDR, "uint:32", 0);
    value(SAXIACPARBURST, "uint:2", 0);
    value(SAXIACPARCACHE, "[4]log", false);
    value(SAXIACPARID, "[3]log", false);
    value(SAXIACPARLEN, "[4]log", false);
    value(SAXIACPARLOCK, "uint:2", 0);
    value(SAXIACPARPROT, "[3]log", false);
    value(SAXIACPARQOS, "[4]log", false);
    value(SAXIACPARSIZE, "uint:2", 0);
    value(SAXIACPARUSER, "[5]log", false);
    value(SAXIACPAWADDR, "uint:32", 0);
    value(SAXIACPAWBURST, "uint:2", 0);
    value(SAXIACPAWCACHE, "[4]log", false);
    value(SAXIACPAWID, "[3]log", false);
    value(SAXIACPAWLEN, "[4]log", false);
    value(SAXIACPAWLOCK, "uint:2", 0);
    value(SAXIACPAWPROT, "[3]log", false);
    value(SAXIACPAWQOS, "[4]log", false);
    value(SAXIACPAWSIZE, "uint:2", 0);
    value(SAXIACPAWUSER, "[5]log", false);
    value(SAXIACPWDATA, "bits:64", 0);
    value(SAXIACPWID, "[3]log", false);
    value(SAXIACPWSTRB, "[8]log", false);
    value(SAXIGP0ARADDR, "uint:32", 0);
    value(SAXIGP0ARBURST, "uint:2", 0);
    value(SAXIGP0ARCACHE, "[4]log", false);
    value(SAXIGP0ARID, "uint:6", 0);
    value(SAXIGP0ARLEN, "[4]log", false);
    value(SAXIGP0ARLOCK, "uint:2", 0);
    value(SAXIGP0ARPROT, "[3]log", false);
    value(SAXIGP0ARQOS, "[4]log", false);
    value(SAXIGP0ARSIZE, "uint:2", 0);
    value(SAXIGP0AWADDR, "uint:32", 0);
    value(SAXIGP0AWBURST, "uint:2", 0);
    value(SAXIGP0AWCACHE, "[4]log", false);
    value(SAXIGP0AWID, "uint:6", 0);
    value(SAXIGP0AWLEN, "[4]log", false);
    value(SAXIGP0AWLOCK, "uint:2", 0);
    value(SAXIGP0AWPROT, "[3]log", false);
    value(SAXIGP0AWQOS, "[4]log", false);
    value(SAXIGP0AWSIZE, "uint:2", 0);
    value(SAXIGP0WDATA, "uint:32", 0);
    value(SAXIGP0WID, "uint:6", 0);
    value(SAXIGP0WSTRB, "[4]log", false);
    value(SAXIGP1ARADDR, "uint:32", 0);
    value(SAXIGP1ARBURST, "uint:2", 0);
    value(SAXIGP1ARCACHE, "[4]log", false);
    value(SAXIGP1ARID, "uint:6", 0);
    value(SAXIGP1ARLEN, "[4]log", false);
    value(SAXIGP1ARLOCK, "uint:2", 0);
    value(SAXIGP1ARPROT, "[3]log", false);
    value(SAXIGP1ARQOS, "[4]log", false);
    value(SAXIGP1ARSIZE, "uint:2", 0);
    value(SAXIGP1AWADDR, "uint:32", 0);
    value(SAXIGP1AWBURST, "uint:2", 0);
    value(SAXIGP1AWCACHE, "[4]log", false);
    value(SAXIGP1AWID, "uint:6", 0);
    value(SAXIGP1AWLEN, "[4]log", false);
    value(SAXIGP1AWLOCK, "uint:2", 0);
    value(SAXIGP1AWPROT, "[3]log", false);
    value(SAXIGP1AWQOS, "[4]log", false);
    value(SAXIGP1AWSIZE, "uint:2", 0);
    value(SAXIGP1WDATA, "uint:32", 0);
    value(SAXIGP1WID, "uint:6", 0);
    value(SAXIGP1WSTRB, "[4]log", false);
    value(SAXIHP0ARADDR, "uint:32", 0);
    value(SAXIHP0ARBURST, "uint:2", 0);
    value(SAXIHP0ARCACHE, "[4]log", false);
    value(SAXIHP0ARID, "uint:6", 0);
    value(SAXIHP0ARLEN, "[4]uint:4", 0);
    value(SAXIHP0ARLOCK, "uint:2", 0);
    value(SAXIHP0ARPROT, "[3]log", false);
    value(SAXIHP0ARQOS, "[4]log", false);
    value(SAXIHP0ARSIZE, "uint:2", 0);
    value(SAXIHP0AWADDR, "uint:32", 0);
    value(SAXIHP0AWBURST, "uint:2", 0);
    value(SAXIHP0AWCACHE, "[4]log", false);
    value(SAXIHP0AWID, "uint:6", 0);
    value(SAXIHP0AWLEN, "[4]uint:4", 0);
    value(SAXIHP0AWLOCK, "uint:2", 0);
    value(SAXIHP0AWPROT, "[3]log", false);
    value(SAXIHP0AWQOS, "[4]log", false);
    value(SAXIHP0AWSIZE, "uint:2", 0);
    value(SAXIHP0WDATA, "bits:64", 0);
    value(SAXIHP0WID, "uint:6", 0);
    value(SAXIHP0WSTRB, "[8]log", false);
    value(SAXIHP1ARADDR, "uint:32", 0);
    value(SAXIHP1ARBURST, "uint:2", 0);
    value(SAXIHP1ARCACHE, "[4]log", false);
    value(SAXIHP1ARID, "uint:6", 0);
    value(SAXIHP1ARLEN, "[4]uint:4", 0);
    value(SAXIHP1ARLOCK, "uint:2", 0);
    value(SAXIHP1ARPROT, "[3]log", false);
    value(SAXIHP1ARQOS, "[4]log", false);
    value(SAXIHP1ARSIZE, "uint:2", 0);
    value(SAXIHP1AWADDR, "uint:32", 0);
    value(SAXIHP1AWBURST, "uint:2", 0);
    value(SAXIHP1AWCACHE, "[4]log", false);
    value(SAXIHP1AWID, "uint:6", 0);
    value(SAXIHP1AWLEN, "[4]uint:4", 0);
    value(SAXIHP1AWLOCK, "uint:2", 0);
    value(SAXIHP1AWPROT, "[3]log", false);
    value(SAXIHP1AWQOS, "[4]log", false);
    value(SAXIHP1AWSIZE, "uint:2", 0);
    value(SAXIHP1WDATA, "bits:64", 0);
    value(SAXIHP1WID, "uint:6", 0);
    value(SAXIHP1WSTRB, "[8]log", false);
    value(SAXIHP2ARADDR, "uint:32", 0);
    value(SAXIHP2ARBURST, "uint:2", 0);
    value(SAXIHP2ARCACHE, "[4]log", false);
    value(SAXIHP2ARID, "uint:6", 0);
    value(SAXIHP2ARLEN, "[4]uint:4", 0);
    value(SAXIHP2ARLOCK, "uint:2", 0);
    value(SAXIHP2ARPROT, "[3]log", false);
    value(SAXIHP2ARQOS, "[4]log", false);
    value(SAXIHP2ARSIZE, "uint:2", 0);
    value(SAXIHP2AWADDR, "uint:32", 0);
    value(SAXIHP2AWBURST, "uint:2", 0);
    value(SAXIHP2AWCACHE, "[4]log", false);
    value(SAXIHP2AWID, "uint:6", 0);
    value(SAXIHP2AWLEN, "[4]uint:4", 0);
    value(SAXIHP2AWLOCK, "uint:2", 0);
    value(SAXIHP2AWPROT, "[3]log", false);
    value(SAXIHP2AWQOS, "[4]log", false);
    value(SAXIHP2AWSIZE, "uint:2", 0);
    value(SAXIHP2WDATA, "bits:64", 0);
    value(SAXIHP2WID, "uint:6", 0);
    value(SAXIHP2WSTRB, "[8]log", false);
    value(SAXIHP3ARADDR, "uint:32", 0);
    value(SAXIHP3ARBURST, "uint:2", 0);
    value(SAXIHP3ARCACHE, "[4]log", false);
    value(SAXIHP3ARID, "uint:6", 0);
    value(SAXIHP3ARLEN, "[4]uint:4", 0);
    value(SAXIHP3ARLOCK, "uint:2", 0);
    value(SAXIHP3ARPROT, "[3]log", false);
    value(SAXIHP3ARQOS, "[4]log", false);
    value(SAXIHP3ARSIZE, "uint:2", 0);
    value(SAXIHP3AWADDR, "uint:32", 0);
    value(SAXIHP3AWBURST, "uint:2", 0);
    value(SAXIHP3AWCACHE, "[4]log", false);
    value(SAXIHP3AWID, "uint:6", 0);
    value(SAXIHP3AWLEN, "[4]uint:4", 0);
    value(SAXIHP3AWLOCK, "uint:2", 0);
    value(SAXIHP3AWPROT, "[3]log", false);
    value(SAXIHP3AWQOS, "[4]log", false);
    value(SAXIHP3AWSIZE, "uint:2", 0);
    value(SAXIHP3WDATA, "bits:64", 0);
    value(SAXIHP3WID, "uint:6", 0);
    value(SAXIHP3WSTRB, "[8]log", false);

    selectvalue(DDR_addr, "uint:15");
    selectvalue(DDR_ba, "uint:3");
    selectvalue(DDR_cas_n, "log");
    selectvalue(DDR_ck_n, "log");
    selectvalue(DDR_ck_p, "log");
    selectvalue(DDR_cke, "log");
    selectvalue(DDR_cs_n, "log");
    selectvalue(DDR_dm, "uint:4");
    selectvalue(DDR_dq, "bits:32");
    selectvalue(DDR_dqs_n, "bits:4");
    selectvalue(DDR_dqs_p, "bits:4");
    selectvalue(DDR_odt, "log");
    selectvalue(DDR_ras_n, "log");
    selectvalue(DDR_reset_n, "log");
    selectvalue(DDR_we_n, "log");
    selectvalue(FIXED_IO_ddr_vrn, "log");
    selectvalue(FIXED_IO_ddr_vrp, "log");
    selectvalue(FIXED_IO_mio, "bits:54");
    selectvalue(FIXED_IO_ps_clk, "log");
    selectvalue(FIXED_IO_ps_porb, "log");
    selectvalue(FIXED_IO_ps_srstb, "log");

    value(fclk, "[4]log");
    
    // Get fclk[0] from the CPU. It is 100MHz so equate it to
    // clock c100.
    //
    // NOTE: c100 := clockfromexpr(fclk[0]); DOESN'T WORK!!!
    clockfromexpr(c100_in <- fclk[0]);
    
    

    //---------------------------------------------------------------------------
    // AXI GP buses 0 and 1
    // PS is bus master.
    //
    // For bus 0 or 1-
    //
    // gp_rda_p[bus]  points to the read address queue   - master -> slave
    // gp_rdd_p[bus]  points to the read data queue      - master <- slave
    //
    // gp_wra_p[bus]  points to the write address queue  - master -> slave 
    // gp_wrd_p[bus]  points to the write data queue     - master -> slave 
    // gp_wrr_p[bus]  points to the write response queue - master <- slave
    //

    useclock(gp_aclk);    
    
    /*
     * Can't think of much to reset!
    for (int(bus) ; bus<2 ; bus++)
        when (!gp_aresetn[bus])
            reset(gp_bvalid[bus]);  // WHAT ELSE SHOULD BE RESET?
    */
    
    // Determine bus address widths.
    for (int(bus) ; bus<2 ; bus++) {
        if (read_addr[bus] > raddrinit) {
            gp_rd_used[bus] = true;
            gp_raddr_width[bus] = size(read_addr[bus] - 1);
            if (bus == 1)
                gp_raddr_width[bus] += gp_ext_raddr_width[bus];
            gp_raddr_type[bus] = "uint:"+gp_raddr_width[bus];
        }
        if (write_addr[bus] > waddrinit) {
            gp_wr_used[bus] = true;
            gp_waddr_width[bus] = size(write_addr[bus] - 1);
            if (bus == 1)
                gp_waddr_width[bus] += gp_ext_waddr_width[bus];
            gp_waddr_type[bus] = "uint:"+gp_waddr_width[bus];
        }
    }
    
    if (gp_rd_used[1])
        gp1_mem_raddr_type = "uint:"+gp_ext_raddr_width[1];
    if (gp_wr_used[1])
        gp1_mem_waddr_type = "uint:"+gp_ext_waddr_width[1];
    
    // Create GP bus read address queues.
    // These are accessed via pointers.
    for (int(bus) ; bus<2 ; bus++) {
        if (gp_rd_used[bus]) {
            struct(as,
                addr,   "uint:"+gp_raddr_width[bus],
                id,     "uint:12",
                len,    "uint:4"
            );
            queue(gp_rda, as, mindepth=16, ignoremodules=true);
            queue(gp_rdd, "uint:32", mindepth=256, ignoremodules=true);
            gp_rda_p[bus] = &gp_rda;
            gp_rdd_p[bus] = &gp_rdd;
        }
    }

    
    // Create GP bus write address, write data and write response queues.
    // These are accessed via pointers.
    for (int(bus) ; bus<2 ; bus++) {
        if (gp_wr_used[bus]) {
            struct(as,
                addr,   "uint:"+gp_waddr_width[bus],
                id,     "uint:12",
                len,    "uint:4"
            );
            struct(wrs,
                id, "uint:12",
                ec, "uint:2"
            );
            queue(gp_wra, as, mindepth=16, ignoremodules=true);
            queue(gp_wrd, "bits:32", mindepth=256, ignoremodules=true, ignoremodules=true);
            queue(gp_wrr, wrs, mindepth=16, ignoremodules=true);
            gp_wra_p[bus] = &gp_wra;
            gp_wrd_p[bus] = &gp_wrd;
            gp_wrr_p[bus] = &gp_wrr;
        }
    }
    
    // Instantiate GP bus read address bus and data bus logic where used.
    for (int(bus) ; bus<2 ; bus++) {
        if (gp_rd_used[bus]) {
            m_axi_gp_read_address(
                gp_arready[bus],
                gp_rda_p[bus]->
                <-
                gp_addr_width,
                gp_araddr[bus],
                gp_arvalid[bus],
                gp_arid[bus],
                gp_arlen[bus]
            );
            m_axi_gp_read_data(
                gp_rid[bus],
                gp_rdata[bus],
                gp_rvalid[bus],
                gp_rresp[bus],
                gp_rlast[bus]
                <-
                gp_rdd_p[bus]->,
                gp_rready[bus]
            );
        }
    }
    
    // Instantiate GP bus write address, data and response bus logic where used.
    for (int(bus) ; bus<2 ; bus++) {
        if (gp_wr_used[bus]) {
            m_axi_gp_write_address(
                gp_awready[bus],
                gp_wra_p[bus]->
                <-
                gp_addr_width,
                gp_awaddr[bus],
                gp_awvalid[bus], gp_awid[bus], gp_awlen[bus]
            );
            m_axi_gp_write(
                gp_wready[bus],
                gp_wrd_p[bus]->
                <-
                gp_wvalid[bus],
                gp_wdata[bus]
            );
            m_axi_gp_write_response(
                gp_bid[bus],
                gp_bresp[bus],
                gp_bvalid[bus]
                <-
                gp_bready[bus],
                gp_wrr_p[bus]->
            );
        }
    }

    // GP bus read address logic.
    // This writes the address, read ID and burst length to the read address
    // queue for GP0 or GP1 (via pointer to queue gp_rda_p[bus]).
    // This queue is examined by all bus read interface instances
    // and the one whose address matches the requested address will
    // pop the read address queue and write data to the associated read data
    // queue.
    module
    m_axi_gp_read_address(
        value(arready, "log"),
        queue(gp_rda)
        <-
        int(addr_width),
        value(ARADDR, "uint:"+addr_width),
        value(ARVALID, "log"),
        value(ARID, "uint:12"),
        value(ARLEN, "uint:4")
    ) {
        // ARREADY can be tied high as depth of queue gp_rda is greater
        // than maximum number of queued requests from the bus master
        // so it will never block.
        arready := true;
        
        when (ARVALID) sync {
            // Send read request to bus read interfaces via queue.
            gp_rda.addr <<- ARADDR >> 2;
            gp_rda.id <<- ARID;
            gp_rda.len <<- ARLEN;
        }
    }
    
    // GP bus read data logic.
    // This reads the read data queue. The first datum contains the ID,
    // burst length and error code packed into one word. The burst length
    // is actually the number of transfers - 1, so it is zero for a single
    // transfer. Subsequent data from the queue contain the read data, the
    // number of data words matching the burst length.
    module
    m_axi_gp_read_data(
        static(gp_rid, "uint:12"),
        value(gp_rdata, "bits:32"),
        value(gp_rvalid, "log"),
        static(gp_rresp, "uint:2"),
        value(gp_rlast, "log")
        <-
        queue(gp_rdd),
        value(gp_rready, "log")
                
    ) {
        static(len, "int:5", -1);
        
        gp_rdata := ?gp_rdd;
        gp_rvalid := len >= 0;
        gp_rlast := len == 0;
        
        when (len < 0) sync {
            // 1st datum on queue is burst length,  read ID and response code
            gp_rid <- gp_rdd;           // ID is lower 12 bits
            len <- gp_rdd >> 12;        // burst length is next 4 bits
            gp_rresp <- gp_rdd >> 16;   // error code is next 2 bits
        }
        when (len >= 0 && gp_rready) par {
            null <<- gp_rdd;
            len--;
        }
    }

    // GP bus write address logic.
    module
    m_axi_gp_write_address(
        value(awready, "log"),
        queue(gp_wra)
        <-
        int(addr_width),
        value(AWADDR, "uint:"+addr_width),
        value(AWVALID, "log"),
        value(AWID, "uint:12"),
        value(AWLEN, "uint:4")
    ) {
        // AWREADY can be tied high as depth of queue gp_awr is greater
        // than maximum number of queued requests from the bus master
        // so it will never block.
        awready := true;
        
        when (AWVALID) sync {
            // Send read request to bus write interfaces via queue.
            gp_wra.addr <<- AWADDR >> 2;
            gp_wra.id <<- AWID;
            gp_wra.len <<- AWLEN;
        }
    }

    module
    m_axi_gp_write (
        value(wready, "log"),
        queue(gp_wrd)
        <-
        value(WVALID, "log"),
        value(gp_wdata, "bits:32")
    ) {
        // Assume here that the write data queue is available,
        // so tie WREADY high.
        wready := true;
        
        when (WVALID) par {
            gp_wrd <<- gp_wdata;
        }
    }

    module
    m_axi_gp_write_response (
        static(bid, "uint:12"),
        static(bresp, "uint:2"),
        static(bvalid, "log")
        <-
        value(BREADY, "log"),
        queue(gp_wrresp)
    ) {
        when (<gp_wrresp) par {
            bid <- ?gp_wrresp.id;
            bresp <- ?gp_wrresp.ec;
        }
        when (BREADY && <gp_wrresp) seq {
            bvalid <- true;
            par {
                bvalid <- false;
                null <<- gp_wrresp;
            }
        }
    }


    //---------------------------------------------------------------------------
    // AXI HP busses 0 to 3
    // PL is bus master.
    //


    // HP outputs from PS for write
    value(hp_aresetn, "[4]log");
    value(hp_awready, "[4]log");
    value(hp_bvalid, "[4]log");
    value(hp_wready, "[4]log");
    value(hp_bid, "[4]uint:6");
    value(hp_bresp, "[4]uint:2");
    
    // HP outputs from PS for read
    value(hp_arready, "[4]log");
    value(hp_rlast, "[4]log");
    value(hp_rvalid, "[4]log");
    value(hp_rdata, "[4]bits:64");
    value(hp_rid, "[4]uint:6");
    value(hp_rresp, "[4]uint:2");

    // HP inputs to PS for write
    value(hp_wdata, "[4]bits:64", cast(0, "bits:64"));
    value(hp_awaddr, "[4]uint:32", 0);
    value(hp_awlen, "[4]uint:4", 0);
    value(hp_wlast, "[4]log", false);
    static(hp_awvalid, "[4]log");
    value(hp_wvalid, "[4]log", false);
    value(hp_wrissuecap1en, "[4]log", false);
    value(hp_bready, "[4]log", true);       // accept and ignore write response
    value(hp_awburst, "[4]uint:2", 0b01);   // INCR mode
    //value(hp_awcache, "[4]uint:4", 0b1011); // write-back, write-allocate
    value(hp_awcache, "[4]uint:4", 0b0011); // normal, non-cacheable, bufferable
    value(hp_awid, "[4]uint:6", 0);
    value(hp_awlock, "[4]uint:2", 0);       // normal access
    value(hp_awprot, "[4]uint:3", 0);       // not interpretted
    value(hp_awqos, "[4]uint:4", 0);
    value(hp_awsize, "[4]uint:2", 0b11);    // 8 bytes
    value(hp_wid, "[4]uint:6", 0);
    value(hp_wstrb, "[4][8]log", true);     // all write strobes high
    
    // HP inputs to PS for read
    static(hp_arvalid, "[4]log");
    value(hp_rready, "[4]log", false);
    value(hp_araddr, "[4]uint:32", 0);
    value(hp_arlen, "[4]uint:4", 0);
    //value(hp_arcache, "[4]uint:4", 0b0111); // write-back, read-allocate
    value(hp_arcache, "[4]uint:4", 0b0011); // normal, non-cacheable, bufferable
    value(hp_arburst, "[4]uint:2", 0b01);   // INCR mode
    value(hp_arid, "[4]uint:6", 0);
    value(hp_arlock, "[4]uint:2", 0);       // normal access
    value(hp_arprot, "[4]uint:3", 0);       // not interpretted
    value(hp_arqos, "[4]uint:4", 0);
    value(hp_arsize, "[4]uint:2", 0b11);    // 8 bytes
    value(hp_rdissuecap1en, "[4]log", false);


    for (int(bus) ; bus<4 ; bus++)
        when (!hp_aresetn[bus])
            reset(hp_arvalid[bus], hp_awvalid[bus]);

    for (int(bus) ; bus<4 ; bus++) {
        if (axi_hp_read_used[bus])
            m_axi_hp_read (
                hp_ripp[bus]->,
                hp_arvalid[bus],
                hp_rready[bus],
                hp_araddr[bus],
                hp_arlen[bus]
                <-
                hp_rapp[bus]->,
                hp_rlpp[bus]->,
                hp_arready[bus],
                hp_rlast[bus],
                hp_rvalid[bus],
                hp_rdata[bus],
                hp_rid[bus],
                hp_rresp[bus]

            );
        if (axi_hp_write_used[bus])
            m_axi_hp_write(
                hp_awvalid[bus],
                hp_wvalid[bus],
                hp_wdata[bus],
                hp_awaddr[bus],
                hp_awlen[bus],
                hp_wlast[bus]
                <-
                hp_wipp[bus]->,
                hp_wapp[bus]->,
                hp_wlpp[bus]->,
                hp_awready[bus],
                hp_wready[bus]
            );
    }
    
    //
    // read
    //
    module
    m_axi_hp_read (
        queue(ip, "bits:64"),       // output data
        static(arvalid, "log"),     // read address valid
        value(rready, "log"),       // read ready
        value(araddr, "uint:32"),   // read address
        value(arlen, "uint:4")      // read burst length
        <-
        queue(addr, "uint:32"),     // address of 1st datum
        queue(len, "uint:4"),       // burst length
        value(arready, "log"),      // address read ready
        value(rlast, "log"),        // read last datum
        value(rvalid, "log"),       // read data valid
        value(rdata, "bits:64"),    // read data
        value(rid, "uint:6"),       // read ID
        value(rresp, "uint:2")      // read response
    ) {
        static(raddr, "uint:32");
        static(rlen, "uint:4");
        static(reading, "log");
        araddr := raddr;
        arlen := rlen;
        rready := reading && !arvalid && >ip;
        
        when (>ip && <addr && <len && !reading) par {
            arvalid <- true;
            reading <- true;
            raddr <- addr;
            rlen <- len;
        }
        when (arvalid && arready)
            arvalid <- false;
        when (rvalid && rready) sync {
            ip <<- rdata;
            reading <- !rlast;
        }
    }

    //
    // write
    //
    module
    m_axi_hp_write(
        static(awvalid, "log"),     // write address valid
        value(wvalid, "log"),       // write data valid
        value(wdata, "bits:64"),    // write data
        value(awaddr, "uint:32"),   // write address
        value(awlen, "uint:4"),     // write burst length
        value(wlast, "log")         // write last datum
        <-
        queue(ip, "bits:64"),       // input data
        queue(addr, "uint:32"),     // address of 1st datum
        queue(len, "uint:4"),       // burst length
        value(awready, "log"),      // address write slave ready
        value(wready, "log")        // data write slave ready
    ) {
        static(waddr, "uint:32");
        static({wlen, count}, "uint:4");
        static(writing, "log");
        wdata := ?ip;
        awaddr := waddr;
        awlen := wlen;
        wvalid := writing && <ip;
        wlast := wvalid && (count == 0);

        when (<ip && <addr && <len && !writing) par {
            awvalid <- true;
            writing <- true;
            waddr <- addr;
            wlen <- len;
            count <- len;
        }
        when (awvalid && awready)
            awvalid <- false;

        when (writing && wready && <ip) sync {
            count--;
            null <<- ip;
            writing <- !wlast;
        }
    }

