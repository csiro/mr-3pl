// Include file for Xilinx Unified Library (XUL) elements
nomodule

global function
xul_and (varargs) {
    return(xul_gate("xul_xand", "AND", 2, 5, inargs));
}

global function
xul_or (varargs) {
    return(xul_gate("xul_or", "OR", 2, 5, inargs));
}

global function
xul_xor (varargs) {
    return(xul_gate("xul_xor", "XOR", 2, 5, inargs));
}

global function
xul_nand (varargs) {
    return(xul_gate("xul_xnand", "NAND", 2, 5, inargs));
}

global function
xul_nor (varargs) {
    return(xul_gate("xul_nor", "NOR", 2, 5, inargs));
}

global function
xul_xnor (varargs) {
    return(xul_gate("xul_xnor", "XNOR", 2, 5, inargs));
}

global function
xul_inv (value(I, "log"), var(CONSTR, "[]str")) {
    if (!matched(I)) nullerr("xul_inv", "I");
    value(out, "log");
    element("INV");
    elementconnect("I", 0, I);
    elementconnect("O", 1, out);
    xul_constraints("inv", CONSTR);
    return(out);
}


