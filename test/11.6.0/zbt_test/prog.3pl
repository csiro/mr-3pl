module "boards/avnet/microzed_7020.3pl"

module "/Users/dun202/lib/3PL/zbt_ram.3pl"

var(zbt_addr_pins, "[19]str",
    {
    "N17", "P18", "B19", "A20", "E17", "D18", "D19", "D20", "E18",
    "E19", "F16", "F17", "L19", "L20", "M19", "M20", "M17", "M18",
    "K19"
    }
);
var(zbt_data_pins, "[36]str",
    {
    "L16", "L17", "K17", "K18", "H16", "H17", "J18", "H18", "G17",
    "G18", "F19", "F20", "G19", "G20", "J20", "H20", "K14", "J14",
    "H15", "G15", "N15", "N16", "L14", "L15", "M14", "M15", "T12",
    "U12", "U13", "V13", "V12", "W13", "T14", "T15", "P14", "R14"
    }
);
str(_we_pin, "T20");
str(_wea_pin, "C21");
str(_web_pin, "F22");
str(_wec_pin, "F21");
str(_wed_pin, "F24");
str(_clke_pin, "D99");

class(cpu, cpu_api());
class(zbt);
queue({qi, qo}, "bits:12", domain=null);
queue({qar, qaw}, "uint:19", domain=null);

zbt =   zbt_ram(
            zbt_addr_pins,
            zbt_data_pins,
            _we_pin,
            _wea_pin,
            _web_pin,
            _wec_pin,
            _wed_pin,
            _clke_pin,
            currentclock()
        );

zbt.read(qo <- qar);

zbt.write(qaw, qi);

cpu.write_queue(qar <- "QAR");
cpu.write_queue(qaw <- "QAW");
cpu.write_queue(qi <- "QI");
cpu.read_queue(q0, "QO");

