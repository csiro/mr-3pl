// Delay for a fixed number of clock cycles.
//  in - the input - may be any type but must not contain queue reads.
//  del - the number of cycles to delay, default 1
//  step - optional advance when true - if omitted, on every clock cycle.
//  ram - force RAM usage despite small delay value
// If the delay is small enough CLB shift registers will be used, otherwise
// block RAM (rmemory) will be used. In the latter case del maximum is
// determined by maximum block RAM depth for the FPGA family.
global function
delay (
    value(in),
    int(del, 1),
    value(step, "log", true),
    log(ram)
) {
    int(srlmaxdel, 1 << directive("srlAddrWidth")); // 16 or 32
    
    if (hasqueuereads(in))
        texit("delay() - input contains queue reads");    
    
    if (matched(step) && istargconst(step) && !targconsttoimmed(step))
        step := used();
    
    if (!ram && del <= srlmaxdel) {
        value(out, type(in));
        del(out <- in, del,, step);
        return(out);
    }

    int(awidth, size(del));
    type(atype, "uint:"+awidth);
    type(dtype, type(in));
    static(raddr, atype);
    static(waddr, atype, del);
    rmemory(m, 2, atype, dtype);

    [
        when (step) par {
            rmemorywrite(m, 0, waddr, in);
            rmemoryread(m, 1, raddr);
            waddr++;
            raddr++;
        }
    ]
    return(rmemoryout(m, 1));
}

// Copy data from an array into a queue.
// 'in' is an input array of any type.
// ' enable' is an optional array of "log" the same dimension as 'in' - it allows
//      the number of array elements shifted to the output queue to be controlled.
// 'go' is a boolean value which executes the copy when true - it should be true
//      for only one clock cycle otherwise another copy may be initiated.
// 'pout' is the output queue
// 'busy' is true if the copy has not yet completed.
// Another copy request via 'go' will be ignored if 'busy' is true.
// If 'go' remains true after 'busy' becomes false another copy will be
// initiated.
// The parallel input data will be shifted down into the output queue, lowest
// subscript first, until data whose 'enable' input was false reaches the queue at
// which time shifting stops. Any data remaining will be overwritten on the next
// 'go'. If 'enable' is not given an argument, all data will be shifted into the
// output queue.
global module
array_to_queue (queue(pout), value(busy, "log") <- value(in), value(enable), value(go, "log")) {
    if (dimensions(in) == 0)
        texit("array_to_queue() - input is not an array");
    int(dim_in, dimension(in));
    if (matched(enable)) {
        int(dim_enable, dimension(enable));
        if (dim_in == 0)
            texit("array_to_queue() - enable is not an array");
        if (dim_in != dim_enable)
            texit("array_to_queue() - input and enable arrays are different size");
        if (typestring(enable[0]) != "log")
            texit("array_to_queue() - enable array is not type \"log\"");
    }
    type(dtype, type(in[0]));
    static(cdata, "["+dim_in+"]dtype");
    static(cbusy, "["+dim_in+"]log");
    for (int(i) ; i<dim_in ; i++)
        chain_link(cdata, cbusy <- in[i], nullarg(enable[i]), go, i);
    chain_output(pout <- cdata, cbusy, dim_in);
    busy := cbusy[0]; // NOT USED *********************

    procedure
    chain_link (
        static(cdata),
        static(cbusy, "[]log")
        <-
        value(in),
        value({enable, go}, "log"),
        int(ch)
    ) {
        when (go && !cbusy[0]) par {// MOVE THIS TEST EXPR OUT TO SINGLE OCCURRENCE
            cdata[ch] <- in;
            if (matched(enable))
                cbusy[ch] <- enable;
            else
                cbusy[ch] <- true;
        }
    }

    module
    chain_output (queue(pout) <- static(cdata), static(cbusy, "[]log"), int(dim)) {
        when (cbusy[0]) sync {
            pout <<- cdata[0];
            for (int(i, 1) ; i<dim ; i++) {
                cdata[i-1] <- cdata[i];
                cbusy[i-1] <- cbusy[i];
            }
            cbusy[dim-1] <- false;
        }  
    }
}

// Wait while the logical input argument 'v' is true
global procedure
wait_while (value(v, "log")) {
    seq while (v) {}
}

// Wait until the logical input argument 'v' is true
global procedure
wait_until (value(v, "log")) {
    seq while (!v) {}
}

// Wait for a number of clock cycles (integer argument) or
// a number of second (floating point argument).
global procedure
wait (varargs) {
    switch (mode(inargs[0]->)) {
    case "immediate":
        // immediate
        int(n);
        switch (primtypestring(inargs[0]->)) {
        case {"uint", "int"}:
            // uint or int - wait t cycles
            n = inargs[0]->;
        case "float":
            // float - wait t second
            if (period(currentclock()) == 0.0)
                texit("wait() - current clock has period 0");
            n = floor(inargs[0]-> / period(currentclock()));
        default:
            texit("wait() - argument type not int or float");
        }
        switch (n) {
        case 0:
        case 1:
            nop();
        case 2:
            nop(2);
        default:
            static(count, "int:"+(size(n-1)+1), n-3);
            seq {
                reset(count);
                seq while (count >= 0) {
                    count--;
                }
            }
        }
        return;
    case {"value", "static"}:
        // value or static
        if (primtypestring(inargs[0]->) != "uint")
            texit("wait() - target argument type not uint");
        // uint or int - wait t cycles
        static(count, type(inargs[0]->));
        when (inargs[0]-> != 0 && inargs[0]-> != 1)
            seq {
                count <- inargs[0]->;
                seq while (count != 2) {
                    count--;
                }
            }
        return;
    default:
        texit("wait() - argument not immediate, value or static mode");
    }
}

// Generate a pulse on 'out' when the input argument 'in' changes from
// false to true.
global module
to_pulse (static(out, "log") <- value(in, "log")) {
    static(prev, "log", true); // true avoids pulse if 'in' initially high
    prev <- in;
    out <- in && !prev;
}

// Generate a pulse when the input argument 'in' changes from
// false to true.
global function
to_pulse (value(in, "log")) {
    static(prev, "log", true); // true avoids pulse if 'in' initially high
    [prev <- in;]
    return(in && !prev);
}

// When input argument 'in' goes from false to true generate an output 'out'
// which is true for the number of cycles specified by argument 'n'.
global module
stretch (static(out, "log") <- value(in, "log"), int(n)) {
    when (in) seq {
        out <- true;
        nop(n-1);
        out <- false;
        wait_while(in);
    }
}

global module
tws_recv(
    queue(out)
    <-
    value(sck, "log"), value(sdo, "log"), varargs
) {
    int(bits, size(out));               // word length
    float(cp, period(currentclock()));  // current clock period
    int(scycles);                       // clock cycles for 'silence'
    var(p, "->");                       // pointer to 'settle' argument
    // Check if 'silence' argument is provided. If so check type.
    // Set 'scycles'. Magnitude is not checked!
    if (dimension(inargs) >= 1 && inargs[0] != null) {
        switch (typestring(inargs[0]->)) {
        case "float":
            scycles = floor(inargs[0]-> / cp);
        case {"int","uint"}:
            scycles = inargs[0]->;
        default:
            texit("tws_recv() - 'silence' argument not \"float\", \"int\" or \"uint\"");
        }
    }
    // Check if 'settle' argument is provided. If so check type.
    // Set 'dgcycles'. Magnitude is not checked!
    if (dimension(inargs) == 2 && inargs[1] != null) {
        switch (typestring(inargs[1]->)) {
        case {"float", "int","uint"}:
            p = inargs[1];
        default:
            texit("tws_recv() - 'settle' argument not \"float\", \"int\" or \"uint\"");
        }
    }
    if (dimension(inargs) > 2)
        texit("tws_recv() - too many arguments");
    
    value(dgsck,, sck); // undeglitched sck by default
    value(dgsdo,, sdo); // undeglitched sdo by default
    if (p != null) {
        dgsck := deglitch(sck, p->); // deglitched sck
        dgsdo := deglitch(sdo, p->); // deglitched sdo
    }
    var(srinit, "["+bits+"]log");   // array to initialise shift register 'sr'
    srinit[bits-1] = true; // highest 'sr' member true - moves finally into 'fin'
    static(sr, "["+bits+"]log", srinit); // shift register
    static(fin, "log");                 // true when last bit has been received
    static(ccheck, "log");
    when (to_pulse(dgsck)) par {
        int(n, bits-1); // loop terminator
        // Input bits move into MSB of 'sr' and the array shifts down.
        // LS member shifts into 'fin' to indicate the whole word has been
        // received. Thus LSB is received first.
        fin <- sr[0];           // off LSB end to 'fin'
        for (int(i) ; i<n ; i++)
            sr[i] <- sr[i+1];   // shift down each bit
        sr[bits-1] <- dgsdo;    // input to MSB
    }
    
    // When 'fin', clear it and 'ccheck' and wait the specified 'silence' time.
    // If after the wait 'ccheck' is true, a +ve clock edge has occurred.
    // Write to output if 'ccheck' false. Reset the shift register 'sr' and
    // 'fin'. The reset will set the MSB of 'sr' true ready for the next word.
    when (fin) seq {
        par {
            reset(fin, ccheck);
            if (scycles != 0)
                wait(scycles);
        }
        sync {
            when (!ccheck)
                out <<- cast(sr, type(out));
            reset(sr, fin);
        }
    }
    
    // Make ccheck true on any +ve clock edge.
    when (to_pulse(dgsck))
        ccheck <- true;
}

global module
tws_send(
    static(sck, "log"), static(sdo, "log")
    <-
    queue(in), varargs
) {
    int(bits, size(in));               // word length
    float(cp, period(currentclock()));
    int({tbcycles, scycles});
    value(tb, "log", true);
    if (dimension(inargs) < 2)
        texit("tws_send() - too few arguments");
    if (dimension(inargs) > 2)
        texit("tws_send() - too many arguments");
    if (inargs[0] == null)
        texit("tws_send() - timebase argument null");
    if (inargs[1] == null)
        texit("tws_send() - 'silence' argument null");

    switch (mode(inargs[0])) {
    case "immediate":
        switch (typestring(inargs[0])) {
        case "float":
            tbcycles = floor(inargs[1] / cp);
        case {"int","uint"}:
            tbcycles = inargs[1];
        default:
            texit("tws_send() - timebase immediate argument not \"float\", \"int\" or \"uint\"");
        }
        [
            value(p, "log");
            par {
                assert(p <-);
                wait(tbcycles);
            }
        ]
        tb := p;
    case {"value", "static"}:
        if (typestring(inargs[0]) != "log")
            texit("tws_send() - timebase argument not type log");
        tb := inargs[0];
    default:
        texit("tws_send() - timebase argument not value or static mode");
    }
    
    switch (typestring(inargs[1])) {
    case "float":
        scycles = floor(inargs[1]) / cp;
    case {"int","uint"}:
        scycles = inargs[1];
    default:
        texit("tws_send() - 'silence' argument not \"float\", \"int\" or \"uint\"");
    }
        
        
    int(count_init, bits - 1);
    static(count, "int:"+(size(count_init)+1), count_init);
    static(data, "bits:"+bits);
    static({ready, sending, silence}, "log");
    value(inav,, <in);

    when (!sending && !ready && inav) par {
        data <- in;
        ready <- true;
    }
    when ((!sending && !ready && inav || ready) && !silence) par {
        sending <- true;
        reset(count);
    }
        
    when (tb && sending && sck) par {
        sdo <- getbit(data, 0);
        data <- data >> 1;
        count--;
    }
    when (tb && sending)
        sck <- !sck;
    when (count < 0) par {
        reset(ready, sending, count, scount);
        silence <- true;
    }
    value(sclt,, scount < 0);
    when (silence && !sclt && tb)
        scount--;
    when (silence && sclt && tb)
        silence <- false;
}

// Function to deglitch a signal. The second argument determines the
// settling time and may be immediate or static mode.
// If an immediate integer it gives the number of clock cycles to
// wait a changed input before assigning the output.
// If an immediate float it provides the settling time in second.
// If a static variable it must be type "int:" or "uint:" and determines
// the number of clock cycles to settle.
// If the 2nd argument is missing or is immediate and <= 1, the returned
// value is simply the input value.
global function
deglitch (value(in), var(time)) {
    static({prev, out}, type(in));
    value(change, "log", prev != in);
    value(terminate, "log");
    var(p, "->");
    
    [
        prev <- in;
    ]
    //println("$$$");
    // Check if 'time' argument is provided. If so check type.
    // Set 'dgcycles'. Magnitude is not checked!
    if (matched(time)) {
        switch (mode(time)) {
        case "immediate":
            int(dcycles);                       // clock cycles for 'settle'            
            p = &dcycles;
            switch (typestring(time)) {
            case "float":
                float(cp, period(currentclock()));  // current clock period
                dcycles = ceil(time / cp);
                //println("time " + time + " cp " + cp + " dcycles " + dcycles);
            case {"int","uint"}:
                dcycles = time;
            default:
                texit("deglitch() - 2nd argument not \"float\", \"int\" or \"uint\"");
            }
            if (dcycles == 0)
                return(prev);
            dcycles -= 2;  // to allow much simpler counter test of <0 rather than ==0
            int(cbits, size(dcycles) + 1);  // 1 extra bit so can be signed
            static(local.count, "int:"+cbits, dcycles);
            terminate := count < 0;
        case {"static", "value"}:
            str(it, typestring(time));
            if (!(startswith(it, "int") || startswith(it, "uint")))
                texit("deglitch() - 2nd argument not \"int:\" or \"uint:\"");
            static(local.count, type(time));
            terminate := count == 0;
            p = &time;
        }
    } else
        return(in);

    [
        when (change)
            count <- p->;
        when (!change && terminate)
            out <- prev;
        when (!change && !terminate)
            count--;
    ]
       
    return(out);
}

// Generalised assignment.
global procedure
assign (var(out) <- var(in)) {
    if (!matched(in))
        texit("assign() - must have one input argument");
    if (!matched(out))
        texit("assign() - must have one output argument");
    switch (mode(out)) {
    case "immediate":
        out = in;
    case {"value", "priority", "clock"}:
        out := in;
    case "static":
        out <- in;
    case "queue":
        out <<- in;
    case "selectvalue":
        out |- in;
    default:
        texit("assign() - output mode " + mode(out) + " not allowed");
    }
}

// Reverse the bit order of the argument.
//
global function
reverse (value(in)) {
    int(size, width(in));
    value({i, o}, "["+size+"]bits:1");
    i := cast(in, type(i));
    for (int(j) ; j<size ; j++)
        o[j] := i[size-j-1];
    return(cast(o, type(in)));
}

