\@ifundefined{chapter}{}{
\renewcommand\chapter{\ifodd\c@page\clearpage\else\cleardoublepage\fi
\global\@topnum\z@
\@afterindentfalse
\secdef\@chapter\@schapter
}
\def\@makechapterhead#1{
\vspace*{120\p@}
{\sffamily\bfseries\LARGE\@chapapp\ \ifthenelse{\equal{\@chapapp}{Appendix}}{\Alph{chapter}}{\arabic{chapter}} - #1\par
\nobreak
\vskip 36\p@
}}
}

