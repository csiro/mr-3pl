// 3pl standard library
nosource

// High speed serial control character codes
int(global.K28_0, 0b00011100);
int(global.K28_1, 0b00111100);  // comma
int(global.K28_2, 0b01011100);
int(global.K28_3, 0b01111100);
int(global.K28_4, 0b10011100);
int(global.K28_5, 0b10111100);  // comma
int(global.K28_6, 0b11011100);
int(global.K28_7, 0b11111100);  // comma
int(global.K23_7, 0b11110111);
int(global.K27_7, 0b11111011);
int(global.K29_7, 0b11111101);
int(global.K30_7, 0b11111110);

/*
Special Code    Bits     Current RD ­ Current RD +
   Name      HGF EDCBA   abcdei fghj  abcdei fghj

   K28.0     000 11100   001111 0100  110000 1011
   K28.1     001 11100   001111 1001  110000 0110
   K28.2     010 11100   001111 0101  110000 1010
   K28.3     011 11100   001111 0011  110000 1100
   K28.4     100 11100   001111 0010  110000 1101
   K28.5     101 11100   001111 1010  110000 0101
   K28.6     110 11100   001111 0110  110000 1001
   K28.7     111 11100   001111 1000  110000 0111
   K23.7     111 10111   111010 1000  000101 0111
   K27.7     111 11011   110110 1000  001001 0111
   K29.7     111 11101   101110 1000  010001 0111
   K30.7     111 11110   011110 1000  100001 0111
*/


// Asynchronous queue status
struct(global.apstat,
    etoq,   "log",
    otoh,   "log",
    qtot,   "log",
    htof,   "log",
    ttof,   "log"
);


global module
cwrite (rmemory(m), int(port), queue(addr), queue(data)) {
    cmemorywrite(m, port, addr, data);
}

global module
cread (queue(data) <- rmemory(m), int(port), queue(addr)) {
    data <<- cast(cmemoryread(m, port, addr), type(data));
}

global module
rwrite (rmemory(m), int(port), value(addr), value(data)) {
    rmemorywrite(m, port, addr, data);
}

global module
rread (queue(data) <- rmemory(m), int(port), value(addr)) {
    static(hold, "log");
    when (!hold || >data)
        rmemoryread(m, port, addr);
    when (hold)
        data <<- cast(rmemoryout(m, port), type(data));
    hold <- <addr || hold && !>data;
}

global module
fifo (
    value(out),
    value({emptyout, fullout}, "log")
    <-
    value(in),
    value({read, write}, "log"),
    int(depth)
) {
    int(dwidth, size(in));
    int(awidth, size(depth-1));
    int(cwidth, size(depth));
    static({waddr, raddr}, "uint:"+awidth);
    static(count, "uint:"+cwidth);
    static(empty, "log", true);
    static(full, "log");
    cmemory(mem, 2, type(in), "uint:"+awidth);
    
    fullout := full;
    emptyout := empty;
    when (write) par {
        cmemorywrite(mem, 0, waddr, in);
        waddr++;
    }
    when(read)
        raddr++;
    when (read ^^ write)
        count <- incrdecr(count, write);
    when (read && !write && (count == depth))
        full <- false;
    when (read && !write && (count == 1))
        empty <- true;
    when (!read && write && (count == (depth - 1)))
        full <- true;
    when (!read && write && (count == 0))
        empty <- false;
    out := cast(cmemoryread(mem, 1, raddr), type(out));
}

global module
pfifo (
    value(out),
    value({emptyout, fullout}, "log")
    <-
    value(in),
    value({read, prewrite, write}, "log"),
    int(depth),
    value(reset, "log", false)
) {
    int(dwidth, size(in));
    int(awidth, size(depth-1));
    int(cwidth, size(depth));
    static({waddr, raddr}, "uint:"+awidth);
    static({wcount, rcount}, "uint:"+cwidth);
    static(empty, "log", true);
    static(full, "log");
    cmemory(mem, 2, "uint:"+awidth, type(in));
    
    fullout := full;
    emptyout := empty;
    when (write) {
        par {
            cmemorywrite(mem, 0, waddr, in);
            waddr++;
        }
    } unless (reset) {}
    when(read)
        raddr++;
    rcount <- addsub(rcount, 1, write, read ^^ write);
    wcount <- addsub(wcount, 1, prewrite, read ^^ prewrite);
    when (read && !prewrite && (wcount == depth))
        full <- false;
    when (read && !write && (rcount == 1))
        empty <- true;
    when (!read && prewrite && (wcount == (depth-1)))
        full <- true;
    when (!read && write && (rcount == 0))
        empty <- false;
    out := cast(cmemoryread(mem, 1, raddr), type(out));
    
    if (matched(reset))
        when (reset)
            reset(raddr, waddr, rcount, wcount, empty, full);
}

