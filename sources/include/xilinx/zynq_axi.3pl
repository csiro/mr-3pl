            SAXIHP2ARADDR=hp_araddr[2],
            SAXIHP2ARBURST=hp_arburst[2],
            SAXIHP2ARCACHE=hp_arcache[2],
            SAXIHP2ARID=hp_arid[2],
            SAXIHP2ARLEN=hp_arlen[2],
            SAXIHP2ARLOCK=hp_arlock[2],
            SAXIHP2ARPROT=hp_arprot[2],
            SAXIHP2ARQOS=hp_arqos[2],
            SAXIHP2ARSIZE=hp_arsize[2],
            SAXIHP2AWADDR=hp_awaddr[2],
            SAXIHP2AWBURST=hp_awburst[2],
            SAXIHP2AWCACHE=hp_awcache[2],
            SAXIHP2AWID=hp_awid[2],
            SAXIHP2AWLEN=hp_awlen[2],
            SAXIHP2AWLOCK=hp_awlock[2],
            SAXIHP2AWPROT=hp_awprot[2],
            SAXIHP2AWQOS=hp_awqos[2],
            SAXIHP2AWSIZE=hp_awsize[2],
            SAXIHP2WDATA=hp_wdata[2],
            SAXIHP2WID=hp_wid[2],
            SAXIHP2WSTRB=hp_wstrb[2],
            
            // HP3 PL master
            SAXIHP3ACLK=hp_aclk,
            SAXIHP3ARVALID=hp_arvalid[3],
            SAXIHP3AWVALID=hp_awvalid[3],
            SAXIHP3BREADY=hp_bready[3],
            SAXIHP3RDISSUECAP1EN=hp_rdissuecap1en[3],
            SAXIHP3RREADY=hp_rready[3],
            SAXIHP3WLAST=hp_wlast[3],
            SAXIHP3WRISSUECAP1EN=hp_wrissuecap1en[3],
            SAXIHP3WVALID=hp_wvalid[3],
            SAXIHP3ARADDR=hp_araddr[3],
            SAXIHP3ARBURST=hp_arburst[3],
            SAXIHP3ARCACHE=hp_arcache[3],
            SAXIHP3ARID=hp_arid[3],
            SAXIHP3ARLEN=hp_arlen[3],
            SAXIHP3ARLOCK=hp_arlock[3],
            SAXIHP3ARPROT=hp_arprot[3],
            SAXIHP3ARQOS=hp_arqos[3],
            SAXIHP3ARSIZE=hp_arsize[3],
            SAXIHP3AWADDR=hp_awaddr[3],
            SAXIHP3AWBURST=hp_awburst[3],
            SAXIHP3AWCACHE=hp_awcache[3],
            SAXIHP3AWID=hp_awid[3],
            SAXIHP3AWLEN=hp_awlen[3],
            SAXIHP3AWLOCK=hp_awlock[3],
            SAXIHP3AWPROT=hp_awprot[3],
            SAXIHP3AWQOS=hp_awqos[3],
            SAXIHP3AWSIZE=hp_awsize[3],
            SAXIHP3WDATA=hp_wdata[3],
            SAXIHP3WID=hp_wid[3],
            SAXIHP3WSTRB=hp_wstrb[3],
            
            DDRARB, DMA0DRTYPE, DMA1DRTYPE, DMA2DRTYPE, DMA3DRTYPE,
            EMIOENET0GMIIRXD, EMIOENET1GMIIRXD, EMIOGPIOI, EMIOSDIO0DATAI,
            EMIOSDIO1DATAI, EMIOTTC0CLKI, EMIOTTC1CLKI, FCLKCLKTRIGN,
            FTMDTRACEINATID, FTMDTRACEINDATA, FTMTF2PDEBUG, FTMTF2PTRIG,
            FTMTP2FTRIGACK,
            IRQF2P=irqf2p
    );    

}

// DMA from RAM to PL using an AXI_HP bus.
// A datum on each of queues 'address' and 'burstlen' will trigger
// the DMA transfer if queue 'data' is not full.
// The transfer will consume one datum from each of 'address' and 'burstlen'
// and will write the number of data to queue 'data' necessary to satisfy the
// burst length. Burst length is a maximum of 16 words but note that
// 'burstlen' is the burst length minus 1, i.e. 0 for 1 word to 15 for 16 words.
module
dma_read (
    queue(data, "bits:64")
    <-
    queue(address, "uint:32"),  // memory address
    queue(burstlen, "uint:4"),  // burst length - 1
    int(bus)                    // HP bus 0 to 3
) {
    useclock(bus_clk);
    
    if (axi_hp_read_used[bus])
        texit("dma_read() - multiple interfaces to an HP bus not implemented");
    hp_rapp[bus]-> <<- address;
    hp_rlpp[bus]-> <<- burstlen;
    data <<- hp_ripp[bus]->;
    axi_hp_read_used[bus] = true;
    
    useclock();
}

// DMA from PL to RAM using an AXI_HP bus.
// A datum on each of queues 'address' and 'burstlen' will trigger
// the DMA transfer if queue 'data' is not empty.
// The transfer will consume one datum from each of 'address' and 'burstlen'
// and will read the number of data from queue 'data' necessary to satisfy the
// burst length. Burst length is a maximum of 16 words but note that
// 'burstlen' is the burst length minus 1, i.e. 0 for 1 word to 15 for 16 words.
module
dma_write (
    queue(data, "bits:64"),
    queue(address, "uint:32"),  // memory address
    queue(burstlen, "uint:4"),  // burst length - 1
    int(bus)                    // HP bus 0 to 3
) {
    useclock(bus_clk);
    
    if (axi_hp_write_used[bus])
        texit("dma_write() - multiple interfaces to an HP bus not implemented");
    hp_wipp[bus]-> <<- data;
    hp_wapp[bus]-> <<- address;
    hp_wlpp[bus]-> <<- burstlen;
    axi_hp_write_used[bus] = true;
    
    useclock();
}

// Handle a GP bus read burst.
//
// Note that this is a procedure so that the instantiations are not
// separate queue sinks. The addressing mechanism enforces mutually
// exclusive reading of the read address queues, i.e.
// only one instance of this procedure will read a queue though all
// examine the read address queue. This saves the logic normally necessary
// to ensure that reads from separate modules are all completed before
// queue output becomes available with the next datum. That logic can become
// a problem with meeting time constraints if there are a large number of
// readers. Ensuring that all readers are in a single module, as is the case
// here, avoids the problem as long as the readers look after their own
// exclusive access.
procedure
cpu_read (
    value(access, "log"),
    value(init, "log"),
    queue(out)
    <-
    int(bus),
    int(addr),
    value(data_in),
    value(contin, "log")
) {
    type(atype, "uint:"+(gp_raddr_width[bus]-gp_ext_raddr_width[bus]));
    int(ashift, gp_ext_raddr_width[bus]); // 0 for GP0
    value(addr_match, "log", cast(?gp_rda_p[bus]->.addr>>ashift, atype) == addr);
    value(valid, "log");
    int(data_width, size(data_in));
    static(data, "bits:"+data_width);
    static(len, "int:5");
    value(rav, "log", <data_in); // always true for static mode
    static(empty, "log");
    
    read_address_match[bus] := read_address_match[bus] || addr_match;
    
    when (<gp_rda_p[bus]-> && addr_match) seq {
        if (matched(contin)) {
            assert(init <-);
            wait_until(contin);
        }
        par {
            when (rav)
                data <- cast(data_in, type(data));
            empty <- !rav;
            len <- ?gp_rda_p[bus]->.len;
            // 1st word to queue is packed ID, burst length and error code (0)
            gp_rdd_p[bus]-> <<- ?gp_rda_p[bus]->.id | (?gp_rda_p[bus]->.len << 12);
            assert(access <-);
            if (matched(out))
                when (>out)
                    out <<- data_in;
        }
        sync while (len >= 0) {
            // remaining words are data
            gp_rdd_p[bus]-> <<- empty ? 0xffffffff : cast(data, "bits:32");
            len--;
            if (data_width > 32)
                data <- data >> 32;
        }
        null <<- gp_rda_p[bus]->; // pop address queue after last word
    }
}

// Detect when a read request has been written to the read request queue for
// the bus but no address match has been made, i.e. the read address is not
// valid.
// Execute a zero read to satisfy the bus.
procedure
cpu_read_default (int(bus)) {
    static(len, "int:5");
    int(ERR, 0);    // should be 3, but hangs CPU!
    
    useclock(bus_clk);
    
    when (<gp_rda_p[bus]-> && !read_address_match[bus]) seq {
        par {
            len <- ?gp_rda_p[bus]->.len;
            // 1st word to queue is packed ID, burst length and error code (1)
            gp_rdd_p[bus]-> <<- ?gp_rda_p[bus]->.id | (?gp_rda_p[bus]->.len << 12) | (ERR << 16);
       }
        sync while (len >= 0) {
            gp_rdd_p[bus]-> <<- cast(0, "bits:32");
            len--;
        }
        null <<- gp_rda_p[bus]->; // pop address queue after last word
    }
    
    useclock();
}

// Handle a GP bus write burst.

// THIS HAS BEEN COMMENTED OUT AS AN STM TO THE MEMORY-MAPPED ADDRESS
// DOES NOT PERFORM A BURST WRITE BUT INSTEAD DOES A NUMBER OF
// SEQUENTIAL SINGLE WORD WRITES. The un-commented version following
// handles these single word writes.
//
// Note that this is a procedure so that the instantiations are not
// separate queue sinks. The addressing mechanism enforces mutually
// exclusive reading of the write address and write data queues, i.e.
// only one instance of this procedure will read the queues though all
// examine the write address queue. This saves the logic normally necessary
// to ensure that reads from separate modules are all completed before
// queue output becomes available with the next datum. That logic can become
// a problem with meeting time constraints if there are a large number of
// readers. Ensuring that all readers are in a single module, as is the case
// here, avoids the problem as long as the readers look after there own
// exclusive access.
/*
