    value({i, o}, bitstype);
    i := cast(in, bitstype);
    for(int(j) ; j<width(in) ; j++)
        o[j] := cast(i[j] & gate, "bits:1");
    return(cast(o, type(in)));
}
*/

// Batcher parallel network sort.
// The input and output queues are one-dimensional arrays of "uint" or "int".
// The input and output queues must have identical types.
global module
sort (queue(out) <- queue(in)) {
    if (dimension(in) != dimension(out))
        texit("sort() - input and output dimensions differ");
    if (type(int) != type(out))
        texit("sort() - input and output types differ");
    if (dimensions(in) != 1)
        texit("sort() - queues have more than 1 dimension");
    if (!primtypestring(in[0]) != "uint:" &&
        !primtypestring(in[0]) != "int:")
        texit("sort() - queue array type is not uint or int");
    int(inputs, dimension(in));
    int(stages, get_stages(inputs));
    int(sbits);     // bits to hold 'size'
    int(size2);     // power of 2 containing window size
    int(i);
    int({p, q, r}); // Batcher parameters
    int(d); // Batcher parameter - distance between exchange pairs
    int(wi);        // window member index
    int(si);        // network stage index
    var(ignore, "["+inputs+"]log"); // flags for skipping 2nd of exchange pair
    var(net, "["+(stages+1)+"]->");
    net[0] = &in;
    queuearray(net[1..stages-1] <- type(in));
    net[stages] = &out;

    for (i=inputs-1 ; i!=0 ; i=i>>1)
        sbits++;
    size2 = 1 << (sbits - 1);

    for (p=size2 ; p>0 ; p=p>>1) {
        r = 0;
        d = p;
        for (q=size2 ; q!=(p/2) ; q=q>>1) {
            [
                for (wi=0 ; wi<inputs ; wi++)
                    if (ignore[wi])        // already connected
                        ignore[wi] = false;
                    else if ((wi < (inputs-d)) && ((wi & p) == r)) {// exchange
                        cond_exchange ( net[si+1]->[wi], net[si+1]->[wi+d]
                                        <-
                                        net[si]->[wi], net[si]->[wi+d] );
                        ignore[wi+d] = true;// ignore later
                    } else                  // straight through
                        net[si+1]->[wi] <<- net[si]->[wi];
            ]
            d = q - p;
            r = p;
            si++;
        }
    }

    procedure
    cond_exchange (queue(o0), queue(o1) <- queue(i0),  queue(i1)) {
        value(gt01, "log");

        gt01 := i0 > i1;
        par {
            o0 <<- gt01 ? i1 : i0;
            o1 <<- gt01 ? i0 : i1;
        }
    }

    function
    get_stages (int(size)) {
        int({sbits, stages});

        for (int(i, size-1) ; i!=0 ; i=i>>1)
            sbits++;
        for (stages=0 ; sbits>0 ; sbits--)
            stages = stages + sbits;
        return(stages);
    }
}

// Print variables to standard output, an identifier, type and mode per line.
// Argument must be a call to listvars().
global procedure
printvars (var(lv, "[](scope, str, ident, str, var, ->)")) {
    for (int(i) ; i<dimension(lv) ; i++)
        println(lv[i].scope + "\t" + lv[i].ident + "\t" + mode(lv[i].var->) + "\t" + typestring(lv[i].var->));
}

// Print directives to standard output, a key and associated value per line.
global procedure
printdirs () {
    var(dirs, "map", directives());
    int(dn, entries(dirs));
    if (dn != 0) {
        for (int(i) ; i<dn ; i++) {
            str(key, get(dirs, i));
            var(val, "empty", get(dirs, key));
            println(key + "\t" + typestring(val) + "\t" + val);
        }
    }
}

// Print attributes to standard output, a key and associated value per line.
// Argument must be a call to listattributes().
global procedure
printattributes (var(lv, "[](key, str, mode, str, value, str)")) {
    for (int(i) ; i<dimension(lv) ; i++)
        println(lv[i].key + "\t" + lv[i].mode + "\t" + lv[i].value);
}

// Collect all directives and list their identifiers and values, one
// per line, in a single string assigned to directive "netlistcomment".
// This directive will be printed as a comment in the netlist file and the
// constraint files.
global procedure
netlistcommentfromdirs () {
    str(s, "\n");
    var(dirs, "map", directives());
    int(dn, entries(dirs));
    if (dn != 0) {
        for (int(i) ; i<dn ; i++) {
            str(key, get(dirs, i));
            s = s + "        " + key + " = " + get(dirs, key) + "\n";
        }
        s = s + "    ";
        setdirective("netlistComment", s);
    }
}

/******************************************************************
global function
svn_version () {
    str(os);
    int(status, -2);
    shell(os, status <- "svnversion");
    if (status != 0)
        texit("svn_version() - shell returned non-zero status");
    return(substring(os, 0, strlen(os)-1)); // get rid of newline
}
*/
