#----------------------------------------------------------------------
# Read the JSON structure from the .info file
# and expand it. Return a code module containing the interface
# functions.
#
def info_from_file (infofile):
    if not infofile.endswith('.info'):
        infofile = infofile + '.info'
    with open(infofile, 'r') as infile:
        infostring = infile.read()
    return(build_info(infostring))



