    }
    
    if ((areg != 0 || breg != 0 || creg != 0 || mreg != 0 || preg != 0) &&
        (hasqueuereads(a) || hasqueuereads(b) || hasqueuereads(c)))
        texit("dspsubmul() - cannot mix registers and queue inputs");
    log(use_pat, matched(pattern));
    str(use_pattern_detect, use_pat ? "PATDET" : "NO_PATDET");
    value({v1, v2, v3}, "empty");
    type({t1, t2});
    argadjust(v1, v2, t1 <- b, c, "*", false);
    value(v, t1);
    argadjust(, v3, t2 <- v, a, "-", true);
    value(result, "bits:48");
    p->(
        p=result,
