module "boards/avnet/aes_sp3a_eval400.3pl"

class(cpu, cpu_api());

struct (st1,
    ff1,    "uint:12",
    ff2,    "log"
);
struct(st2,
    f1, "uint:9",
    f2, "int:12",
    f3, "log",
    f4, st1,
    f5, "[3]uint:16"
);


static(s, st2, {511, 0, false, {123, true}, {0x8000, 4, 7}});

cpu.write(s <- "SW");
cpu.read(s, "SR");
