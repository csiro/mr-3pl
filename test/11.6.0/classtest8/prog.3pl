c1.ppp();
println("GGG " + g + " (123)");

class init (int(nn)) {
    common {
        int(mm, nn);
        println("init " + mm + " (89)");
    }
}

class s (int(i)) {
    common {
        int(z, i);
        int(global.g, 123);
        println("ZZZ COM " + z + " (7)");
        
    }

    int(j, 14);
    j = i;
    println("ZZZ " + z + " (7)");
    
    procedure ppp () {
        println("ZZZ ppp " + z + " (7)");
    }
    
    class v () {
        int(k, 77);
    }
    var(cv, "class", v());
    println("YYY V " + cv.k + " (77)");
    
    function f () {
        int(class.n, 33);
        return(i);
    }
}
