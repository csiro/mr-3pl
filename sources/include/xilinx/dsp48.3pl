// out := a - b * c
//  a   48 bits signed
//  b   25 bits signed
//  c   18 bits signed
//  out 48 bits signed
// unsigned arguments must be 1 bit smaller
global module
dspsubmul (
    value(out), value(pat, "log")
    <-
    value(a),
    value(b),
    value(c),
    int({areg, breg, creg, mreg, preg}),
    int(pattern),
    int(mask, 0xffffffffffff)
) {
    switch (directive("family")) {
    case "xc5v": var(local.p, "->", procptr(dsp48e)); 
