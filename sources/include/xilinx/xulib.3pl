global function
xul_ramb4_sn (
    value({CLK, EN, WE}, "log"),
    value(ADDR, "[]log"),
    value(DI, "[]log"),
    var(CONSTR, "[]str")
) {
    if (!matched(CLK)) nullerr("xul_ramb4_sn", "CLK");
    if (!matched(EN)) nullerr("xul_ramb4_sn", "EN");
    if (!matched(WE)) nullerr("xul_ramb4_sn", "WE");
    if (!matched(ADDR)) nullerr("xul_ramb4_sn", "ADDR");
    if (!matched(DI)) nullerr("xul_ramb4_sn", "DI");
    value(dout, "["+dwidth+"]log");
    int(awidth, width(ADDR));
    int(dwidth, width(D));
    element("RAMB4_S"+dwidth);
    elementconnect("CLK", 3, CLK);
    elementconnect("EN", 0, EN);
    elementconnect("WE", 0, WE);
    for (int(i) ; i<awidth ; i++)
        elementconnect("ADDR"+i, 0, ADDR[i]);
    for (int(i) ; i<dwidth ; i++)
        elementconnect("DI"+i, 0, DI[i]);
    for (int(i) ; i<dwidth ; i++)
        elementconnect("DO"+i, 1, dout[i]);
    xul_constraints("xul_ramb4_sn", CONSTR);
    return(dout);
}

global procedure
xul_ramb4_Sm_Sn (
    value({DOA< DOB}, "[]log")
    <-
    value({CLKA, ENA, WEA}, "log"),
    value(ADDRA, "[]log"),
    value(DIA, "[]log"),
    value({CLKB, ENB, WEB}, "log"),
    value(ADDRB, "[]log"),
    value(DIB, "[]log"),
    var(CONSTR, "[]str")
) {
    if (!matched(CLK)) nullerr("xul_ramb4_sm_sn", "CLK");
    if (!matched(EN)) nullerr("xul_ramb4_sm_sn", "EN");
    if (!matched(WE)) nullerr("xul_ramb4_sm_sn", "WE");
    if (!matched(ADDR)) nullerr("xul_ramb4_sm_sn", "ADDR");
    if (!matched(DI)) nullerr("xul_ramb4_sm_sn", "DI");
    int(awidtha, width(ADDRA));
    int(dwidtha, width(DA));
    int(awidthb, width(ADDRB));
    int(dwidthb, width(DB));
    element("RAMB4_S"+dwidtha+"_S"+dwidthb);
    elementconnect("CLKA", 3, CLKA);
    elementconnect("ENA", 0, ENA);
    elementconnect("WEA", 0, WEA);
    for (int(i) ; i<awidtha ; i++)
        elementconnect("ADDRA"+i, 0, ADDRA[i]);
    for (int(i) ; i<dwidtha ; i++)
        elementconnect("DIA"+i, 0, DIA[i]);
    for (int(i) ; i<dwidtha ; i++)
        elementconnect("DOA"+i, 1, DOA[i]);
    elementconnect("CLKB", 3, CLKB);
    elementconnect("ENB", 0, ENB);
    elementconnect("WEB", 0, WEB);
    for (int(i) ; i<awidthb ; i++)
        elementconnect("ADDRB"+i, 0, ADDRB[i]);
    for (int(i) ; i<dwidthb ; i++)
        elementconnect("DIB"+i, 0, DIB[i]);
    for (int(i) ; i<dwidthb ; i++)
        elementconnect("DOB"+i, 1, DOB[i]);
    xul_constraints("xul_ramb4_sm_sn", CONSTR);
}

global procedure
xul_ramb16_sn (
    value(DO, "[]log"),
    value(DOP, "[]log")
    <-
    value({CLK, EN, WE}, "log"),
    value(ADDR, "[]log"),
    value(DI, "[]log"),
    value(DIP, "[]log"),
    var(CONSTR, "[]str")
) {
    if (!matched(CLK)) nullerr("xul_ramb16_sn", "CLK");
