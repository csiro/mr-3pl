}

global procedure
xul_startup (value({GSR, GTS, CLK}, "log")) {
    if (!matched(GSR)) nullerr("xul_startup", "GSR");
    if (!matched(GTS)) nullerr("xul_startup", "GTS");
    if (!matched(CLK)) nullerr("xul_startup", "CLK");
    str(directive("family"));
    switch (family) {
    case "xcv":
        family_name = "VIRTEX";
    case "xc2vp":
        family_name = "VIRTEX2";
    case "xc2v":
        family_name = "VIRTEX2";
    case "xc2s":
        family_name = "SPARTAN2";
    case "xc3s":
        family_name = "SPARTAN3";
    }
    element("STARTUP_"+family_name);
    elementconnect("GSR", 0, GSR);
    elementconnect("GTS", 0, GTS);
    elementconnect("CLK", 3, CLK);
}

global procedure
xul_bscan (
    value({UPDATE, SHIFT, RESET, TDI, SEL1, DRCK1, SEL2, DRCK2, CAPTURE}, "log")
    <-
    value({TDO1, TDO2}, "log")
) {
    if (!matched(UPDATE)) nullerr("xul_bscan", "UPDATE");
    if (!matched(SHIFT)) nullerr("xul_bscan", "SHIFT");
    if (!matched(RESET)) nullerr("xul_bscan", "RESET");
    if (!matched(TDI)) nullerr("xul_bscan", "TDI");
    if (!matched(SEL1)) nullerr("xul_bscan", "SEL1");
    if (!matched(DRCK1)) nullerr("xul_bscan", "DRCK1");
    if (!matched(SEL2)) nullerr("xul_bscan", "SEL2");
    if (!matched(DRCK2)) nullerr("xul_bscan", "DRCK2");
    if ((directive("family") == "XC3S") || (directive("family") == "XC2V") || (directive("family") == "XC2VP"))
        if (!matched(CAPTURE)) nullerr("xul_bscan", "CAPTURE");
    str(family_name);
    switch (directive("family")) {
    case "xcv":
        family_name = "VIRTEX";
    case "xc2vp":
        family_name = "VIRTEX2";
    case "xc2v":
        family_name = "VIRTEX2";
    case "xc2s":
        family_name = "SPARTAN2";
    case "xc3s":
        family_name = "SPARTAN3";
    }
    element("BSCAN_"+family_name);
    elementconnect("TDO1", 0, SEL2);
    elementconnect("TDO2", 0, DRCK2);
    elementconnect("UPDATE", 1, UPDATE);
    elementconnect("SHIFT", 1, SHIFT);
    elementconnect("RESET", 1, RESET);
    elementconnect("TDI", 1, TDI);
    elementconnect("SEL1", 1, SEL1);
    elementconnect("DRCK1", 1, DRCK1);
    elementconnect("SEL2", 1, SEL2);
    elementconnect("DRCK2", 1, DRCK2);
    if ((family == "XC3S") || (family == "XC2V") || (family == "XC2VP"))
        elementconnect("CAPTURE", CAPTURE);
}

global procedure
xul_capture (value({CAP, CLK}, "log")) {
    if (!matched(CAP)) nullerr("xul_capture", "CAP");
    if (!matched(CLK)) nullerr("xul_capture", "CLK");
    str(family_name);
    switch (directive("family")) {
    case "xcv":
        family_name = "VIRTEX";
    case "xc2vp":
        family_name = "VIRTEX2";
    case "xc2v":
        family_name = "VIRTEX2";
    case "xc2s":
        family_name = "SPARTAN2";
    case "xc3s":
        family_name = "SPARTAN3";
    }
    element("CAPTURE_"+family_name);
    elementconnect("CAP", 0, CAP);
    elementconnect("CLK", 3, CLK);
}


/*
 * Not included -
 *
 *  GT_AURORA_n
 *  GT_CUSTOM
 *  GT_ETHERNET_n
 *  GT_FIBRE_CHAN_n
 *  GT_INFINIBAND_n
 *  GT_XAUI_n
 *
 *  FMAP
 *
 *  ICAP_VIRTEX2
 *
 *  PPC405
 *
 *  JTAGPPC
 */




function
xul_gate (str({name, NAME}), int({min, max}), var(in, "[]->")) {
    int(n, dimension(in));
    int(k, xul_ninputs(in, min, max, name));
    value(out, "log");
    element(NAME + (n != 1 ? k : ""));
    xul_connectinputs(in, k);
    elementconnect("O", 1, out);
    for (int(i, k) ; i<n ; i++) {
        if (in[i] == null)
            texit(name + " null constraint argument");
        if (typestring(in[i]->) != "str")
            texit(name + " constraint not string");
        if (strlen(in[i]->) != 0)
            elementaddncf(, in[i]->, null);
    }
    return(out);
}

function
xul_muxf (int(l), value({S, I0, I1}, "log"), var(CONSTR, "[]str")) {
    str(name, "xul_muxf" + l);
    value(out, "log");
    element("MUXF" + l);
    elementconnect("S", 0, S);
    elementconnect("I0", 0, I0);
    elementconnect("I1", 0, I1);
    elementconnect("O", 1, out);
    xul_constraints(name, CONSTR);
    return(out);
}

procedure
xul_constraints (str(name), var(constraints, "[]str")) {
    int(n, dimension(constraints));
    for (int(i, 0) ; i<n && strlen(constraints[i]) != 0 ; i++)
        elementaddncf(, constraints[i], null);
}

function
xul_ninputs (var(in, "[]->"), int({min, max}), str(name)) {
    int(n, dimension(in));
    int(i);
    while ((i < n) && (mode(in[i]->) != "immediate"))
        i++;
    if (i < min)
        texit(name + "() fewer than " + min + " signal inputs");
    if (i > max)
        texit(name + "() more than " + max + " signal inputs");
    return(i);
}

procedure
xul_connectinputs(var(in, "[]->"), int(n)) {
    if (n == 1)
        elementconnect("I", 0, in[0]->);
    else 
        for (int(i) ; i<n ; i++)
            elementconnect("I" + i, 0, in[i]->);
       
}

procedure
nullerr (str(name), str(port)) {
    texit(name + " has null input for pin " + port);
}
