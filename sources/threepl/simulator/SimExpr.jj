/*
 * Declare function tokens to be active in state FUNCTION, which is never used.
 * This is so we can recognize function names as arbitrary identifiers (so they
 * aren't keywords which might clash with user variables), but still use the
 * token.kind that the following declarations generate. See funcExp() below.
 */ 

<FUNCTION> TOKEN : {

      < T:       "t" >         /* Returns simulator time since reset */
   |  < SIZEOF:  "sizeof" >    /* 3pl sizeof operator */
   |  < WRIT:    "writ" >      /* Returns true if variable was written */
   |  < READ:    "read" >      /* Returns true if variable was read */
   |  < ACC:     "acc" >       /* Returns true if variable was accessed */
   |  < CHANGED: "changed" >   /* Returns true if variable has changed */ 
   |  < COUNT:   "count" >     /* Returns this clock's active edge count */
   |  < FREQ:    "freq" >      /* Returns this clock's frequency, Hz */
   |  < PERIOD:  "period" >    /* Returns this clock's period, ns */
   |  < LOG10:   "log" >       /* log base 10 */
   |  < LN:      "ln" >        /* log base e */
   |  < MIN:     "min" >       /* min(x,y): minimum of x and y */
   |  < MAX:     "max" >       /* max(x,y): maximum of x and y */
   |  < POW:     "pow" >       /* pow(x,y): x raised to the power y */
   |  < DIMS: "dimensions" >   /* dimensions(varspec): number of varspec's dimensions */
   |  < DIM:  "dimension"  >   /* dimensions(varspec,n): value of varspec's nth dimension */
   |  < QUEUEWORDS: "queuewords" >   /* Returns no. of occupied elements in this queue */
   |  < QUEUESPACES: "queuespaces" >  /* Returns no. of empty elements in this queue */
   |  < QUEUEWRITESTATUS: "queuewritestatus" >  /* Returns queue write status (async queues only) */
   |  < QUEUEREADSTATUS: "queuereadstatus" >    /* Returns queue read status (async queues only) */
}

/* Identifier group */

TOKEN : {

  /*
   * An identifier group groups identifiers together by category, and on its own acts as
   * a wildcard identifer. When entered with other identifier group(s), the intersection
   * of the group results, eg. -data -outputs  represents all identifiers which are data
   * outputs.
   */
  < IDENT_GROUP: "-threepl"   | 
                 "-hidden"    | 
                 "-variables" | 
                 "-outputs"   |                 
	         "-inputs"    | 
	         "-ext"       | 
	         "-control"   | 
	         "-data"      |
	         "-clocks" >
}

/* Boolean literals (must specify before identifiers) */         

TOKEN : {
   <BOOLEAN_LITERAL: "true" | "false" | "high" | "low" >
}

/* Identifiers */

TOKEN : {

        < IDENTIFIER: ("@")? ( <LETTER> | "_" )+ ( <DIGIT> | <LETTER> | "_" )* >
  |     < WILDCARD_IDENTIFIER: "'" ( <WILDCARD> | <LETTER> | <DIGIT> | "_" | "." )+ "'" >
  |     < #DIGIT: ["0"-"9"] >
  |     < #LETTER: ["a"-"z", "A"-"Z"] >
  |     < #WILDCARD: ["*", "?"] >  
  |     <OPENSQUAREBRACKET: "[" >   /* open array index specifier */      
  |     <CLOSESQUAREBRACKET: "]" >  /* close array index specifier */
  |     "."                         /* used in struct fields */

}

/* Other literals */

TOKEN : {

  < INTEGER_LITERAL:
        <DECIMAL_LITERAL> (["l","L"])?
      | <HEX_LITERAL> (["l","L"])?
      | <OCTAL_LITERAL> (["l","L"])?
