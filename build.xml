    </macrodef>

    <!--
        macro to delete everything in a directory except one file
    -->
    <macrodef name="cleandirexcept">
        <attribute name="path"/>
        <attribute name="except"/>
        <sequential>
            <delete includeemptydirs="true" failonerror="false" verbose="true">
                <fileset dir="@{path}"
                  erroronmissingdir="false" defaultexcludes="false">
                    <exclude name="@{except}"/>
                </fileset>
            </delete>
        </sequential>
    </macrodef>

    <!--
        macro to delete a directory if it is empty
    -->
    <macrodef name="cleanemptydir">
        <attribute name="path"/>
        <sequential>
            <cleandirexcept path="@{path}" except="*"/>
        </sequential>
    </macrodef>

    <!--
        macro to delete a sub-directory in a base directory
    -->
    <macrodef name="cleansubdir">
        <attribute name="path"/>
        <attribute name="subdir"/>
        <sequential>
            <!-- delete everything in the sub-directory first -->
            <delete includeemptydirs="true" failonerror="false" verbose="true">
                <fileset dir="@{path}"
                  erroronmissingdir="false" defaultexcludes="false">
                    <include name="@{subdir}/**/*"/>
                </fileset>
            </delete>
            <!-- then delete the empty sub-directory itself -->
            <cleanemptydir path="@{path}/@{subdir}"/>
        </sequential>
    </macrodef>

    <!-- SETUP IS DONE, BUILD TARGETS START HERE -->

    <!-- the "version" target prints the 3pl version including "mflg" -->
    <target name="version" description="print 3pl version with modified flag">
        <echo message="${3pl.version}${3pl.mflg}"/>
    </target>

    <!-- the "revision" target prints the 3pl revision from git -->
    <target name="revision" description="print 3pl revision from git">
        <echo message="${3pl.revision}"/>
    </target>

    <!-- the "versionfilter" target copies a file to stdout, with vers subs -->
    <target name="versionfilter" description="replace version tokens in stdin">
        <fail unless:set="inputfile">
            'inputfile' property not specified (e.g. -Dinputfile=filename)
        </fail>
        <loadfile property="contents" srcFile="${inputfile}" quiet="true">
            <filterchain refid="versionfilter"/>
        </loadfile>
        <fail unless:set="contents">
            can't load '${inputfile}' or it is empty.
        </fail>
        <echo message="${contents}"/>
    </target>

    <!--
        the "compile" target creates a java properties file containing 3pl
        compiler information, runs the java compiler, then creates a build
        properties file
    -->
    <target name="compile"
      description="creates properties files and compiles all .java files">
        <mkdir dir="classes/threepl"/>
        <propertyfile file="classes/threepl/ThreePL.properties"
          comment="3PL Compiler Properties">
            <entry key="version" value="${3pl.version}${3pl.mflg}"/>
            <entry key="revision" value="${3pl.revision}"/>
            <entry key="lastChangedAuthor" value="${3pl.changeauthor}"/>
            <entry key="lastChangedRev" value="${3pl.changerev}"/>
            <entry key="lastChangedDate" value="${3pl.changedate}"/>
            <entry key="buildDate" value="${3pl.builddate}"/>
            <entry key="builtBy" value="${3pl.builtby}"/>
        </propertyfile>
        <echoproperties destfile="classes/build.properties"/>
        <javac srcdir="sources" destdir="classes"
          source="8" target="8" debug="false" encoding="UTF-8"
          includeantruntime="false" listfiles="true">

            <compilerarg value="-Xprefer:source"/>
            <compilerarg value="-Xlint:all"/>
            <compilerarg value="-Xlint:-options"/>

            <include name="threepl/**/*.java"/>
            <exclude name="threepl/simulator/**.java"/>
        </javac>
    </target>

    <!-- the "jar" target runs "compile" then builds the .jar file -->
    <target name="jar" depends="compile"
      description="runs compile target then builds the .jar file">
        <jar destfile="classes/${3pl.jar}" basedir="classes" excludes="*.jar">
            <manifest>
                <attribute name="Main-Class" value="${3pl.main-class}"/>
            </manifest>
        </jar>
    </target>

    <!--
        the "run" target runs "jar" then executes the resulting jar file
        "in place" using the source include dir
    -->
    <target name="run" depends="jar"
      description="runs jar target then executes jar file in place">
        <java jar="classes/${3pl.jar}" fork="true">
            <jvmarg value="-Xmx800M"/>
            <arg value="-Isources/include"/>
        </java>
    </target>

    <!--
        the "build" target runs "jar" then copies all necessary files into a
        build hierarchy under the "build" directory.
    -->
    <target name="build" depends="jar"
      description="runs jar target then creates new hierarchy in build dir">
        <createinstall base="build/${3pl.version}${3pl.mflg}"/>
    </target>

    <!-- the "api" target re-creates a html version of the API javadoc -->
    <target name="api"
      description="run javadoc to create html version of API docs in doc/api">
        <delete dir="doc/api"/>
        <mkdir dir="doc/api"/>
        <javadoc destdir="doc/api"
          locale="en_AU" encoding="UTF-8" verbose="true"
          access="package" author="true" version="true" use="true"
          windowtitle="3PL API" overview="sources/threepl/overview.html">
            <packageset dir="sources" defaultexcludes="yes">
                <include name="threepl/**"/>
                <exclude name="threepl/simulator/**"/>
            </packageset>
            <link href="https://docs.oracle.com/javase/8/docs/api/"/>
            <doctitle><![CDATA[<table><tr><td style="font-size: xx-large;"><b>3PL</b> - Parallel Pipeline Programming Language</td><td><img src="file://${basedir}/doc/images/logo.gif" width=80 height=63/></td></tr></table>]]></doctitle>
            <header><![CDATA[<img src="file://${basedir}/doc/images/logo-small.gif" width=36 height=28/>]]></header>
            <footer><![CDATA[<b>3PL</b> - Parallel Pipeline Programming Language]]></footer>
            <bottom><![CDATA[<p style="width: 100%; text-align:center; font-size: x-small; font-style: italic;">Copyright &#169; 2004-${3pl.current_year} <a href="http://www.csiro.au/">CSIRO Australia</a>. All Rights Reserved.</p>]]></bottom>
        </javadoc>
        <echo unless:set="env.JAVACCHOME"
          message="JAVACCHOME environment variable to build Parser BNF html"/>
        <jjdoc if:set="env.JAVACCHOME"
          target="sources/threepl/parser/Parser.jj"
          outputfile="doc/api/ParserBNF.html"
          javacchome="${env.JAVACCHOME}"/>
    </target>

    <!-- the "javacc" target rebuilds parser source from .jj file -->
    <target name="javacc"
      description="rebuilds parser source from .jj file - into build/jcc-out">
        <fail unless:set="env.JAVACCHOME"
          message="the JAVACCHOME environment variable is not set"/>
        <mkdir dir="build/jcc-out"/>
        <javacc
          target="sources/threepl/parser/Parser.jj"
          outputdirectory="build/jcc-out"
          javacchome="${env.JAVACCHOME}"
          static="true"/>
    </target>

    <!-- the "clean" target removes most output except jar file -->
    <target name="clean" description="removes most output except jar file">
        <cleandirexcept path="classes" except="${3pl.jar}"/>
        <cleansubdir path="build" subdir="${3pl.version}${3pl.mflg}"/>
        <cleansubdir path="build" subdir="jcc-out"/>
        <cleanemptydir path="build"/>
        <cleansubdir if:true="${3pl.internal}"
          path="sources/include/boards" subdir="csiro"/>
    </target>

    <target name="main" depends="clean,run"
      description="main target - runs a clean then a run">
    </target>

    <target name="release" depends="clean,build"
      description="runs clean and build targets then creates a release">
    </target>

    <target name="refresh" if="eclipse.running">
        <eclipse.refreshLocal resource="${basedir}" depth="infinite"/>
    </target>

</project>
