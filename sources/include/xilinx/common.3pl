global procedure
elementLogProperty (str(id), str(prop), log(l)) {
    if (!matched(l))
        return;
    elementproperty(id, prop, (l?"TRUE":"FALSE"));
}

global procedure
elementIntProperty (str(id), str(prop), int({n, min, max})) {
    if (!matched(n))
        return;
    if (n < min)
        texit("Property too small, element " + id + " property " + prop + "(" + n + "(" + n +   ") < " + min);
    if (n > max)
        texit("Property too large, element " + id + " property " + prop + "(" + n + "(" + n +   ") > " + max);
    str(fmt, "%d");
    str(s, format(fmt, n));
    elementproperty(id, prop, s);
}

global procedure
elementBinProperty (str(id), str(prop), int({n, min, max}), int(bits)) {
    if (!matched(n))
        return;
    if (n < min)
        texit("Property too small, element " + id + " property " + prop + "(" + n + ") < " + min);
    if (n > max)
        texit("Property too large, element " + id + " property " + prop + "(" + n + ") > " + max);
    elementproperty(id, prop, inttobinstring(n, bits));
}

global procedure
elementHexProperty (str(id), str(prop), int({n, min, max}), int(digits)) {
    if (!matched(n))
        return;
    prop = toupper(prop);
    if (n < min)
        texit("Property too small, element " + id + " property " + prop + "(" + n + ") < " + min);
    if (n > max)
        texit("Property too large, element " + id + " property " + prop + "(" + n + ") > " + max);
    elementproperty(id, prop, inttohexstring(n, digits));
}

global procedure
elementFloatProperty (str(id), str(prop), float({n, min, max}), int(digits)) {
    if (!matched(n))
        return;
    if (n < min)
        texit("Property too small, element " + id + " property " + prop + "(" + n + ") < " + min);
    if (n > max)
        texit("Property too large, element " + id + " property " + prop + "(" + n + ") > " + max);
    str(fmt, "%."+digits+"f");
    str(s, format(fmt, n));
    elementproperty(id, prop, s);
}


global procedure
elementStrProperty (str(id), str({prop, v}), varargs) {
    if (!matched(v))
        return;
    int(n, dimension(inargs));
    v = toupper(v);
    if (n == 0) {
        elementproperty(id, prop, v);
        return;
    }
    for(int(i) ; i<n ; i++) {
        if (v == inargs[i]->) {
            elementproperty(id, prop, v);
            return;
        }
    }
    texit("Property value incorrect, element " + id + " property " + prop
            + " value " + v);
}

