            <copyinc if:true="${3pl.internal}" base="@{base}" path="boards/csiro/hymod2/external_ram.3pl"/>
            <copyinc if:true="${3pl.internal}" base="@{base}" path="boards/csiro/hymod2/iocommon3.3pl"/>
