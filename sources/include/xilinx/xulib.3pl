global procedure
xul_ifddrcpe (
    value({Q0, Q1}, "log")
    <-
    value({C0, C1, CE, D, CLR, PRE}, "log"),
    var(CONSTR, "[]str")
) {
    if (!matched(C0)) nullerr("xul_ifddrcpe", "C0");
    if (!matched(C1)) nullerr("xul_ifddrcpe", "C1");
    if (!matched(CE)) nullerr("xul_ifddrcpe", "CE");
    if (!matched(D)) nullerr("xul_ifddrcpe", "D");
    if (!matched(CLR)) nullerr("xul_ifddrcpe", "CLR");
    if (!matched(PRE)) nullerr("xul_ifddrcpe", "PRE");
    element("IFDDRCPE");
    elementconnect("C0", 0, C0);
    elementconnect("C1", 0, C1);
    elementconnect("CE", 0, CE);
    elementconnect("D", 0, D);
    elementconnect("CLR", 0, CLR);
    elementconnect("PRE", 0, PRE);
    elementconnect("Q0", 1, Q0);
    elementconnect("Q1", 1, Q1);
    xul_constraints("xul_ifddrcpe", CONSTR);
}

