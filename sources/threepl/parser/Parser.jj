// These are source file name and line number tokens inserted by the
// SrcReader class file reader when switching to or returning from a new
// source file. Since file names and line numbers change each time we enter
// or leave a source file these must be updated and this is done via
// these inserted tokens. The tokens are thus skipped in parsing, after
// extracting the file information.
//SKIP :
//{
//    <IMARKER: "#" ("i"|"I") "#" (~["#"])+ "#" (~["#"])+ "#\n"> {ThreePL.setPosition(image);}
//}

// Update the file line number on each newline, but skip the token.
SKIP :
{
    "\n" {ThreePL.incrLineNo();}
}
// Skip carriage returns from DOS sources.
SKIP :
{
    "\r"
}

//SKIP :
//{
//        <WHITE_SPACE:  " " | "\t" | "\r" | "\f" >
//    |   <NEW_LINE:     (<WHITE_SPACE>)* "\n" >
//}
SKIP :
{
        <WHITE_SPACE:  " " | "\t" >
}

// Comments
SKIP :
{
      "//"  : IN_SINGLE_LINE_COMMENT
    | "/*"  : IN_MULTI_LINE_COMMENT
}

<IN_SINGLE_LINE_COMMENT> SKIP :
{
    "\n" {ThreePL.incrLineNo();} : DEFAULT
}

<IN_MULTI_LINE_COMMENT> SKIP :
{
      "*/" : DEFAULT
    | "\n" {ThreePL.incrLineNo();}
}

<IN_SINGLE_LINE_COMMENT, IN_MULTI_LINE_COMMENT> SKIP :
{
    < ~[] >
}

// These are source file name and line number tokens inserted by the
// SrcReader class file reader when switching to or returning from a new
// module file. Since file names and line numbers change each time we
// enter or leave a module file these must be updated and this is done via
// these inserted tokens. These tokens are handled at the top of the parse tree.
TOKEN :
{
      <FMODSTART: "#M#" (~["#"])+ "#" (~["#"])+ "#" (~["#"])* "#\n"> {ThreePL.setPosition(image);}
    | <FMODFINISH: "#m#" (~["#"])+ "#" (~["#"])+ "#" (~["#"])* "#\n"> {ThreePL.setPosition(image);}
}

TOKEN :
{
      <FSRCSTART: "#S#" (~["#"])+ "#" (~["#"])+ "#" (~["#"])* "#\n"> {ThreePL.setPosition(image);}
    | <FSRCFINISH: "#s#" (~["#"])+ "#" (~["#"])+ "#" (~["#"])* "#\n"> {ThreePL.setPosition(image);}
}

// Literals
TOKEN :
{
  <INTEGER_LITERAL:   <DECIMAL_LITERAL>
                    | <HEX_LITERAL>
                    | <BIN_LITERAL>
                    | <OCTAL_LITERAL> >
| <#DECIMAL_LITERAL:  ["1"-"9"] (["0"-"9"])*>
| <#HEX_LITERAL:      "0" ["x","X"] (["0"-"9","a"-"f","A"-"F"])+>
| <#BIN_LITERAL:      "0" ["b","B"] (["0"-"9","a"-"f","A"-"F"])+>
| <#OCTAL_LITERAL:    "0" (["0"-"7"])*>
| <FLOATING_POINT_LITERAL: 
                      (["0"-"9"])+ "." (["0"-"9"])+ (<EXPONENT>)? 
                    | "." (["0"-"9"])+ (<EXPONENT>)?
                    | (["0"-"9"])+ "." <EXPONENT>
                    | (["0"-"9"])+ (<EXPONENT>)?>
| <#EXPONENT:         ["e","E"] (["+","-"])? (["0"-"9"])+>
| <STRING_LITERAL:    "\"" (~["\"","\\","\n","\r"] 
                    | "\\" (["n","t","b","r","f","\\","\'","\""] 
                            | "x" ["0"-"9","a"-"f"] ["0"-"9","a"-"f"] 
                            | "0" ["0"-"3"] ["0"-"7"] ["0"-"7"]))* "\"">
| <LOG_LITERAL:       "true" | "false">
}

