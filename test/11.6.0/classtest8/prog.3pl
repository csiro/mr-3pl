// Create an instance of class 'init' which will
// executethe common block and print out the common variable 'mm' assigned
// from parameter 'nn'.
class(ci);
ci = init(nn=89);

// Call class 's' twice verifying that the common block is correctly
// executed. The common block also creates a global variable.
class(c1, s(7));
c1.ppp();
class(c2, s(10));
println("S c1 inst " + c1.cv.k + " (77)");
println("S c2 inst " + c2.cv.k + " (77)");
c1.cv.k = 88;
println("S c1 inst " + c1.cv.k + " (88)");
println("S c2 inst " + c2.cv.k + " (77)");
