}
*/

// Handle GP bus writes.
// The CPU code executes a burst write. This has a maximum of 8 32-bit words.
// In practice the CPU seems to issue burst writes in some cases and a number
// of single word writes in others. It is assumed that it may break up
// a multi-word thansfer into a mixture of single word and burst transfers.
// This interface is written based on that assumption.
//
// Regardless of the mix of transfer sizes it is assumed that multiple
// writes will be to increasing addresses. Each successive write is copied
// into the MS word of 'data', the previous value being shifted right by 32
// bits. When the last word has been received, 'data' is copied to the
// destination static or queue variable.
//
// Note that the address is only used to recognise the destination specific
// variable interface. Thus for variables wider than one 32-bit word the
// address is compared with a range. Otherwise the address on each write is
// not used.
//
// Note that this is a procedure so that the instantiations are not
// separate queue sinks. The addressing mechanism enforces mutually
// exclusive reading of the write address and write data queues, i.e.
// only one instance of this procedure will read the queues though all
// examine the write address queue. This saves the logic normally necessary
// to ensure that reads from separate modules are all completed before
// queue output becomes available with the next datum. That logic can become
// a problem with meeting time constraints if there are a large number of
// readers. Ensuring that all readers are in a single module, as is the case
// here, avoids the problem as long as the readers look after their own
// exclusive access.
//
procedure
cpu_write (
    var(out),
    value(access, "log")
    <-
    int(bus),
    int(addr)
) {
    // gp_wra_p points to the write address input queue
    // gp_wrd_p points to the write data input queue
    // gp_wrr_p points to the write response output queue
    type(atype, "uint:"+(gp_waddr_width[bus]-gp_ext_waddr_width[bus]));
    int(ashift, gp_ext_waddr_width[bus]); // 0 for GP0 - no memory address
    value(w_addr, atype, cast(?gp_wra_p[bus]->.addr>>ashift, atype));
    log(out_used, matched(out));
    if (out_used) {
        int(local.dbuf_words, (size(out)-1)/32+1);
        int(local.shift, (dbuf_words-1)*32);
        int(local.dbuf_size, dbuf_words*32);
        int(local.addr_max, addr + dbuf_words - 1); // last address
        static(local.data, "bits:"+dbuf_size);
    } else {
        int(local.dbuf_words, 1);
        int(local.shift, 0);
        int(local.dbuf_size, 32);
    }
    if (out_used && dbuf_words != 1)
        value(local.addr_match, "log", w_addr >= addr && w_addr <= addr_max);
    else
        value(local.addr_match, "log", w_addr == addr);
    
    static(len, "int:5");       // burst length maximum 7 (8-1) - -ve after last word
    static(count, "uint:4");    // 8 words is burst maximum
    
    write_address_match[bus] := write_address_match[bus] || addr_match;
        
    when (<gp_wra_p[bus]-> && addr_match) seq {
        par {
            when (w_addr == addr)
                count <- 0;
            len <- ?gp_wra_p[bus]->.len;
        }
        par while (len >= 0) {
            if (out_used) {
                if (dbuf_words != 1)
                    data <- (data >> 32) | (gp_wrd_p[bus]-> << shift);  // pop from write data queue
                else
                    data <- gp_wrd_p[bus]->;  // pop from write data queue
            } else
                null <<- gp_wrd_p[bus]->; // pop write data queue
            par {
                len--;
                count++;
            }
        }
        when (>gp_wrr_p[bus]->) par { // sync would hang on ! >out rather than skip
            // Write to write response queue.
            gp_wrr_p[bus]->.id <<- gp_wra_p[bus]->.id; // also pops write address queue
            gp_wrr_p[bus]->.ec <<- 0;                  // OK code
            if (out_used) {
                when (count == dbuf_words) {
                    if (mode(out) == "static")
                        out <- cast(data, type(out));      // output is static
                    else
                        when (>out)
                            out <<- cast(data, type(out)); // output is queue
                }
            }
        }
        assert(access <-);
    }
}

// Detect when a write request has been written to the write request queue for
// the bus but no address match has been made, i.e. the write address is not
// valid.
// Execute a null write to satisfy the bus.
procedure
cpu_write_default (int(bus)) {
    useclock(bus_clk);
    
    static(len, "int:5");
    int(ERR, 0);    // should be 3, but hangs CPU!
    
    when (<gp_wra_p[bus]-> && !write_address_match[bus]) seq {
        len <- ?gp_wra_p[bus]->.len;
        par while (len >= 0) {
            null <<- gp_wrd_p[bus]->;   // pop write data queue
            len--;
        }
        // Write to write response queue.
        sync {
            gp_wrr_p[bus]->.id <<- gp_wra_p[bus]->.id; // also pops write address queue
            gp_wrr_p[bus]->.ec <<- ERR;                // error code
        }
    }
    
    useclock();
}

module
sigint(int(n), value(sig, "log")) {
    if (currentclock() == bus_clk)
        interrupts[n] := sig;
    else {
        value(v, "log");
        useclock(bus_clk);
        resync(v <- sig);
        interrupts[n] := v;
        useclock();
    }
}

// Input data must be of type -
// struct (s,
//      data,       user_data_type,
//      term,       dma_block_term,
//      tag,        tagtype
// );
//
// where
//  data is the user data (can be any type)
//  term is a block termination enumerated type 'dma_block_term' which is
//      'none' (default) to add the datum to the current block
//      'ignore' to terminate the block, discarding the datum
//      'first' to terminate the block and start a new block with the datum
//      'last' to add the current datum to the block then terminate the block
//  tag is a user-defined field which can be used to distinguish blocks
//  of different content. The block type field of the last datum to be
//  added to the current block is used as the block type, all previous ones
//  being ignored.
//
// Blocks will be terminated when full if not explicitly terminated by use
// of the termination field
//
// The input data type is rounded up in size to 8, 16, 32 or 64 bits,
// zero padded at the MSB end where necessary.
// Data are packed into 64-bit words for transmission across an HP bus
// to CPU memory. The packing is 8x8, 4x16, 2x32 or 1x64.
// Where a block is terminated before being filled any unfilled portion of
// the last 64-bit word will be zero. The remainder of the block in CPU
// memory remains unwritten.
//
// On completion of a block transfer the structure that is read by
// the CPU from the 'done' queue is -
//
//    struct(bnctype,
//        blocknum,   "uint:"+size(nblocks),
//        words,      "uint:"+size(blockwords),
//        tag,        tagtype
//    );
//
// where
//  blocknum is the block number in the DMA buffer space
//  words gives the number of words of packed user data in the block
//  tag is the user-defined block type
//
global module
cpu_write_dma_buffer (
    str(name),          // interface name
    int(blockwords),    // block length in data words
    int(nblocks),       // number of blocks
    queue(in),          // data in
    log(use_wcount),    // use queue count rather than interrupt
    log(bigendian)      // transfer data as bigendian
) {
    if (!matched(name))
        texit("cpu_write_dma_buffer() - name not given");
    if (gp_names[name] != null) {
        println("cpu_write_dma_buffer() - '" + name + "' already used");
        println("previous use -");
        println(gp_names[name]);
        texit();
    } else
        gp_names[name] = stacktrace();

    int(port, hp_port);
    if (port == 4)
        texit("cpu_write_dma_buffer() - all 4 ports already used");

    str(st, typestring(in));        // input queue type
    type(datatype, type(in.data));  // input data field type
    type(tagtype, type(in.tag));    // tag field type
    int(idsize, size(datatype));    // data type size
    var(pn, "uint");                // packing number - items packed in 64-bit word
    if (idsize > 64)
        texit("cpu_write_dma_buffer() - data word size > 64 bits (" + idsize + ")");
    else if (idsize <= 8)
        pn = 8;
    else if (idsize <= 16)
        pn = 4;
    else if (idsize <= 32)
        pn = 2;
    else
        pn = 1;

    // 'blockwords' is the number of data words in a block and
    // 'pn' is the number of data words that will be packed into each
    // 64-bit word to be transferred.
    // 'w64' is the number of 64-bit words per block, the last of which may
    // be partially full.
    // 'pages' is the number of 4K byte pages which will be allocated for
    // the DMA buffer for this port, the last of which may be partially full.
    //
    int(w64, (blockwords + pn - 1) / pn);   // block size in 64-bit words
    int(blocksize, w64 * 8);                // block size in bytes
    int(pages, (w64 + 511) / 512);          // 4K pages required

    // Set port parameters for inclusion in .info file
    hp_names[port] = name;

    hp_base_address[port] = DMA_base_address;
    DMA_base_address += pages * 4096;       // bump base address
    DMA_available_pages -= pages;           // decrease pages available
    if (DMA_available_pages < 0)
        texit("cpu_write_dma_buffer() - not enough DMA buffer space available for port " + port);
    
    hp_pages[port] = pages;
    hp_blocks[port] = nblocks;
    hp_blocksize[port] = blocksize;
    hp_blockwords[port] = blockwords;
    hp_dtype[port] = typestring(in.data);
    hp_dtype_bits[port] = size(in.data);
    
    // Type for 'done' queue.
    // Includes, block number, number of words in block and block tag.
    type(bntype, "uint:"+size(nblocks));
    struct(bnctype,
        blocknum,   "uint:"+size(nblocks),
        words,      "uint:"+size(blockwords),
        tag,        tagtype
    );
       
    //--------------------------------------------------------------------------
    // Buffer status memory and control queues.

    enum(stype, missing, free, busy, done);
    rmemory(status, 2, bntype, stype);
    
    cpu_write_memory(name + "_status", status, 1);
    
    // Free block queue.
    queue({fbp, fbpi}, bntype, mindepth=nblocks);
    cpu_write_queue(fbpi <- name + "_free");
    sync {
        fbp <<- fbpi;
        rmemorywrite(status, 1, fbpi, stype.free);
    }
    
    // Done queue.
    queue({dp, dpr}, bnctype, mindepth=nblocks);
    if (use_wcount)
        cpu_read_queue(, dpr <- name + "_done", dp, true);   // use readable item count
    else
        cpu_read_queue(, dpr <- name + "_done", dp,, false); // use interrupt on non-empty
    rmemorywrite(status, 1, dpr.blocknum, stype.missing);

    //--------------------------------------------------------------------------
    // If the termination type is 'first' insert a datum of termination type
    // 'ignore'.
    queue(ip, st);
    sync {
        branch (?in.term) {
        case dma_block_term.first:
            seq {
                sync {
                    ip.term <<- dma_block_term.ignore;
                    ip.tag <<- ?in.tag;
                }
                sync {
                    ip.data <<- in.data;
                    ip.term <<- dma_block_term.none;
                    ip.tag <<- in.tag;
                }
            }
        default:
            ip <<- in;
        }
    }
       
    //--------------------------------------------------------------------------
    // Pack input data.
    struct (ppptype,
        data,   "bits:64",
        wcount, "uint:"+size(blockwords),
        tag,    tagtype,
        term,   dma_block_term
    );

    static(wcount, "uint:"+(size(blockwords)+1), 1);
    queue(ppp, ppptype);
    value(blockfull, "log", wcount == blockwords);
    // Each datum uses the full 64 bit bus width, hence
    // no packing is required.
    if (pn == 1)  sync {
        branch (ip.term) {
        case dma_block_term.none:
            par {
                when (blockfull) par {
                    ppp.term <<- dma_block_term.last;
                    reset(wcount);
                } else
                    ppp.term <<- ip.term;
                wcount++;
            }
        case dma_block_term.ignore:
            // Don't process if block empty (wcount == 0).
            par {
                when (wcount != 0) par {
                    ppp.term <<- ip.term;
                    reset(wcount);
                } else
                    null <<- ip;
            }
        case dma_block_term.last:
            par {
                ppp.term <<- ip.term;
                reset(wcount);
            }
        }
        ppp.data <<- forcecast(ip.data, "bits:64");
        ppp.tag <<- ip.tag;
        ppp.wcount <<- wcount;
    } else {
        // Data must be packed into 64 bit words.
        // A termination code must be applied to the last
        // transfer word in a block.
        // Termination codes in the data stream are simplified here.
        static(scount, "uint:"+size(pn));
        static(v64, "["+(pn-1)+"]bits:"+64/pn);
        int(lastshift, (blockwords - 1) % pn);
        value(packfull, "log", scount == pn-1);
        value(blockempty, "log", wcount == 0);
        var(dsize, "uint", 64/pn);  // width of words being packed (>= data size)
        value(lastpack, "bits:64");
        lastpack := cast(v64, "bits:64") | lshift(forcecast(ip.data, "bits:"+dsize), scount, pn);

        sync {
            branch (ip.term) {
            case dma_block_term.none:
                par {
                    when (!packfull && !blockfull) par {
                        v64[scount] <- forcecast(ip.data, "bits:"+dsize);
                        scount++;
                        wcount++;
                    }
                    when (packfull && !blockfull) par {
                        ppp.data <<- lastpack;
                        reset(scount, v64);
                        wcount++;
                    }
                    when (blockfull) par {
                        ppp.data <<- lastpack;
                        ppp.tag <<- ip.tag;
                        ppp.term <<- dma_block_term.last;
                        ppp.wcount <<- wcount;
                        reset(scount, v64, wcount);
                    }
                }
            case dma_block_term.ignore:
                par {
                    when (blockempty) // Don't process if block empty (wcount == 0).
                        null <<- ip;
                    else par {
                        when (scount == 0)
                            ppp.term <<- dma_block_term.ignore;
                        else par {
                            ppp.data <<- cast(v64, "bits:64");
                            ppp.term <<- dma_block_term.last;
                        }
                        ppp.tag <<- ip.tag;
                        ppp.wcount <<- wcount - 1;
                        reset(scount, wcount, v64);
                    }
                }
            case dma_block_term.last:
                par {
                    ppp.data <<- lastpack;
                    ppp.term <<- dma_block_term.last;
                    ppp.tag <<- ip.tag;
                    ppp.wcount <<- wcount;
                    reset(scount, wcount, v64);
                }
            }
        }
    }
    
    function
    lshift (value(v), value(count), int(pn)) {
        switch (pn) {
        case 2:
            return(mux(count, v, v<<32));
        case 4:
            return(mux(count, v, v<<16, v<<32, v<<48));
        case 8:
            return(mux(count, v, v<<8, v<<16, v<<24, v<<32, v<<40, v<<48, v<<56));
        }
    }
    
    //--------------------------------------------------------------------------
    // Stream to HP bus.
    // Data blocks are explicitly terminated by the 'term' field, not
    // by a count!
    // The 'term' field is set by the data packing code which keeps count
    // of the 64-bit words as it packs.
    //
    queue(a, "uint:32");                    // address to bus
    queue(l, "uint:4");                     // burst length to bus
    queue(bdata, "bits:64", mindepth=32);   // data to bus
    static(block, bntype);
    static(words, "uint:5");
    static(last, "log");
    static(addr, "uint:32");    // burst write address
    static(wc, type(wcount));
    static(tag, tagtype);
    value(ignore,, ppp.term == dma_block_term.ignore);
    value(ignore_or_last,, ppp.term != dma_block_term.none);

    seq {
        // Set up block transfer.
        sync {
            addr <- hp_base_address[port] + fbp * blocksize; // block start address
            block <- fbp;                                    // block number
            rmemorywrite(status, 0, fbp, stype.busy);
            reset(words);
        }
        
        // Transfer block.
        sync do {
            last <- ignore_or_last;
            wc <- ppp.wcount;
            tag <- ppp.tag;
            when (!ignore)
                if (!bigendian)
                    bdata <<- ppp.data;
                else
                    bdata <<- byteswap(ppp.data);
            when (words == 15 || ignore_or_last) par {
                a <<- addr;
                l <<- ignore ? words-1 : words;
                addr <- addr + 128; // 16 words * 8 bytes/word
                reset(words);
            } else
                words++;
        } while (!last)

        // Write to 'done' queue and update buffer status memory
        sync {
            dp.blocknum <<- block;
            dp.words <<- wc;
            dp.tag <<- tag;
            rmemorywrite(status, 0, block, stype.done);
        }
    }

    // DMA low-level interface.
    dma_write(port, bdata, a, l);
    
    hp_port++;
    hp_writes++;
    
    function byteswap(value(v, "bits:64")) {
        value(v8,, forcecast(v, "[8]bits:8"));
        value(rv8, "[8]bits:8");
        for (int(i) ; i<8 ; i++)
            rv8[i] := v8[7-i];
        return(forcecast(rv8, type(v)));
    }

}

//------------------------------------------------------------------
// Create modules for -
//  cpu_read_value()
//  cpu_write_static()
//  cpu_read_queue()
//  cpu_write_queue()
//  cpu_read_memory()
//  cpu_write_memory()
//
// This is delayed until the end of immediate execution (it is called
// from a trailer module) so that the variable clock domains have been
// established.
//
module
create_bus_interfaces () {
    str(od, directive("outputDirectory"));
    str(info_temp_file_name, od + "__temp__.info");
    str(info_file_name, od + directive("designName") + ".info");
    file(df, info_temp_file_name);
    open(df, "w");
    int(indent);
    int(lsize);

    // GP0 address 1 is used to access the stored .info data in block RAM
    // and has both a read and a write interface. These interfaces have
    // been created by default. If they are not used, i.e. the directive
    // "excludeinfo" exists, then these interfaces are removed here.
    // Because these interfaces (one read and one write) are created first
    // they will be the first two entries in the GP0 interface list.
    // Note that read and write address 1 still remains allocated to these
    // interfaces even though they have been removed.
    if (gp_rd_used[0] && gp_wr_used[0] && direxists("excludeinfo")) {
        remove(bus_list, 0);   // remove the .info read interface
        remove(bus_list, 0);   // remove the .info write interface
    }

    str(infostring);
    
    directive("ZYNQ", true);
    
    winfo("{");

    // relates to the format of the JSON
    //   -- bump major number for incompatible changes
    //   -- bump minor number of compatible changes (like additions)
    winfo("\"version\": {");
    winfo("\"major\": 1,");
    winfo("\"minor\": 0");
    winfo("},");

    winfo("\"directives\": {");
    var(dirs, "map", directives());
    int(dn, entries(dirs));
    if (dn != 0) {
        for (int(i) ; i<dn ; i++) {
            str(key, dirs[i]);
            str(val, dirs[key]);
            str(comma, ",");
            if (i == dn - 1)
                comma = "";
            winfo("\"" + key + "\": \"" + val + "\"" + comma);
        }
    }
    winfo("},");
    winfo("\"spaces\": {");
    
    // Write description of register and queue bus interfaces to .info file.
    // This "reg" space is always linked to AXI_MGP0.
    if (gp_rd_used[0] || gp_wr_used[0]) {
        winfo("\"reg\": {");
        winfo("\"bus\": \"axi_mgp0\",");
        if (gp_rd_used[0])
            winfo("\"read_addr_bits\": " + gp_raddr_width[0] + ",");
        if (gp_wr_used[0])
            winfo("\"write_addr_bits\": " + gp_waddr_width[0] + ",");

        winfo("\"interfaces\": {");
        lsize = entries(bus_list[0]);
        for (int(i) ; i<lsize ; i++) {
            class(v, bus_list[0][i]->);
            winfo("\"" + v.object_name + "\": {");
            winfo("\"interface\": \"" + v.interface_name + "\",");
            winfo("\"write\": " + v.write + ",");
            if (v.var != null && mode(v.var->) == "queue")
                winfo("\"data_depth\": " + queuedepth(v.var->) + ",");
            winfo("\"data_addr\": " + v.addr + ",");
            if (v.caddr > 0)
                winfo("\"avail_addr\": " + v.caddr + ",");
            if (v.laddr > 0)
                winfo("\"avail_thresh_addr\": " + v.laddr + ",");
            else if (v.iev >= 0)
                winfo("\"fixed_thresh\": " + -v.laddr + ",");
            if (v.iev >= 0)
                winfo("\"avail_thresh_intr\": " + v.iev + ",");
            if (v.var != null) {
                if (mode(v.var->) == "queue")
                    winfo("\"check\": " + v.check + ",");
                winfo("\"data_bits\": " + size(v.var->) + ",");
                winfo("\"data_type\": {");
                infostring = infostring + jsontype(type(v.var->), indent) + "\n";
                winfo("}");
            } else
                winfo("\"data_bits\": 0");
            if (i == lsize - 1)
                winfo("}");
            else
                winfo("},");
        }
        winfo("}");
        if (gp_rd_used[1] || gp_wr_used[1] || hp_writes != 0)
            winfo("},");
        else
            winfo("}");
    }

    // Write description of memory interfaces to .info file.
    // This "mem" space is always linked to AXI_MGP1
    if (gp_rd_used[1] || gp_wr_used[1]) {
        winfo("\"mem\": {");
        winfo("\"bus\": \"axi_mgp1\",");
        if (gp_rd_used[1]) {
            winfo("\"read_addr_bits\": " + gp_raddr_width[1] + ",");
            winfo("\"read_addr_loc_bits\": " + gp_ext_raddr_width[1] + ",");
        }
        if (gp_wr_used[1]) {
            winfo("\"write_addr_bits\": " + gp_waddr_width[1] + ",");
            winfo("\"write_addr_loc_bits\": " + gp_ext_waddr_width[1] + ",");
        }

        winfo("\"interfaces\": {");
        lsize = entries(bus_list[1]);
        for (int(i) ; i<lsize ; i++) {
            class(v, bus_list[1][i]->);
            type(mdtype, memorydatatype(v.var->));

            int(addr);
            addr = v.addr <<
                (v.write ? gp_ext_waddr_width[1] : gp_ext_raddr_width[1]);

            winfo("\"" + v.object_name + "\": {");
            winfo("\"interface\": \"" + v.interface_name + "\",");
            winfo("\"write\": " + v.write + ",");
            winfo("\"port\": " + v.port + ",");
            winfo("\"data_addr\": " + addr + ",");
            winfo("\"data_bits\": " + size(mdtype) + ",");
            winfo("\"data_type\": {");
            if (v.qdepth != 0)
                winfo("\"queue_depth\": " + v.qdepth + ",");
            infostring = infostring + jsontype(mdtype, indent) + "\n";
            winfo("}");
            if (i == lsize - 1)
                winfo("}");
            else
                winfo("},");
        }
        winfo("}");
        if (hp_writes != 0)
            winfo("},");
        else
            winfo("}");
    }

    // Write description of DMA interfaces to .info file.
    // This "dma" space is always linked to one or more of the AXI_HP busses.
    if (hp_writes != 0) {
        winfo("\"dma\": {");
        winfo("\"interfaces\": {");
        int(i);
        for (int(port) ; port<4 ; port++) {
            if (!axi_hp_write_used[port])
                continue;
            i++;
            winfo("\"" + hp_names[port] + "\": {");
	    winfo("\"bus\": \"axi_hp" + port + "\",");
            winfo("\"interface\": \"cpu_read_dma\",");
            winfo("\"write\": false,");
            winfo("\"phys_addr\": " + sprintf("%d", hp_base_address[port]) + ",");
            winfo("\"pages\": " + hp_pages[port] + ",");
            winfo("\"blocks\": " + hp_blocks[port] + ",");
            winfo("\"block_size\": " + hp_blocksize[port] + ",");
            winfo("\"block_words\": " + hp_blockwords[port] + ",");
            winfo("\"data_bits\": " + hp_dtype_bits[port] + ",");
            winfo("\"data_type\": {");
            infostring = infostring + jsontype(hp_dtype[port], indent);
            winfo("}");
            if (i == hp_writes)
                winfo("}");
            else
                winfo("},");
        }
        winfo("}");
        winfo("}");
    }
        
    winfo("},");

    // CPU interrupts.
    winfo("\"events\": {");
    lsize = entries(cpu.interrupt_map);
    for (int(i) ; i<lsize ; i++) {
        str(id, interrupt_map[i]);
        int(ev, interrupt_map[id]);
        winfo("\"" + id + "\": {");
        winfo("\"intr\": " + ev);
        if (i == lsize - 1)
            winfo("}");
        else
            winfo("},");
    }
    
    winfo("},");
    
    int(ilen, strlen(infostring));
    infostring = infostring + "    \"length\": " + sprintf("%8d\n", ilen);
    
    winfo("}");

    // Write to the .info file.
    writeln(df, infostring);
    
    close(df);
    if (!filerename(info_temp_file_name, info_file_name))
        println(".info file could not be moved from '" + info_temp_file_name +
        "' to '" + info_file_name + "'");
    else
	setdirective("postProcessAppendFile", info_file_name);
    
    // Optionally create a compressed version of the .info file in block RAM.
    if (!direxists("excludeinfo"))
        if (!compressInfo(info_file_name))
            println("embedded .info file not created");
    

    //
    // Create interface modules for AXI_GP0 bus.
    //
    if (gp_rd_used[0] || gp_wr_used[0]) {
        lsize = entries(bus_list[0]);
        for (int(i) ; i<lsize ; i++) {
            class(v, bus_list[0][i]->);
            v.genproc->(v);
        }
        if (gp_rd_used[0])
            cpu_read_default(0);
        if (gp_wr_used[0])
            cpu_write_default(0);
    }
    
    //
    // Create memory interface modules for AXI_GP1 bus.
    //
    if (gp_rd_used[1] || gp_wr_used[1]) {
        lsize = entries(bus_list[1]);
        for (int(i) ; i<lsize ; i++) {
            class(v, bus_list[1][i]->);
            v.genproc->(v);
        }
        if (gp_rd_used[1])
            cpu_read_default(1);
        if (gp_wr_used[1])
            cpu_write_default(1);
    }
   
    // Connect interrupts.
    for (int(i) ; i<16 ; i++)
        irqf2p[i] := cpu.interrupts[i];
    irqf2p[16] := false;
    irqf2p[17] := false;
    irqf2p[18] := false;
    irqf2p[19] := false;
    
    // Copy directives into a comment in the netlist file.
    netlistcommentfromdirs();
    
    // Append an indented line to the information file string.
    procedure
    winfo (str(s)) {
        // Adjust indenting on closing brackets or braces.
        if (strpos(s, "}") >= 0 || strpos(s, "]") >= 0)
            calling.indent--;
        
        calling.infostring = calling.infostring + lspace(calling.indent) + s + "\n";
        
        // Adjust indenting on opening brackets or braces.
        if (strpos("{[", tail(s, 1)) >= 0)
            calling.indent++;
    }
    
    //
    // Create a compressed version of the .info string and load into a
    // registered output memory that can be read by the CPU.
    // The data is packed into 32 bit memory words. This requires
    // command 'gzip' to be available on the host.
    //
    function compressInfo (str(ifname)) {
        var(iminit, "[]uint", deflate(calling.infostring));
        int(words, dimension(iminit));
        if (words > 32766) {
            printf(".info file too large to incorporate into FPGA block RAM\n");
            return(false);
        }
        
        [
            //
            // Note that this interface has been kept very simple to minimise
            // the use of logic resources. The CPU reads the output of the
            // rmemory (block RAM) using cpu_read_value(), i.e. a queue is
            // not used! Each CPU read triggers an address increment and a
            // new rmemory read.
            //
            // Before reading the packed .info data, a write to GP0 bus
            // address 1 must be done to initialise the read address and
            // perform the first read. That write has zero data width.
            // Four bytes at a time can then be read from 'address'
            // which is incremented after each read.
            //
            int(addrwidth, size(words));
            type(addrtype, "uint:"+addrwidth);
            int(maxaddr, (1 << addrwidth) - 1);
            rmemory(im, 1, addrtype, "uint:32", iminit);
            static(address, addrtype);
            value(next, "log");

            infoword := rmemoryout(im, 0);
            when (inforead)
                assert(next <-);
            when (inforeset) seq {
                address <- 0;
                assert(next <- true);
            }
            when (next) par {
                rmemoryread(im, 0, address);
                when (address != maxaddr)
                    address++;
            }
        ]

        return(true);
    }

    // Create an indenting space string whose length is n * 4.
    function
    lspace (int(n)) {
        str(space_string, "                                                                    ");
        return(head(space_string, n*4));
    }
}


