<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE project>
<project name="3pl" basedir="." default="main"
  xmlns:if="ant:if" xmlns:unless="ant:unless">

    <!-- retrieve environment variables into properties with prefix "env." -->
    <property environment="env"/>

    <!--
        "Semantic Versioning" (ver 2.0.0) version number for 3pl

        For details go to <https://semver.org/> but essentially ...
        Given a version number MAJOR.MINOR.PATCH, increment the:
        - MAJOR version when you make incompatible API changes; or
        - MINOR version when you add functionality in a backwards
          compatible manner; or
        - PATCH version when you make backwards compatible bug fixes.

        For most uses, this property will be combined with an "M" suffix
        if 3pl is built inside a git working tree with uncommitted changes.
    -->
    <property name="3pl.version" value="11.7.0"/>

    <!--
        translate the version into a git tagname
        based on: https://stackoverflow.com/a/14135833/2130789
    -->
    <loadresource property="3pl.tagname">
        <propertyresource name="3pl.version"/>
        <filterchain>
            <prefixlines prefix="threepl-"/>
            <tokenfilter>
                <replacestring from="." to="-"/>
            </tokenfilter>
        </filterchain>
    </loadresource>

    <!-- retrieve various git properties -->
    <exec executable="git" failonerror="true" outputproperty="3pl.revision">
        <arg value="describe"/>
        <arg value="--dirty"/>
        <arg value="--tags"/>
        <arg value="--long"/>
        <arg value="--always"/>
        <arg value="--first-parent"/>
    </exec>
    <exec executable="git" failonerror="true" outputproperty="3pl.changerev">
        <arg value="log"/>
        <arg value="--no-patch"/>
        <arg value="--max-count=1"/>
        <arg value="--pretty=format:%H"/>
    </exec>
    <exec executable="git" failonerror="true" outputproperty="3pl.changeauthor">
        <arg value="log"/>
        <arg value="--no-patch"/>
        <arg value="--max-count=1"/>
        <arg value="--pretty=format:%aN &lt;%aE&gt;"/>
    </exec>
    <exec executable="git" failonerror="true" outputproperty="3pl.changedate">
        <arg value="log"/>
        <arg value="--no-patch"/>
        <arg value="--max-count=1"/>
        <arg value="--pretty=format:%ai"/>
    </exec>

    <!--
        if the revision ends with "-dirty" then this repo is modified - if so,
        the 3pl.mflg property will be the string "M", otherwise it is empty
    -->
    <condition property="3pl.mflg" value="M" else="">
        <matches string="${3pl.revision}" pattern="-dirty$"/>
    </condition>

    <!-- create a bunch of 3pl specific build properties -->
    <property name="3pl.main-class" value="threepl.ThreePL"/>
    <property name="3pl.jar" value="${ant.project.name}.jar"/>

    <tstamp>
        <format property="3pl.current_year" pattern="yyyy"/>
        <format property="3pl.builddate" pattern="yyyy-MM-dd HH:mm:ss ZZZ"/>
    </tstamp>
    <property name="3pl.builtby" value="${env.USER}"/>

    <!-- record the platform this was built on -->
    <exec executable="uname" failonerror="true" outputproperty="3pl.builton">
        <arg value="-s"/>
        <arg value="-r"/>
        <arg value="-m"/>
    </exec>

    <!-- only copy internal files if -D3pl.internal=true passed on cmd line -->
    <property name="3pl.internal" value="false" unless:set="3pl.internal"/>

    <!--
        define a filterchain that does token replacement for 3PL version info
    -->
    <filterchain id="versionfilter">
        <replacetokens>
            <token key="YEAR" value="${3pl.current_year}"/>
            <token key="REVISION" value="${3pl.revision}"/>
            <token key="VERSION" value="${3pl.version}${3pl.mflg}"/>
            <token key="CHANGEAUTHOR" value="${3pl.changeauthor}"/>
            <token key="CHANGEREV" value="${3pl.changerev}"/>
            <token key="CHANGEDATE" value="${3pl.changedate}"/>
            <token key="BUILDDATE" value="${3pl.builddate}"/>
            <token key="BUILTBY" value="${3pl.builtby}"/>
        </replacetokens>
    </filterchain>

    <!--
        macro to copy an include file from sources/include to the include
        dir in a base directory, preserving the relative path ... also replaces
        various tokens during the copy

        we have to do it this way (a macrodef that copies a single file) in
        order to have the relative path of the include file available for a
        token filter

        a header is prepended, depending on the type of the file being copied.
        if a .3pl file is being copied, sources/include/HEADER.3pl is prepended.
        if a .cmd or .tcl file is being copied, sources/include/HEADER.script
        is prepended. The prepended header is included in the token filtering.
    -->
    <macrodef name="copyinc">
        <attribute name="base"/>
        <attribute name="path"/>
        <attribute name="hext" default="3pl"/>
        <sequential>
            <concat destfile="@{base}/include/@{path}"
              overwrite="yes" forceReadOnly="yes" fixlastline="yes">
                <header file="sources/include/HEADER.@{hext}" filtering="yes"/>
                <filelist dir="sources/include" files="@{path}"/>
                <!-- <footer file="?" filtering="yes"/> -->
                <filterchain>
                    <replacetokens>
                        <token key="NAME" value="@{path}"/>
                    </replacetokens>
                </filterchain>
                <filterchain refid="versionfilter"/>
            </concat>
        </sequential>
    </macrodef>

    <!--
        macro to create a complete 3pl installation in a base directory
    -->
    <macrodef name="createinstall">
        <attribute name="base"/>
        <sequential>
            <!-- copy 3pl shell or batch script to bin -->
            <mkdir dir="@{base}/bin"/>
            <copy file="sources/scripts/3pl.bat" tofile="@{base}/bin/3pl.bat"/>
            <copy file="sources/scripts/3pl.sh" tofile="@{base}/bin/3pl"/>
            <setpermissions mode="755" nonPosixMode="tryDosOrPass">
                <file file="@{base}/bin/3pl"/>
            </setpermissions>

            <!-- copy 3pl jar file to lib -->
            <mkdir dir="@{base}/lib"/>
            <copy file="classes/${3pl.jar}" tofile="@{base}/lib/${3pl.jar}"/>

