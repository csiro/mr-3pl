/**
 * Expression (operator ? : ) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr () :
{
    Token   t;
    Node    ntrue;
    Node    nfalse;
    Node    n = null;
}
{
    n = Expr1()
    [
        t = <QUEST>
        ntrue = Expr1()
        <COLON>
        nfalse = Expr1()
        {n = new ExprNode(TreeOp.CONDIT, n, ntrue, nfalse, t);}
    ]
    {return(n);}
}

/**
 * Expression (operator ||) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr1 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
}
{
    nl = Expr2()
    (
        t = <OROR>
        nr = Expr2()
        {nl = new ExprNode(TreeOp.LOGOR, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operator ^^) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr2 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
}
{
    nl = Expr3()
    (
        t = <UPUP>
        nr = Expr3()
        {nl = new ExprNode(TreeOp.LOGXOR, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operator {@literal &&}) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr3 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
}
{
    nl = Expr4()
    (
        t = <ANDAND>
        nr = Expr4()
        {nl = new ExprNode(TreeOp.LOGAND, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operator |) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr4 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
}
{
    nl = Expr5()
    (
        t = <OR>
        nr = Expr5()
        {nl = new ExprNode(TreeOp.BITOR, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operator ^) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr5 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
}
{
    nl = Expr6()
    (
        t = <UP>
        nr = Expr6()
        {nl = new ExprNode(TreeOp.BITXOR, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operator {@literal &}) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr6 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
}
{
    nl = Expr8()
    (
        t = <AND>
        nr = Expr8()
        {nl = new ExprNode(TreeOp.BITAND, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operators == {@literal != < > <= >=}) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr8 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
    TreeOp  op;
}
{
    nl = Expr9()
    (
        LOOKAHEAD(2)
        (
              t = <EQEQ> {op = TreeOp.EQ;}
            | t = <NE> {op = TreeOp.NE;}
            | t = <LANGLE> {op = TreeOp.LT;}
            | t = <RANGLE> {op = TreeOp.GT;}
            | t = <LE> {op = TreeOp.LE;}
            | t = <GE> {op = TreeOp.GE;}
        )
        nr = Expr9()
        {nl = new ExprNode(op, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operators {@literal << >> }) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr9 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
    TreeOp  op;
}
{
    nl = Expr10()
    (
        LOOKAHEAD(2)
        (t = <LS> {op = TreeOp.LS;} | t = <RS> {op = TreeOp.RS;} |
         t = <LR> {op = TreeOp.LR;} | t = <RR> {op = TreeOp.RR;})
        nr = Expr10()
        {nl = new ExprNode(op, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operators + -) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr10 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
    TreeOp  op;
}
{
    nl = Expr11()
    (
        LOOKAHEAD(2)
        (t = <PLUS> {op = TreeOp.ADD;} | t = <MINUS> {op = TreeOp.SUB;})
        nr = Expr11()
        {nl = new ExprNode(op, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (operators * / %) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr11 () :
{
    Token   t;
    Node    nl = null;
    Node    nr;
    TreeOp  op;
}
{
    nl = Expr12()
    (
        LOOKAHEAD(2)
        (
              t = <STAR> {op = TreeOp.MUL;}
            | t = <SLASH> {op = TreeOp.DIV;}
            | t = <PERCENT> {op = TreeOp.REM;}
        )
        nr = Expr12()
        {nl = new ExprNode(op, nl, nr, t);}
    )*
    {return(nl);}
}

/**
 * Expression (unary operators ~ ! - {@literal &}) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr12 () :
{
    Token   t;
    Node    n = null;
}
{
    (
          t = <TILDE> n = Expr13() {n = new ExprNode(TreeOp.BITNOT, n, t);}
        | t = <EXCL> n = Expr13() {n = new ExprNode(TreeOp.LOGNOT, n, t);}
        | t = <MINUS> n = Expr13() {n = new ExprNode(TreeOp.MIN, n, t);}
        | t = <AND> n = Expr13() {n = new AddrNode(n, t);}
        | n = Expr13()
    )
    {return(n);}
}

/**
 * Expression (unary operators ? {@literal <}) grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr13 () :
{
    Token   t;
    Node    n = null;
}
{
    (
          t = <QUEST> n = Expr14() {n = new ExprNode(TreeOp.EXAM, n, t);}
        | t = <LANGLE> n = Expr14() {n = new ExprNode(TreeOp.RAV, n, t);}
        | n = Expr14()
    )
    {return(n);}
}

/**
 * Expression (constants, function call, parenthesised expression)
 * grammar production.
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr14 () :
{
    Token       t;
    Node        n = null;
    Node        nsf;
    String      s;
    String      id;
    NodeList    nodelist;
}
{
    (
          t = <INTEGER_LITERAL> {n = new IntNode(t);}
        | t = <FLOATING_POINT_LITERAL> {n = new FloatNode(t);}
        | t = <STRING_LITERAL>
          {
            s = t.toString();
            n = new StrNode(s.substring(1, s.length()-1), t);
          }
        | t = <LOG_LITERAL> {n = new LogNode(t);}
        | t = <NULL> {n = new NullNode(t);}
        | LOOKAHEAD(DereferencedVar() <LPAREN>) n = Call(false, false)
        | n = Expr15()
        | LOOKAHEAD(<LPAREN> Expr() <RPAREN> <RPOINT>) <LPAREN> n = Expr() <RPAREN> t = <RPOINT>
          (
            {
                nodelist = new NodeList(new SrcLoc(t));
                n = new PtrValNode(n, nodelist, false, t);
            }
            (
                  nsf = Subscript() {nodelist.add(nsf);}
                | nsf = Field() {nodelist.add(nsf);}
            )*
          )
        | <LPAREN> n = Expr() <RPAREN>
    )
    {return(n);}
}

/**
 * Expression (unary operator {@literal >}) grammar production
 * @return  expression node
 * @throws  ParseException on a parsing error
 */
Node
Expr15 () :
{
    Token   t;
    Node    n = null;
}
{
    (
          t = <RANGLE> n = DereferencedVar() {n = new ExprNode(TreeOp.WAV, n, t);}
        | n = DereferencedVar()
    )
    {return(n);}
}

/**
 * Compound value grammar production.
 * @return  compound value node
 * @throws  ParseException on a parsing error
 */
CompoundValNode
CompVal () :
{
    CompoundValNode scn;
    Token           t;
    Node            n = null;
}
{
    t = <LBRACE> {scn = new CompoundValNode(t);}
    [
          LOOKAHEAD(2) n = Keymatch()
        | n = Expr()
        | n = CompVal()
    ]
    {scn.addSubNode(n);}
    (
        <COMMA> {n = null;}
        [
              LOOKAHEAD(2) n = Keymatch()
            | n = Expr()
            | n = CompVal() 
        ]
        {scn.addSubNode(n);}
    )*
    <RBRACE>
    {return(scn);}
}

Node
DereferencedVar () :
{
    Token       t;
    Node        nl;
    Node        vn = null;
    Node        n;
    NodeList    nodelist;
    boolean     nullresolve = false;
    Flag        flag;
    boolean     classref = false;
}
{
    nl = FlaggedVar() { flag = nl.getFlag();}
    (LOOKAHEAD(3) 
        (
              t = <RPOINT>
            | t = <RRPOINT> {nullresolve = true;}
        )
        {
            nodelist = new NodeList(new SrcLoc(t));
            if (classref) {
                vn = new VarNode(t.image, Context.DEFAULT, nodelist, t);
                nl = new GroupRefNode(nl, vn, nodelist, t);
            } else
                nl = new PtrValNode(nl, nodelist, nullresolve, t);
        }
        (
              n = Subscript() {nodelist.add(n);}
            | n = Field() {nodelist.add(n);}
        )*
    )*
    [
        { if (flag != Flag.NONE) emsg("both pre and post increment/decrement used"); }
          <INCR> {nl.setFlag(Flag.POSTINCR);}
        | <DECR> {nl.setFlag(Flag.POSTDECR);}
    ]
    {return(nl);}
}

/**
 * Pre or post increment or decrement or indirect variable grammar production.
 * ++, --, * and {@literal &} are not handled as normal operator nodes.
 * The VarNode to which they apply has flags set
 * to indicate ++v, --v, v++, v-- , *v or {@literal &v}.
 * These are handled when the variable is accessed.
 * @return  a node for a variable with a ++ or --
 * @throws  ParseException on a parsing error
 */
VarNode
FlaggedVar () :
{
    VarNode n;
    Flag    flag = Flag.NONE;
}
{
    [
          <INCR> {flag = Flag.PREINCR;}
        | <DECR> {flag = Flag.PREDECR;}
    ]
    n = Variable()
    {
        n.setFlag(flag);
        return(n);
    }
}


/**
 * A variable (possibly with subscripts or field names) grammar production.
 * @return  a variable node
 * @throws  ParseException on a parsing error
 */
VarNode
Variable () : 
{
    Token       t;
    VarNode     vn = null;
    Node        n;
    Context     context = Context.DEFAULT;
    NodeList    nodelist;
}
{
    [
          <GLOBALDOT> {context = Context.GLOBAL;}
        | <FILEDOT> {context = Context.FILE;}
        | <CALLINGDOT> {context = Context.CALLING;}
        | <LOCALDOT> {context = Context.LOCAL;}
        | <CLASSDOT> {context = Context.GROUP;}
    ]
    t = <IDENTIFIER> {nodelist = new NodeList(new SrcLoc(t));}
    (
          n = Subscript() {nodelist.add(n);}
        | n = Field() {nodelist.add(n);}
    )*
    {
        vn = new VarNode(t.image, context, nodelist, t);
        return(vn);
    }
}

/**
 * Subscript(s) grammar production.
 * @return  a subscript node
 * @throws  ParseException on a parse error
 */
SubscriptNode
Subscript () :
{
    Token           t;
    SubscriptNode   n;
    Node            s1 = null;
    Node            s2 = null;
}
{
    t = <LBRACK>
    (
        [
            s1 = Expr()
            [<DOTDOT> s2 = Expr()]
        ]
    )
    <RBRACK>
    {return(new SubscriptNode(s1, s2, t));}
}

/**
 * Struct field (on a variable) grammar production.
 * @return  a field node
 * @throws  ParseException on a parse error
 */
FieldNode
Field () :
{
    FieldNode   n;
    Token       t;
}
{
    <DOT>
    t = <IDENTIFIER>
    {return(new FieldNode(new StrNode(t.image, t), t));}
}
