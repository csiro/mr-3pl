module
token_cell (
    value(chain_out, "log"),
    value(sel, "log")
    <-
    value(chain_in, "log"),
    value(av, "log"),
    value(set, "log"),
    value(reset, "log"),
    int(i)
) {
    //
    // See additional note in last sentence below regarding the carry chain
    // implementation.
    //
    // The code for Virtex5 is a dreadful hack!
    // It is necessary because ISE10.1 with Virtex5 does not allow
    // cyclic carry chains! A significant feature of this implementation
    // is that the token chain is implemented using a circular carry chain
    // which avoids the lengthy delays that would otherwise be suffered
    // through cascaded CLBs. To get around this problem with Virtex5
    // the first cell in the carry chain is implemented using LUTs
    // and the remaining cells use the MUXCY. For other FPGAs a circular
    // carry chain is used and is accepted by ISE10.1.
    //
    // Note: for the token flip-flop R and S inputs are reversed and output
    // is inverted as the 'set' has to override the 'reset', but the actual
    // flip-flop inputs are the reverse of this. So s=reset and r=set. So tok
    // is active low.
    //
    // HAVE DISABLED THE CARRY CHAIN IMPLEMENTATION FOR ALL DEVICES
    // AND USED LUTS INSTEAD! The carry chain code has not been verified
    // as correct.
    //
    value(tok_, "log"); // inverted as FDRSE 'r' overrides 's', so reverse 'r' and 's'
    fdrse(tok_ <- c=currentclock(), r=set, s=reset, init=(i == 0) ? "R" : "S");
    chain_out := !av && (!tok_ || chain_in);
    sel := av && (!tok_ || chain_in);
    
    /*
    if (directive("family") == "XC5V" && i == 0) {
        value(tok, "log");
        fdrse(tok <- c=currentclock(), r=set, s=reset, init="R");
        chain_out := !av && (!tok || chain_in);
        sel := av && (!tok || chain_in);
    } else {
        value({s, di}, "log");
        value(tok, "log");
        fdrse(tok <- c=currentclock(), r=set, s=reset, init=(i == 0) ? "R" : "S");
        di := !tok && !av;
        s := !av && tok;
        chain_out := xul_muxcy(s, di, chain_in);
        sel := av && (!tok || chain_in);
    }
    *
}
*/

global module
multiplexp (queue(out) <- varargs) {
    multiplexp_(out <- 0, inargs);
}

global module
multiplexp_l (queue(out) <- varargs) {
    multiplexp_(out <- 1, inargs);
}

global module
multiplexp_e (queue(out) <- varargs) {
    multiplexp_(out <- 2, inargs);
}

global module
multiplexp_ (queue(out) <- int(style), var(in, "[]->")) {
    if (dimension(in) == 1 && tail(typestring(in[0]->), 3) == "]->")
        var(inp, "[]->", in[0]->);
    else if (dimension(in) == 1 && tail(typestring(in[0]->), 4) == "list")
        var(inp, "[]->", ptr_list_to_array(in[0]->));
    else
        var(inp, "[]->", in);

    attributes(out, queuefieldzero=false);
    
    int(n, dimension(inp));

    priority(pri, n);
    int(iprev);
    
    for (int(i) ; i<n ; i++) {
        pri[i] := <inp[i]->;
        if (!hasqueuereads(inp[i]->))
            texit("multiplexp(): input " + i + " does not contain queue reads");
    }

    iprev = n - 1;
    
    for (int(i) ; i<n ; i++)
        when (pri[i])
            switch (style) {
            case 0:
                out <<- inp[i]->;
            case 1:
                sync {
                    out.body <<- inp[i]->;
                    out.port[i] <<- true;
                }
            case 2:
                sync {
                    out.body <<- inp[i]->;
                    out.port <<- i;
                }
            }
    
}

global module
multiplext (queue(out) <- varargs) {
    int({index, port});
    var(t, "type", type(out));
    multiplext_(out, index, port <- 0, t, inargs);
}

global module
multiplext_l (queue(out) <- varargs) {   
    int({index, port});
    var(t, "type", type(out));
    multiplext_(out, index, port <- 1, t, inargs);
}

global module
multiplext_e (queue(out) <- varargs) {   
    int({index, port});
    var(t, "type", type(out));
    multiplext_(out, index, port <- 2, t, inargs);
}

module
multiplext_ (
    queue(out),
    int(c),
    int(p)
    <-
    int(style),
    type(t),
    var(in, "[]->")
) {
    if (dimension(in) == 1 && tail(typestring(in[0]->), 3) == "]->")
        var(inp, "[]->", in[0]->);
    else if (dimension(in) == 1 && tail(typestring(in[0]->), 4) == "list")
        var(inp, "[]->", ptr_list_to_array(in[0]->));
    else
        var(inp, "[]->", in);
    
    int(n_in, dimension(inp));
    value(step, "log");
    
    if (style != 1)
        attributes(out, queuefieldzero=false);

    switch (n_in) {
    case 1:
        switch (style) {
        case 0:
            out <<- inp[0]->;
        case 1:
            sync {
                out.body <<- inp[0]->;
                out.port[0] <<- true;
            }
        case 2:
            sync {
                out.body <<- inp[0]->;
                out.port <<- 0;
            }
        }
        c = 1;
    case 2:
        static(select1, "log");

        mux2(out, step, p <- style, {true, true}, inp[0]->, inp[1]->, select1);
        when (step)
            select1 <- !select1;
        c = 2;
    default:
        int(n1, n_in/2);
        int(n2, n1 + n_in % 2);
        int({c1, c2});
        queue(a2, t);
        if (style != 1)
            attributes(a2, queuefieldzero=false);
        value(select1, "log");

        if (n1 == 1) {
            mux2(out, step, p <- style, {true, false}, inp[0]->, a2, select1);
            c1 = 1;
        } else {
            queue(a1, t);
            multiplext_(a1, c1, p <- style, t, inp[0..n1-1]);
            mux2(out, step, p <- style, {false, false}, a1, a2, select1);
        }
        multiplext_(a2, c2, p <- style, t, inp[n1..n_in-1]);           
        if (c1 == c2) {
            static(s1, "log");
            when (step)
                s1 <- !s1;
            select1 := s1;
        } else {
            var(s, "["+n_in+"]log");
            int(lim, c1 + c2);
            for (int(i) ; i<lim ; i+=2)
                s[i] = true;
            sequence(select1 <- s, step);
        }
        c = c1 + c2;
    }

    module
    mux2 (
        queue(out),
        value(step, "log"),
        int(p)
        <-
        int(style),
        var(isin, "[2]log"),
        value(in0),
        value(in1),
        value(select1, "log")
    ) {
        if (style != 1)
            attributes(out, queuefieldzero=false);
        sync when (!<in1 || !select1) {
            assign_port(out, p <- style, isin[0], in0);
            assert(step <- );
        }
        sync when (!<in0 || select1) {
            assign_port(out, p <- style, isin[1], in1);
            assert(step <- true);
        }
        /*
        value(avout, "log", >out);
        value(av0, "log", <in0);
        value(av1, "log", <in1);

        when (avout && av0 && (!av1 || !select1))
            assign_port(out, p <- style, isin[0], in0);
        when (avout && av1 && (!av0 || select1))
            assign_port(out, p <- style, isin[1], in1);
        when (avout && av0 && av1)
            assert(step <-);
        */
    }
    
    procedure
    assign_port (queue(out), int(p) <- int(style), log(isin), value(in)) {
        if (style != 1)
            attributes(out, queuefieldzero=false);
        switch (style) {
        case 0:
            out <<- in;
        case 1:
            if (isin)
                par {
                    out.body <<- in;
                    out.port[p++] <<- true;
                }
            else
                out <<- in;
        case 2:
            if (isin)
                par {
                    out.body <<- in;
                    out.port <<- p++;
                }
            else
                out <<- in;
        }
    }
}

global module
demultiplex (varargs <- queue(in)) {
    demultiplex_(outargs <- 0, in);
}

global module
demultiplex_l (varargs <- queue(in)) {
    demultiplex_(outargs <- 1, in);
}

global module
demultiplex_e (varargs <- queue(in)) {
    demultiplex_(outargs <- 2, in);
}

global module
demultiplex_ (var(out, "[]->") <- int(style), queue(in)) {
    if (dimension(out) == 1 && tail(typestring(out[0]->), 3) == "]->")
        var(outp, "[]->", out[0]->);   
    else if (dimension(out) == 1 && tail(typestring(out[0]->), 4) == "list")
        var(outp, "[]->", ptr_list_to_array(out[0]->));
    else
        var(outp, "[]->", out);
    int(n, dimension(outp));

    switch (style) {
    case 0:
        // no wrapper type
        if (n == 1) {
            if (matched(outp[0]->))
                outp[0]-> <<- cast(in, type(outp[0]->));
            else
                null <<- in;
            return;
        }
        type(al, "["+n+"]log");
        value({av, tc, sel}, al);
        value(reset, "log", false);
        static(tok, al, {true});
        int(iprev);

        for (int(i) ; i<n ; i++) {
            av[i] := >outp[i]->;
            reset := reset || sel[i];
        }

        iprev = n - 1;
        for (int(i) ; i<n ; i++) {
            token_cell(tc[i], sel[i] <-  tc[iprev], av[i], tok[i], i);
            tok[i] <- sel[iprev] || tok[i] && !reset;
            iprev = i;
        }

        for (int(i) ; i<n ; i++)
            when (sel[i])
                outp[i]-> <<- cast(in, type(outp[i]->));
    case 1:
        // log array wrapper type
        if (n == 1) {
            if (matched(outp[0]->))
                outp[0]-> <<- cast(in.body, type(outp[0]->));
            else
                null <<- in.body;
            return;
        }
        for (int(i) ; i<n ; i++)
            if (direxists("demultiplex_skip_null_outputs") && directive("demultiplex_skip_null_outputs")) {
                if (matched(outp[i]->))
                    sync when (in.port[i])  {
                        outp[i]-> <<- cast(in.body, type(outp[i]->));
                    }
            } else {
                sync when (in.port[i]) {
                    if (matched(outp[i]->))
                        outp[i]-> <<- cast(in.body, type(outp[i]->));
                    else
                        null <<- in.body;
                }
            }
    case 2:
        // uint array wrapper type
        if (n == 1) {
            if (matched(outp[0]->))
                outp[0]-> <<- cast(in.body, type(outp[0]->));
            else
                null <<- in.body;
            return;
        }
        for (int(i) ; i<n ; i++)
            if (direxists("demultiplex_skip_null_outputs") && directive("demultiplex_skip_null_outputs")) {
                if (matched(outp[i]->))
                    sync when (in.port == i) {
                        outp[i]-> <<- cast(in.body, type(outp[i]->));
                    }
            } else {
                sync when (in.port == i) {
                    if (matched(outp[i]->))
                        outp[i]-> <<- cast(in.body, type(outp[i]->));
                    else
                        null <<- in.body;
                }
            }
    }
}

global function
ptr_list_to_array (var(in, "list")) {
    int(n, entries(in));
    var(pointers, "["+n+"]->");
    for (int(i); i<n ; i++) {
        if (typestring(get(in, i)) != "->")
            texit("pointer list contains non-pointer entry");
        pointers[i] = get(in, i);
    }
    return(pointers);
}

global function
argstomap (varargs) {
    var(m, "map");
    int(nargs, dimension(inargs));
    if (nargs == 0)
        texit("iomap() has no arguments");
    for (int(i) ; i<nargs ; i++) {
        if (inkeys[i] == null)
            texit("iomap() argument is not key=value");
        put(m, inkeys[i], inargs[i]->);
    }
    return(m);
}

global function
bin_to_gray (value(in)) {
    int(width, size(in));
    value({bin_array, gray_array}, "["+width+"]log");
    bin_array := cast(in, type(bin_array));
    gray_array[width-1] := bin_array[width-1];
    for (int(i, width-2) ; i>=0 ; i--)
        gray_array[i] := bin_array[i+1] ^^ bin_array[i];
    return(cast(gray_array, type(in)));
}

global function
lfsr (var(t), value(step, "log", true), int(init)) {
    type(rt, t);
    int(n, size(rt));
    if (n < 3)
        texit("lfsr() - n (" + n + ") must be >= 3");
    if (n > 32)
        texit("lfsr() - n (" + n + ") must be <= 32");
    var(tab, "[30][4]uint",
        {{1},
         {3},
         {3},
         {5},
         {6},
         {4, 5, 6},
         {5},
         {7},
         {9},
         {4, 10, 11},
         {8, 11, 12},
         {2, 12, 13},
         {14},
         {11, 13, 14},
         {14},
         {11},
         {14, 17, 18},
         {17},
         {19},
         {21},
         {18},
         {17, 22, 23},
         {22},
         {1, 2, 6},
         {1, 2, 5},
         {25},
         {27},
         {1, 4, 6},
         {28},
         {1, 2, 22}
        }
    );
    var(inita, "["+n+"]log");
    for (int(i) ; i<n ; i++)
        if (matched(init))
            inita[i] = ((init >> i) & 1) != 0 ? true : false;
        else
            inita[i] = random() >= 0.5;
    static(s, "["+n+"]log", inita);
    value(lock, "log", true);
    value(feedback, "log", false);
    for (int(i) ; i<(n-1) ; i++)
        lock := lock && !s[i];
    for (int(i) ; tab[n-3][i] != 0 ; i++)
        feedback := feedback ^^ s[tab[n-3][i]-1];
    feedback := feedback ^^ s[n-1];
    feedback := feedback ^^ lock;
    
    [
        when (step) par {
            s[0] <- feedback;
            for (int(i, 1) ; i<n ; i++)
                s[i] <- s[i-1];
        }
    ]

    return(cast(s, rt));
}

// Implement a truth table into target logic.
global function
truthtable (var(table, "[64][6]str"), value({i1, i2, i3, i4, i5, i6}, "log")) {
    int(n, numinargs()-1);
    if (n == 0)
        texit("truthtable() - too few arguments");
    if (n > 6)
        texit("truthtable() - too many arguments");
    int(m, 1 << n);

    // Find the first empty row of the string array - assume non-empty rows
    // are contiguous and start at subscript 0.
    log(empty);
    for (int(row) ; row < m ; row++) {
        empty = true;
        for (int(col) ; col < n ; col++) {
            if (table[row][col] != "" ) {
                empty = false;
                break;
            }
        }
        if (empty) {
            m = row;
            break;
        }
    }
    
    int(init);
    for (int(row) ; row < m ; row++)
        expand (init <- table, n, row, 0, 0);

    value(out, "log");
    switch (n) {
    case 1:
        out := xul_lut1(i1, {"INIT="+inttohexstring(init, 4)});
    case 2:
        out := xul_lut2(i1, i2, {"INIT="+inttohexstring(init, 4)});
    case 3:
        out := xul_lut3(i1, i2, i3, {"INIT="+inttohexstring(init, 4)});
    case 4:
        out := xul_lut4(i1, i2, i3, i4, {"INIT="+inttohexstring(init, 4)});
    case 5:
        if (directive("family") == "XC5V" || directive("family") == "XC6V") {
            out := xul_lut5(i1, i2, i3, i4, i5, {"INIT="+inttohexstring(init, 4)});
            return(out);
        }
        int(init0,  init & 0xffff);
        int(init1,  init >> 16);
        value({v0, v1}, "log");
        v0 := xul_lut4(i1, i2, i3, i4, {"INIT="+inttohexstring(init0, 4)});
        v1 := xul_lut4(i1, i2, i3, i4, {"INIT="+inttohexstring(init1, 4)});
        out := xul_muxf5(i5, v0, v1);
    case 6:
        if (directive("family") == "XC5V" || directive("family") == "XC6V") {
            out := xul_lut6(i1, i2, i3, i4, i5, i6, {"INIT="+inttohexstring(init, 4)});
            return(out);
        }
        int(init0,  init & 0xffff);
        int(init1,  (init >> 16) & 0xffff);
        int(init2,  (init >> 32) & 0xffff);
        int(init3,  (init >> 48) & 0xffff);
        value({v0, v1, v2, v3, vv0, vv1}, "log");
        v0 := xul_lut4(i1, i2, i3, i4, {"INIT="+inttohexstring(init0, 4)});
        v1 := xul_lut4(i1, i2, i3, i4, {"INIT="+inttohexstring(init1, 4)});
        v2 := xul_lut4(i1, i2, i3, i4, {"INIT="+inttohexstring(init2, 4)});
        v3 := xul_lut4(i1, i2, i3, i4, {"INIT="+inttohexstring(init3, 4)});
        vv0 := xul_muxf5(i5, v0, v1);
        vv1 := xul_muxf5(i5, v2, v3);
        out := xul_muxf6(i6, vv0, vv1);
    }
    return(out);
    
    procedure
    expand (int(init) <- var(table), int({n, row, col, val})) {
        if (col == n) {
            init = init | (1 << val);
            return;
        }
        switch (table[row][col]) {
        case {"0", "false"}:
            expand(init <- table, n, row, col+1, val);
        case {"1", "true"}:
            expand(init <- table, n, row, col+1, val | (1 << col));
        case {"", "x", "X"}:
            expand(init <- table, n, row, col+1, val);
            expand(init <- table, n, row, col+1, val | (1 << col));
        default:
            texit("truthtable(): erroneous table entry");
        }
    }
}

// Generic decadic timebase generator
// This produces single-clock pulses at decadic frequencies
// Author - Robin Kirkham
global module
timebase(
    static({tb_1us, tb_10us, tb_100us, tb_1ms, tb_10ms, tb_100ms, tb_1s}, "log")
<-
) {
    int(topmod, round(frequency(currentclock())/1.0e6));
    value({tc1, tc2, tc3, tc4, tc5, tc6, tc7}, "log");
    log({u2, u3, u4, u5, u6, u7});
    counter(nullarg(tb_1s), tc7, u7 <- tc6,, false);
    counter(nullarg(tb_100ms), tc6, u6 <- tc5,, u7);
    counter(nullarg(tb_10ms), tc5, u5 <- tc4,, u6);
    counter(nullarg(tb_1ms), tc4, u4 <- tc3,, u5);
    counter(nullarg(tb_100us), tc3, u3 <- tc2,, u4);
    counter(nullarg(tb_10us), tc2, u2 <- tc1,, u3);
    counter(nullarg(tb_1us), tc1 <- true, topmod, u2);
    
    module
    counter(
        static(pulse, "log"),
        value(tc, "log"),
        log(used)
    <-
        value(ce, "log"),
        int(modulus, 10),
        log(needed)
    ) {
        if (!matched(pulse) && !needed)
            return;
        
        static(count, "uint:" + size(modulus - 1), modulus - 1);
        value(p, "log");
        if (modulus > 16) {
            value(count_eq_0, "log", count == 0);
            tc := count_eq_0 && ce;
            when (tc) par {
	        reset(count);
                assert(p <-);
            }
            when (ce && !count_eq_0)
	        --count;
            pulse <- p;
        } else {
            var(s, "["+modulus+"]log", {true});
            tc := sequence(s, "log", ce) && ce;
            pulse <- tc;
        }
        used = true;
    }
}


