// Complex Nested class references
struct(s1,
    f1, "[4]class"
);
struct(s2,
    f2, "[4]class"
);

var(c, s1);
c.f1[1] = cl();
var(ff, type(c));
println(typevalstring(type(c)));
ff = c;

class(dddd);
dddd = c.f1[1].i[2].f2[3];
println("p2 " + dddd.j + " (567)");

println("p3 " + c.f1[1].i[2].f2[3].j + " (567)");

class cl () {
    var(i, "[4]s2");
    i[2].f2[3] = cc();  // OK, an instance of cc
    
    class(cccc);
    cccc = cc();        // another instance of class cc
    println("p1 " + cccc.j + " (567)"); // variable j from that instance of cc
    
    class cc () {
        int(j, 567);
    }
    
    //global module mmm () { - should give error
    //}
}

